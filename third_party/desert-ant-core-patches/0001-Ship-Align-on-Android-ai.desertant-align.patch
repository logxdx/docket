+package ai.desertant.align
+
+import ai.desertant.core.FfiReader
+import ai.desertant.core.FfiWriter
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotEquals
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+import java.nio.ByteBuffer
+
+/**
+ * The payload half of the SDK, on the host JVM. The vectors are the ones the
+ * Swift suite holds Foundation and the Android lexical path to
+ * (Tests/AlignTests/LexicalNFCTests.swift), so java.text.Normalizer is held to
+ * the same expected bytes here.
+ */
+class AlignCodecTest {
+    private data class Vector(val name: String, val input: String, val nfc: String, val nfcUtf8: String)
+
+    private val vectors: List<Vector> by lazy {
+        val text = javaClass.classLoader!!.getResourceAsStream("lexical_nfc_vectors.json")!!
+            .bufferedReader().use { it.readText() }
+        Json.parseToJsonElement(text).jsonObject["vectors"]!!.jsonArray.map { e ->
+            val o = e.jsonObject
+            Vector(o["name"]!!.jsonPrimitive.content, o["input"]!!.jsonPrimitive.content,
+                o["nfc"]!!.jsonPrimitive.content, o["nfcUTF8"]!!.jsonPrimitive.content)
+        }
+    }
+
+    private fun hex(bytes: ByteArray) = bytes.joinToString("") { "%02x".format(it) }
+
+    @Test fun javaNormalizerMatchesTheSharedVectors() {
+        assertTrue(vectors.size > 20)
+        for (v in vectors) {
+            assertEquals(v.name, v.nfcUtf8, hex(AlignCodec.lexicalText(v.input).toByteArray(Charsets.UTF_8)))
+        }
+    }
+
+    /** Parse the input payload back the way Sources/Align/Binding.swift reads it. */
+    private fun decodeInput(bytes: ByteArray): Triple<FloatArray, Double, List<WordTiming>> {
+        val b = ByteBuffer.wrap(bytes)
+        val samples = FloatArray(b.int) { b.float }
+        val rate = b.double
+        val words = List(b.int) {
+            val text = ByteArray(b.int).also { b.get(it) }.toString(Charsets.UTF_8)
+            WordTiming(text, b.double, b.double)
+        }
+        assertEquals("trailing bytes in the input payload", 0, b.remaining())
+        return Triple(samples, rate, words)
+    }
+
+    @Test fun inputPayloadCarriesComposedTextAndTheTimes() {
+        val samples = floatArrayOf(0.25f, -0.5f, 1f)
+        val words = vectors.mapIndexed { i, v -> WordTiming(v.input, i.toDouble(), i + 0.5) }
+        val (s, rate, decoded) = decodeInput(AlignCodec.encodeInput(samples, 22_050.0, words))
+        assertTrue(samples.contentEquals(s))
+        assertEquals(22_050.0, rate, 0.0)
+        assertEquals(words.size, decoded.size)
+        for ((i, v) in vectors.withIndex()) {
+            assertEquals(v.name, v.nfcUtf8, hex(decoded[i].text.toByteArray(Charsets.UTF_8)))
+            assertEquals(i.toDouble(), decoded[i].start, 0.0)
+            assertEquals(i + 0.5, decoded[i].end, 0.0)
+        }
+    }
+
+    @Test fun decomposedAndComposedSpellingsEncodeIdentically() {
+        val nfd = listOf(WordTiming("café", 0.1, 0.4), WordTiming("canción", 0.5, 0.9))
+        val nfc = listOf(WordTiming("café", 0.1, 0.4), WordTiming("canción", 0.5, 0.9))
+        val audio = FloatArray(16) { it / 16f }
+        assertTrue(AlignCodec.encodeInput(audio, SAMPLE_RATE, nfd).contentEquals(AlignCodec.encodeInput(audio, SAMPLE_RATE, nfc)))
+        // NFC, not NFKC: a ligature reaches the model as itself.
+        assertNotEquals("fine", AlignCodec.lexicalText("ﬁne"))
+    }
+
+    @Test fun optionsPayloadIsTheLanguageString() {
+        val b = ByteBuffer.wrap(AlignCodec.encodeOptions("pt-BR"))
+        assertEquals(5, b.int)
+        assertEquals("pt-BR", ByteArray(5).also { b.get(it) }.toString(Charsets.UTF_8))
+        assertEquals(0, b.remaining())
+    }
+
+    @Test fun resultKeepsTheCallersTextAndReadsTimes() {
+        val words = listOf(WordTiming("café", 1.0, 2.0), WordTiming("x", 3.0, 4.0))
+        val payload = FfiWriter().int(2).double(1.1).double(1.9).int(1).double(3.0).double(4.0).int(0).done()
+        val out = AlignCodec.decodeResult(FfiReader(payload), words)
+        assertEquals(listOf(WordTiming("café", 1.1, 1.9, true), WordTiming("x", 3.0, 4.0, false)), out)
+        try {
+            AlignCodec.decodeResult(FfiReader(FfiWriter().int(1).double(0.0).double(0.0).int(0).done()), words)
+            fail("a word count mismatch must not decode")
+        } catch (e: AlignException) {
+            assertTrue(e.message!!.contains("1 words for 2"))
+        }
+    }
+
+    @Test fun validationNamesTheWord() {
+        val audio = FloatArray(4)
+        AlignCodec.validate(audio, SAMPLE_RATE, listOf(WordTiming("a", -1.0, 10_000_000.0)))
+        for ((rate, words) in listOf(
+            0.0 to emptyList(),
+            Double.NaN to emptyList(),
+            SAMPLE_RATE to listOf(WordTiming("a", 0.0, 1.0), WordTiming("b", Double.NaN, 1.0)),
+            SAMPLE_RATE to listOf(WordTiming("a", 0.0, 1e8)),
+        )) {
+            try {
+                AlignCodec.validate(audio, rate, words)
+                fail("accepted rate $rate words $words")
+            } catch (e: IllegalArgumentException) {
+                if (words.size == 2) assertTrue(e.message!!.startsWith("word 1 start"))
+            }
+        }
+        try {
+            AlignCodec.validate(FloatArray(0), SAMPLE_RATE, emptyList())
+            fail("accepted empty audio")
+        } catch (_: IllegalArgumentException) {
+        }
+    }
+
+    @Test fun languageKeyFollowsSwift() {
+        assertTrue(Align.isSupported("pt-BR"))
+        assertTrue(Align.isSupported("EN"))
+        assertTrue(!Align.isSupported("nl"))
+        assertEquals("zh", AlignCodec.languageKey("zh-Hant"))
+    }
+}
