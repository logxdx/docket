+++ b/packages/align-kotlin/src/androidTest/kotlin/ai/desertant/align/AlignTest.kt
@@ -0,0 +1,174 @@
+package ai.desertant.align
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import kotlinx.coroutines.test.runTest
+import org.json.JSONObject
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.sin
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * Instrumented tests for the Android binding, exercising the real on-device path
+ * via JNI: the LiteRT runtime, the Swift frontend and cascade, and the
+ * static-stdlib runtime. The AAR ships no model, so the suite downloads the
+ * pinned revision into the app cache once and reuses it.
+ */
+@RunWith(AndroidJUnit4::class)
+class AlignTest {
+    private lateinit var align: Align
+
+    @Before fun setUp() {
+        align = Align(InstrumentationRegistry.getInstrumentation().targetContext)
+    }
+    @After fun tearDown() { if (::align.isInitialized) align.close() }
+
+    /** Tests/AlignTests' `synthAudio`, sample for sample. */
+    private fun synthAudio(n: Int, sr: Int): FloatArray = FloatArray(n) { i ->
+        val t = i.toDouble() / sr
+        val a = 0.3 * sin(2 * PI * 200 * t)
+        val b = 0.2 * sin(2 * PI * 350 * t)
+        val c = 0.1 * sin(2 * PI * 61 * t) * sin(2 * PI * 3 * t)
+        (a + b + c).toFloat()
+    }
+
+    private fun golden(): JSONObject {
+        val context = InstrumentationRegistry.getInstrumentation().context
+        return JSONObject(context.assets.open("golden.json").bufferedReader().use { it.readText() })
+    }
+
+    /**
+     * The cascade must give the corrections the Swift suite recorded for this
+     * audio (Tests/AlignTests/Resources/golden.json), within the LiteRT
+     * tolerance that suite uses (15 ms). Anything else means the frontend, the
+     * runtime or the payload differs on this platform.
+     */
+    @Test fun matchesTheRecordedCorrections() = runTest(timeout = 10.minutes) {
+        val g = golden()
+        val audio = synthAudio(g.getInt("n_samples"), g.getInt("sample_rate"))
+        val ws = g.getJSONArray("words")
+        val words = List(ws.length()) { i ->
+            val w = ws.getJSONObject(i)
+            WordTiming(w.getString("text"), w.getDouble("start"), w.getDouble("end"))
+        }
+        val corrections = g.getJSONArray("corrections")
+        val out = align.refine(audio, g.getInt("sample_rate").toDouble(), words, g.getString("language"))
+        assertEquals(words.size, out.size)
+        var checked = 0
+        for (i in words.indices) {
+            assertEquals(words[i].text, out[i].text)
+            if (!out[i].refined) continue
+            checked += 2
+            val cs = (out[i].start - words[i].start) * 1000
+            val ce = (out[i].end - words[i].end) * 1000
+            assertTrue("word $i start drifted: $cs vs ${corrections.getDouble(2 * i) * 1000}",
+                abs(cs - corrections.getDouble(2 * i) * 1000) < 15.0)
+            assertTrue("word $i end drifted: $ce vs ${corrections.getDouble(2 * i + 1) * 1000}",
+                abs(ce - corrections.getDouble(2 * i + 1) * 1000) < 15.0)
+        }
+        assertTrue("no word was refined, so nothing was compared", checked > 0)
+    }
+
+    /**
+     * The NFC contract end to end: a decomposed spelling reaches the model as
+     * the composed bytes, so the two refine identically, and both match what
+     * the Swift suite records for the composed spelling on Linux
+     * (AlignTests.accentedWordsRefineTheSameDecomposed).
+     */
+    @Test fun decomposedAccentsRefineLikeComposed() = runTest(timeout = 10.minutes) {
+        val audio = synthAudio(16_000 * 5, 16_000)
+        val composed = listOf(
+            WordTiming("canción", 0.8, 1.4), WordTiming("más", 1.6, 2.0),
+            WordTiming("año", 2.3, 2.7), WordTiming("café", 3.0, 3.6),
+        )
+        val decomposed = listOf(
+            WordTiming("canción", 0.8, 1.4), WordTiming("más", 1.6, 2.0),
+            WordTiming("año", 2.3, 2.7), WordTiming("café", 3.0, 3.6),
+        )
+        val a = align.refine(audio, 16_000.0, composed, "es")
+        val b = align.refine(audio, 16_000.0, decomposed, "es")
+        assertEquals(a.map { it.start }, b.map { it.start })
+        assertEquals(a.map { it.end }, b.map { it.end })
+        assertEquals(a.map { it.refined }, b.map { it.refined })
+        // The caller's own spelling comes back.
+        assertEquals(decomposed.map { it.text }, b.map { it.text })
+        for ((i, expected) in ACCENTED_RECORDED.withIndex()) {
+            val got = listOf(a[i].start, a[i].end)
+            assertTrue("word $i: $got vs recorded $expected",
+                abs(got[0] - expected[0]) * 1000 < 15.0 && abs(got[1] - expected[1]) * 1000 < 15.0)
+        }
+    }
+
+    @Test fun unsupportedLanguagePassesThrough() = runTest(timeout = 10.minutes) {
+        val words = listOf(WordTiming("hallo", 0.5, 0.9), WordTiming("wereld", 1.0, 1.5))
+        val out = align.refine(synthAudio(16_000 * 2, 16_000), 16_000.0, words, "nl")
+        assertEquals(words, out)
+        assertFalse(Align.isSupported("nl"))
+    }
+
+    @Test fun resamplesRatherThanRefusing() = runTest(timeout = 10.minutes) {
+        val words = listOf(WordTiming("hola", 0.4, 0.71), WordTiming("mundo", 0.8, 1.3))
+        val out = align.refine(synthAudio(44_100 * 3, 44_100), 44_100.0, words, "es")
+        assertEquals(2, out.size)
+        assertTrue(out.all { it.start < it.end })
+    }
+
+    @Test fun reportsWhetherTheModelIsPresent() = runTest(timeout = 10.minutes) {
+        align.download()
+        assertTrue("the model reports itself missing after a successful download", align.isDownloaded())
+    }
+
+    /** A directory that already holds the files is adopted as-is: the offline path an app ships. */
+    @Test fun adoptsAPopulatedDirectory() = runTest(timeout = 10.minutes) {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val downloaded = File(context.filesDir, "align-download").apply { deleteRecursively(); mkdirs() }
+        Align(context, downloaded.absolutePath).use { it.download() }
+        val names = downloaded.walkTopDown().filter { it.isFile }.map { it.name }.toSet()
+        for (f in OFFLINE_FILES) assertTrue("$f missing from $names", f in names)
+        // What an app ships: only the five files, flat, with none of the SDK's download bookkeeping.
+        val dir = File(context.filesDir, "align-adopt").apply { deleteRecursively(); mkdirs() }
+        for (f in OFFLINE_FILES) File(downloaded, f).copyTo(File(dir, f))
+        downloaded.deleteRecursively()
+        Align(context, dir.absolutePath).use { adopted ->
+            assertTrue(adopted.isDownloaded())
+            val out = adopted.refine(synthAudio(16_000 * 2, 16_000), 16_000.0,
+                listOf(WordTiming("hello", 0.4, 0.8)), "en")
+            assertEquals(1, out.size)
+        }
+        dir.deleteRecursively()
+    }
+
+    @Test fun invalidInputIsRejected() = runTest {
+        for (block in listOf<suspend () -> Unit>(
+            { align.refine(FloatArray(0), 16_000.0, listOf(WordTiming("a", 0.0, 1.0)), "en") },
+            { align.refine(FloatArray(10), 0.0, listOf(WordTiming("a", 0.0, 1.0)), "en") },
+            { align.refine(FloatArray(10), 16_000.0, listOf(WordTiming("a", Double.NaN, 1.0)), "en") },
+        )) {
+            var threw = false
+            try { block() } catch (e: IllegalArgumentException) { threw = true }
+            assertTrue(threw)
+        }
+    }
+
+    private companion object {
+        /** The files a model directory must hold on Android (Sources/Align/Catalog.swift, `.android`). */
+        val OFFLINE_FILES = listOf(
+            "align-coarse.tflite", "align-fine.tflite", "refiner_config.json", "mel_filters.bin", "calibrator.bin",
+        )
+
+        /** [start, end] per word for the composed spelling, recorded by the Swift suite on linux-x64 LiteRT. */
+        val ACCENTED_RECORDED: List<List<Double>> = listOf(
+            listOf(1.2805355966091156, 1.3532125145196914), listOf(1.6238725021481515, 1.8827151358127594),
+            listOf(2.267778496444225, 2.6171484112739565), listOf(3.052574973553419, 3.514546310901642),
+        )
+    }
+}
