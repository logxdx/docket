@@ -0,0 +1,168 @@
+package ai.desertant.align
+
+import ai.desertant.core.FfiReader
+import ai.desertant.core.FfiWriter
+import ai.desertant.core.LoadedModel
+import java.text.Normalizer
+
+/** The catalog id, which is how the shared native layer is asked for Align. */
+private const val MODEL_ID = "align"
+private const val MODEL_NAME = "Align"
+
+/** The rate the model works at. Audio at any other rate is resampled. */
+const val SAMPLE_RATE: Double = 16_000.0
+
+/**
+ * A word and when it sounds, in seconds from the beginning of the audio. The
+ * same shape goes in and comes out: [Align.refine] returns your words with
+ * corrected [start] and [end].
+ */
+data class WordTiming(
+    val text: String,
+    val start: Double,
+    val end: Double,
+    /**
+     * True when the refiner moved this word. False means it kept the times you
+     * passed in, as a safe fallback (unsupported language, a correction that
+     * hit the search edge or would end before it starts, or a word past the end
+     * of the audio).
+     */
+    val refined: Boolean = false,
+)
+
+class AlignException(message: String) : Exception(message)
+
+/**
+ * On-device word-timestamp refinement for any transcript: audio and the times a
+ * recognizer proposed in, corrected times out. Mirrors the iOS/Swift SDK:
+ * create one `Align` and reuse it; the model loads lazily on the first [refine]
+ * (or eagerly via [download]).
+ *
+ * ```kotlin
+ * val align = Align(context)                     // downloads on first use
+ * val words = align.refine(samples, 16_000.0, transcriberWords, "en")
+ * align.close()
+ * ```
+ *
+ * @param directory the model's home. Files already there are adopted (so an app
+ *   that ships the model just points at the folder it unpacked it into),
+ *   otherwise the model is downloaded into it. Omit to use the app cache.
+ */
+class Align(
+    context: android.content.Context,
+    directory: String? = null,
+) : AutoCloseable {
+    private val model = LoadedModel(MODEL_ID, MODEL_NAME, context, directory, ::AlignException, AlignNative)
+
+    companion object {
+        /** The language codes the model was trained on (the shipped refiner_config.json's keys). */
+        val LANGUAGES: List<String> = listOf("de", "en", "es", "fr", "it", "ja", "ko", "pt", "zh")
+
+        /** True when [refine] corrects times for this language; false means passthrough. */
+        fun isSupported(languageCode: String): Boolean = AlignCodec.languageKey(languageCode) in LANGUAGES
+    }
+
+    /** Whether the model is usable with no network. */
+    fun isDownloaded(): Boolean = model.isDownloaded()
+
+    /**
+     * Download the model ahead of time so the first [refine] is instant. A
+     * no-op once available (see [isDownloaded]). Suspends on a background
+     * dispatcher.
+     */
+    suspend fun download() = model.download()
+
+    /**
+     * Refine the [words] a transcriber produced for mono [samples] at
+     * [sampleRate], in [languageCode] (BCP-47 or a bare ISO code: "en",
+     * "pt-BR"). Returns the same words, in order and with the same text, with
+     * `start` and `end` replaced and [WordTiming.refined] set. An unsupported
+     * language passes the words through unchanged.
+     *
+     * Every `start` and `end` must be finite and within -1 to 10,000,000
+     * seconds, [sampleRate] finite and positive, and [samples] non-empty;
+     * otherwise this throws [IllegalArgumentException] naming the word.
+     */
+    suspend fun refine(
+        samples: FloatArray,
+        sampleRate: Double,
+        words: List<WordTiming>,
+        languageCode: String,
+    ): List<WordTiming> {
+        AlignCodec.validate(samples, sampleRate, words)
+        if (words.isEmpty()) return words
+        val input = AlignCodec.encodeInput(samples, sampleRate, words)
+        val options = AlignCodec.encodeOptions(languageCode)
+        return model.run(input, options, failureMessage = "timestamp refinement failed") { r ->
+            AlignCodec.decodeResult(r, words)
+        }
+    }
+
+    /** Release the model. The refiner is unusable afterwards. */
+    override fun close() = model.close()
+}
+
+/**
+ * Align's FFI payload schemas, mirroring the reader/writer in
+ * Sources/Align/Binding.swift and packages/align-node/codec.js.
+ */
+internal object AlignCodec {
+    /** The time range a word may carry, in seconds: the same bounds as Swift's `Align.validate`. */
+    const val MIN_SECONDS = -1.0
+    const val MAX_SECONDS = 10_000_000.0
+
+    /** The same two-letter key rule as Swift's `Align.key`. */
+    fun languageKey(languageCode: String): String = languageCode.take(2).lowercase(java.util.Locale.ROOT)
+
+    /**
+     * The core checks the same rules, but its failure crosses JNI as a bare
+     * "failed", so reject here with a message that names the word.
+     */
+    fun validate(samples: FloatArray, sampleRate: Double, words: List<WordTiming>) {
+        require(samples.isNotEmpty()) { "the audio is empty" }
+        require(sampleRate.isFinite() && sampleRate > 0) {
+            "sampleRate is $sampleRate, expected a finite positive rate"
+        }
+        words.forEachIndexed { i, word ->
+            for ((name, t) in listOf("start" to word.start, "end" to word.end)) {
+                require(t.isFinite() && t >= MIN_SECONDS && t <= MAX_SECONDS) {
+                    "word $i $name is $t, expected a time from $MIN_SECONDS to $MAX_SECONDS seconds"
+                }
+            }
+        }
+    }
+
+    /**
+     * The model's lexical features are the UTF-8 bytes of each word in Unicode
+     * NFC, the form it was trained on (Sources/Align/Lexical.swift). Apple and
+     * Linux compose in Swift through Foundation; the Android core links no ICU
+     * and its host bridge only offers NFKC, which would fold ligatures and
+     * width variants and change the bytes. So the composition happens here, with
+     * the platform's own normalizer, and the Android core takes the text as
+     * already composed (Lexical's `os(Android)` branch). Only the bytes sent to
+     * the model change: [refine] hands back the caller's own text.
+     */
+    fun lexicalText(text: String): String = Normalizer.normalize(text, Normalizer.Form.NFC)
+
+    /** Input payload: `f32Array samples`, `f64 sampleRate`, `u32 wordCount`, then text/start/end per word. */
+    fun encodeInput(samples: FloatArray, sampleRate: Double, words: List<WordTiming>): ByteArray {
+        val w = FfiWriter().floats(samples).double(sampleRate).int(words.size)
+        for (word in words) w.string(lexicalText(word.text)).double(word.start).double(word.end)
+        return w.done()
+    }
+
+    /** Options payload: the language string. The core treats a code it does not know as a passthrough. */
+    fun encodeOptions(languageCode: String): ByteArray = FfiWriter().string(languageCode).done()
+
+    /** Result payload: `u32 wordCount`, then `f64 start`, `f64 end`, `u32 refined` per word. */
+    fun decodeResult(r: FfiReader, words: List<WordTiming>): List<WordTiming> {
+        val n = r.int()
+        if (n != words.size) throw AlignException("the core returned $n words for ${words.size}")
+        return words.map { word ->
+            val start = r.double()
+            val end = r.double()
+            val refined = r.int() == 1
+            word.copy(start = start, end = end, refined = refined)
+        }
+    }
+}
