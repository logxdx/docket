diff --git a/Sources/Align/Lexical.swift b/Sources/Align/Lexical.swift
index 4f25daa..c3da08d 100644
--- a/Sources/Align/Lexical.swift
+++ b/Sources/Align/Lexical.swift
@@ -4,17 +4,39 @@ enum Lexical {
     static let context = 16
     static let padByte: Int32 = 256
 
+    /// The training bytes for one word: trimmed, Unicode NFC, UTF-8.
+    ///
+    /// Android composes before the core sees the text. Its core links no ICU, and the host
+    /// bridge only offers NFKC, which folds ligatures and width variants and so changes the
+    /// bytes. The Kotlin SDK (packages/align-kotlin) NFC-normalizes every word with
+    /// java.text.Normalizer before writing the payload, so here the text is already composed
+    /// and must not be normalized again. NFC and this trim commute (no whitespace scalar
+    /// composes with what follows it, and the whitespace that NFC rewrites, U+2000 and U+2001,
+    /// stays whitespace), so composing first gives the same bytes. LexicalNFCTests holds both
+    /// paths to that.
     static func normalize(_ s: String) -> [UInt8] {
+        #if os(Android)
+        return precomposedBytes(s)
+        #else
+        return Array(trimmed(s).nfc.utf8)
+        #endif
+    }
+
+    /// The bytes of text the caller has already put in NFC: the Android path.
+    static func precomposedBytes(_ s: String) -> [UInt8] { Array(trimmed(s).utf8) }
+
+    static func trimmed(_ s: String) -> String {
         let trimmed = s.drop(while: { $0.isWhitespace || $0.isNewline })
         let end = trimmed.lastIndex(where: { !($0.isWhitespace || $0.isNewline) }).map { trimmed.index(after: $0) } ?? trimmed.startIndex
-        return Array(String(trimmed[trimmed.startIndex..<end]).nfc.utf8)
+        return String(trimmed[trimmed.startIndex..<end])
     }
 
     /// 32-length byte ids: [preceding last 16 | following first 16], PAD-filled.
-    static func bytes(preceding: String, following: String) -> [Int32] {
+    static func bytes(preceding: String, following: String,
+                      encode: (String) -> [UInt8] = normalize) -> [Int32] {
         var out = [Int32](repeating: padByte, count: 2 * context)
-        let pk = Array(normalize(preceding).suffix(context))
-        let fk = Array(normalize(following).prefix(context))
+        let pk = Array(encode(preceding).suffix(context))
+        let fk = Array(encode(following).prefix(context))
         for i in 0..<pk.count { out[context - pk.count + i] = Int32(pk[i]) }
         for i in 0..<fk.count { out[context + i] = Int32(fk[i]) }
         return out
diff --git a/Tests/AlignTests/LexicalNFCTests.swift b/Tests/AlignTests/LexicalNFCTests.swift
new file mode 100644
index 0000000..21faa22
--- /dev/null
+++ b/Tests/AlignTests/LexicalNFCTests.swift
@@ -0,0 +1,107 @@
+#if !os(WASI)
+import Foundation
+import Testing
+@_spi(AlignBindings) @testable import Align
+import TestSupport
+
+/// The Android core takes each word already in NFC (the Kotlin SDK composes it with
+/// java.text.Normalizer) and only trims it; every other platform trims and then composes in
+/// Swift. These pin that the two give the model the same lexical bytes. The expected NFC comes
+/// from a third implementation (Python's unicodedata), and packages/align-kotlin's unit tests
+/// hold java.text.Normalizer to the same file.
+@Suite struct LexicalNFCTests {
+    struct Vector: Decodable { let name: String; let input: String; let nfc: String; let nfcUTF8: String }
+    struct Vectors: Decodable { let vectors: [Vector] }
+
+    static let vectors: [Vector] = {
+        let url = Bundle.module.url(forResource: "lexical_nfc_vectors", withExtension: "json")!
+        return try! JSONDecoder().decode(Vectors.self, from: Data(contentsOf: url)).vectors
+    }()
+
+    static func hex(_ bytes: [UInt8]) -> String { bytes.map { String(format: "%02x", $0) }.joined() }
+
+    /// What the Kotlin SDK writes for a word: the vector's NFC, as java.text.Normalizer produces it.
+    static func composedOnHost(_ s: String) -> String {
+        guard let v = vectors.first(where: { $0.input == s }) else {
+            Issue.record("no vector for \(s.unicodeScalars.map { String($0.value, radix: 16) })")
+            return s
+        }
+        return v.nfc
+    }
+
+    @Test func vectorsLoad() {
+        #expect(Self.vectors.count > 20)
+        // The decomposed and composed spellings of a word are different strings to the bytes.
+        #expect(Array("cafe\u{301}".utf8) != Array("caf\u{e9}".utf8))
+    }
+
+    /// The fixture's NFC is what Foundation composes too, so the vectors describe this toolchain.
+    @Test(arguments: vectors.map(\.name))
+    func foundationAgreesWithTheVectors(_ name: String) throws {
+        let v = try #require(Self.vectors.first { $0.name == name })
+        #expect(Self.hex(Array(v.input.precomposedStringWithCanonicalMapping.utf8)) == v.nfcUTF8)
+        #expect(Self.hex(Array(v.nfc.utf8)) == v.nfcUTF8)
+    }
+
+    /// One word: the Apple/Linux path (trim, then compose) against the Android path (composed
+    /// by the host, then trimmed).
+    @Test(arguments: vectors.map(\.name))
+    func androidPathMatchesTheComposingPath(_ name: String) throws {
+        let v = try #require(Self.vectors.first { $0.name == name })
+        let composing = Lexical.normalize(v.input)
+        let android = Lexical.precomposedBytes(v.nfc)
+        #expect(Self.hex(android) == Self.hex(composing), "\(name)")
+    }
+
+    /// The whole 32-id feature a boundary gets, for neighbours that mix decomposed and composed
+    /// spellings, as `runCascade` builds it for a start and an end boundary.
+    @Test func boundaryBytesMatchForMixedSpellings() {
+        let words = ["cafe\u{301}", "caf\u{e9}", "cancio\u{301}n", "nac\u{327}a\u{303}o", "\u{304B}\u{3099}",
+                     "\u{1100}\u{1161}\u{11A8}", "Vie\u{302}\u{323}t", "\u{FB01}ne", "", " \t cafe\u{301} \n"]
+        for prev in words {
+            for next in words {
+                let composing = Lexical.bytes(preceding: prev, following: next)
+                let android = Lexical.bytes(preceding: Self.composedOnHost(prev), following: Self.composedOnHost(next),
+                                            encode: Lexical.precomposedBytes)
+                #expect(composing == android)
+            }
+        }
+    }
+
+    /// The decomposed and composed spellings of a word reach the model as the same bytes, on
+    /// either path, and an NFKC fold would not have.
+    @Test func decomposedAndComposedSpellingsAreOneFeature() {
+        let nfd = Lexical.bytes(preceding: "cafe\u{301}", following: "cancio\u{301}n")
+        let nfc = Lexical.bytes(preceding: "caf\u{e9}", following: "canci\u{f3}n")
+        #expect(nfd == nfc)
+        #expect(Array(nfc[16..<24]) == Array("canci\u{f3}n".utf8).map(Int32.init))
+        #expect(Lexical.normalize("\u{FB01}ne") != Array("fine".utf8))
+    }
+}
+
+/// The same contract through the whole cascade: a decomposed spelling refines exactly like the
+/// composed one. The composed times are printed for packages/align-kotlin's on-device suite
+/// (`ACCENTED_RECORDED`), which must reproduce them from decomposed input.
+@Suite(.serialized, .modelBacked) struct AccentedRefinementTests {
+    @Test func accentedWordsRefineTheSameDecomposed() async throws {
+        let files = try await ModelFixture.files(AlignModel.self)
+        let refiner = Align(assets: try await .align(files: files, computeUnits: .cpuOnly, revision: nil))
+        let audio = synthAudio(16000 * 5, 16000)
+        let composed = [WordTiming(text: "canci\u{F3}n", start: 0.8, end: 1.4),
+                        WordTiming(text: "m\u{E1}s", start: 1.6, end: 2.0),
+                        WordTiming(text: "a\u{F1}o", start: 2.3, end: 2.7),
+                        WordTiming(text: "caf\u{E9}", start: 3.0, end: 3.6)]
+        let decomposed = [WordTiming(text: "cancio\u{301}n", start: 0.8, end: 1.4),
+                          WordTiming(text: "ma\u{301}s", start: 1.6, end: 2.0),
+                          WordTiming(text: "an\u{303}o", start: 2.3, end: 2.7),
+                          WordTiming(text: "cafe\u{301}", start: 3.0, end: 3.6)]
+        let a = try await refiner.refine(composed, audio: audio, sampleRate: 16000, languageCode: "es")
+        let b = try await refiner.refine(decomposed, audio: audio, sampleRate: 16000, languageCode: "es")
+        #expect(a.map(\.start) == b.map(\.start))
+        #expect(a.map(\.end) == b.map(\.end))
+        #expect(a.map(\.refined) == b.map(\.refined))
+        print("accented recorded: " + a.map { "listOf(\($0.start), \($0.end))" }.joined(separator: ", ")
+              + " refined " + a.map { "\($0.refined)" }.joined(separator: ","))
+    }
+}
+#endif
