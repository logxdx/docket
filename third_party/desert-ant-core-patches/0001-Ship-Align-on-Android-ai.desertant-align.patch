diff --git a/Tools/dal.sh b/Tools/dal.sh
index 1620327..c64d7ba 100644
--- a/Tools/dal.sh
+++ b/Tools/dal.sh
@@ -222,13 +222,29 @@ dal_swift_version() {
 
 # SwiftPM's SDK directory varies by host: ~/.swiftpm (macOS), ~/.config/swiftpm
 # (Linux), %LOCALAPPDATA%/org.swift.swiftpm (Windows), plus the sandboxed macOS
-# location.
+# location. DAL_SWIFT_SDKS_PATH, when set, comes first and is where the tasks
+# install an SDK (dal_swift_sdk_install), for a host that keeps its toolchains
+# out of the home directory.
 dal_swift_sdk_dirs() {
+    [ -n "${DAL_SWIFT_SDKS_PATH:-}" ] && printf '%s\n' "$DAL_SWIFT_SDKS_PATH"
     printf '%s\n' "$HOME/.swiftpm/swift-sdks" "$HOME/.config/swiftpm/swift-sdks" \
         "$HOME/Library/org.swift.swiftpm/swift-sdks" \
         "${LOCALAPPDATA:-$HOME/AppData/Local}/org.swift.swiftpm/swift-sdks"
 }
 
+# `swift sdk install`, into DAL_SWIFT_SDKS_PATH when it is set. The first argument
+# is the swift command (e.g. a pinned toolchain's), the rest go to `sdk install`.
+dal_swift_sdk_install() { # <swift> <bundle-or-url> [args...]
+    local swift="$1"
+    shift
+    if [ -n "${DAL_SWIFT_SDKS_PATH:-}" ]; then
+        mkdir -p "$DAL_SWIFT_SDKS_PATH"
+        "$swift" sdk install --swift-sdks-path "$DAL_SWIFT_SDKS_PATH" "$@"
+    else
+        "$swift" sdk install "$@"
+    fi
+}
+
 # The Android ABIs to cross-compile, space-separated. The default is arm64-v8a
 # alone because every machine, emulator and phone the team develops on is
 # arm64. `all` means both. CI sets x86_64 for its emulator, and publish:maven
