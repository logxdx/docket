From fd2c4bfbbf5d6c10b80fa08d74a2beea05e986ad Mon Sep 17 00:00:00 2001
From: logx <113931719+logxdx@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:59:30 +0530
Subject: [PATCH 3/3] Voz on Android: encoder in fp16 math with fp32
 accumulation (experiment)

The mel frontend stays fp32. On an Adreno 660 a 15 s window takes about
2.1 s in fp32; fp16 math with fp32 accumulation keeps the encoder's
accuracy (plain fp16 does not) at up to twice the speed. Built
(packages/voz-kotlin) but not used by the app.
---
 Sources/Voz/Engine+LiteRT.swift | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/Sources/Voz/Engine+LiteRT.swift b/Sources/Voz/Engine+LiteRT.swift
index 4408c3c..9a8b7f9 100644
--- a/Sources/Voz/Engine+LiteRT.swift
+++ b/Sources/Voz/Engine+LiteRT.swift
@@ -118,16 +118,18 @@ final class LiteRTEngine: Engine {
         }
 
         // The mel frontend must not run in reduced precision (its statistics
-        // are the fragile half of the model), and the encoder collapses in
-        // plain fp16 (373 words to 163 on the benchmark take: a conformer is
-        // long dot products end to end), so both ask for fp32. On the GPU
-        // that measures the same 0.39s per window as fp16-with-fp32-accum on
-        // a Tensor G6, so there is nothing to trade. CPU fallback is
-        // automatic when no GPU (or no OpenCL) is present.
+        // are the fragile half of the model), so it asks for fp32. The
+        // encoder collapses in plain fp16 (373 words to 163 on the benchmark
+        // take: a conformer is long dot products end to end), but fp16 math
+        // with fp32 accumulation keeps it: on a Tensor G6 that measures the
+        // same 0.39s per window as fp32, while an older GPU (Adreno 660, about
+        // 2.1s per window in fp32) does fp16 math at twice the fp32 rate, which
+        // is what a live session refreshing every second needs. CPU fallback
+        // is automatic when no GPU (or no OpenCL) is present.
         let melSession = try open(VozModel.melLiteRT, accelerator: 3 /* GPU|CPU */,
                                   gpuPrecision: 2 /* fp32 */)
         let encoderSession = try open(VozModel.encoderLiteRT, accelerator: 3 /* GPU|CPU */,
-                                      gpuPrecision: 2 /* fp32 */)
+                                      gpuPrecision: 3 /* fp16 math, fp32 accumulation */)
         // One thread as well as CPU-only: a decode step is a few hundred
         // kiloflops, and a thread pool spends more per step waking and
         // joining workers than the work costs (measured 60 ms against 1.5 ms
