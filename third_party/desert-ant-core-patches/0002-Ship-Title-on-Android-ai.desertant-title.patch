index 0000000..04a2634
--- /dev/null
+++ b/Sources/CTitleEngine/include/title_engine.h
@@ -0,0 +1,71 @@
+// Title engine: portable C inference for Desert Ant Labs' Title model (MLX
+// 6-bit affine-quantized Granite 4.0 350M), reading the published Hugging Face
+// files as-is: config.json, model.safetensors(.index.json), tokenizer.json,
+// chat_template.jinja.
+#ifndef TITLE_ENGINE_H
+#define TITLE_ENGINE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct te_engine te_engine;
+
+enum {
+    TE_NUMERICS_INT8 = 0,      // int8 activations x 6-bit weights, int32 dots (fastest)
+    TE_NUMERICS_F32 = 1,       // fp32 activations, weights dequantized on the fly
+    TE_NUMERICS_MLX_EXACT = 2, // bit-exact emulation of mlx-lm on MLX's CPU backend (slow)
+    TE_NUMERICS_F32_BF16 = 3,  // fp32 math, tensors rounded to bf16 between ops (MLX-on-GPU style)
+    TE_NUMERICS_INT8_BF16 = 4, // int8 dots, tensors rounded to bf16 between ops
+    TE_NUMERICS_HYBRID = 5,    // int8 batched prefill, fp32 last prompt token and decode
+    TE_NUMERICS_INT8X2 = 6     // default: two int8 planes (value + residual), ~15-bit activations
+};
+
+typedef struct {
+    int n_threads;             // 0 = auto (performance cores)
+    int max_new_tokens;        // default 96, as Titles(maxTokens:) in the Swift SDK
+    int passage_token_budget;  // default 1024; 0 disables truncation
+    int numerics;              // TE_NUMERICS_*
+    int prefill_chunk;         // tokens per batched prefill step, default 128
+} te_options;
+
+typedef struct {
+    int passage_tokens;    // passage length before truncation
+    int truncated;         // 1 if the passage was cut to the budget
+    int prompt_tokens;
+    int generated_tokens;
+    double prefill_s, decode_s;
+} te_stats;
+
+void te_options_default(te_options* o);
+
+te_engine* te_engine_load(const char* model_dir, const te_options* o, char* err, size_t errlen);
+void te_engine_free(te_engine* e);
+
+// Replaces the built-in copy of Titles.prompt (must contain "{clip}").
+int te_engine_set_prompt(te_engine* e, const char* prompt);
+
+// Prompt (Sources/Title/Title.swift, byte for byte) around the passage, after
+// truncation, rendered through chat_template.jinja as a single user message
+// with a generation prompt. *text is malloc'd.
+int te_engine_render(te_engine* e, const char* passage, size_t len, char** text, te_stats* st);
+// Tokenizes text (added/special tokens are recognised). *ids is malloc'd.
+int te_engine_tokenize(te_engine* e, const char* text, size_t len, int32_t** ids, size_t* n);
+// Greedy decode; returns the number of tokens written (EOS excluded), or -1.
+int te_engine_generate(te_engine* e, const int32_t* prompt, size_t n, int32_t* out, int max_new, te_stats* st);
+// Bytes of ids, malloc'd and NUL-terminated.
+char* te_engine_detokenize(te_engine* e, const int32_t* ids, size_t n);
+
+// The whole pipeline: the model's raw reply ("TITLE: ...\nDESC: ..."). malloc'd.
+char* te_engine_describe(te_engine* e, const char* passage, size_t len, te_stats* st);
+
+const char* te_engine_kernel(const te_engine* e);
+int te_engine_threads(const te_engine* e);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/Sources/CTitleEngine/te_engine.c b/Sources/CTitleEngine/te_engine.c
new file mode 100644
index 0000000..60b03cc
--- /dev/null
+++ b/Sources/CTitleEngine/te_engine.c
@@ -0,0 +1,318 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "title_engine.h"
+#include "te_kernels.h"
+#include "te_model.h"
+#include "te_threads.h"
+#include "te_tokenizer.h"
+#include "te_util.h"
+
+// Titles.prompt in Sources/Title/Title.swift. The Swift literal joins its first
+// three lines with `\` continuations, so there is no space after "passage." or
+// "hype." -- that is the prompt the model was fine-tuned on.
+// The Swift binding passes Titles.prompt itself (te_engine_set_prompt), so this
+// copy only serves standalone/host use.
+static const char DEFAULT_PROMPT[] =
+    "Write a factual title (3-8 words) and a 1-2 sentence description for this passage."
+    "Be specific enough to identify this passage. No emoji, no hashtags, no hype."
+    "Write in the same language as the passage.\n\nPASSAGE:\n{clip}";
+
+// Joins the head and tail of a passage that exceeded the token budget.
+static const char TRUNCATION_MARK[] = "\n[...]\n";
+
+struct te_engine {
+    te_options opt;
+    te_model model;
+    te_tokenizer* tok;
+    te_pool* pool;
+    te_state state;
+    char* system_message;
+    char* prompt;  // contains "{clip}"
+    int eos;
+    int threads;
+};
+
+void te_options_default(te_options* o) {
+    o->n_threads = 0;
+    o->max_new_tokens = 96;
+    o->passage_token_budget = 1024;
+    o->numerics = TE_NUMERICS_INT8X2;
+    o->prefill_chunk = 128;
+}
+
+// Performance cores: those whose max frequency is within 80% of the fastest.
+static int auto_threads(void) {
+    long n = sysconf(_SC_NPROCESSORS_ONLN);
+    if (n < 1) n = 1;
+    if (n > 64) n = 64;
+    long freq[64];
+    long top = 0;
+    int known = 0;
+    for (int i = 0; i < n; i++) {
+        char path[96];
+        snprintf(path, sizeof path, "/sys/devices/system/cpu/cpu%d/cpufreq/cpuinfo_max_freq", i);
+        FILE* f = fopen(path, "r");
+        freq[i] = 0;
+        if (f) {
+            if (fscanf(f, "%ld", &freq[i]) == 1) known++;
+            fclose(f);
+        }
+        if (freq[i] > top) top = freq[i];
+    }
+    int fast = (int)n;
+    if (known == n && top > 0) {
+        fast = 0;
+        for (int i = 0; i < n; i++) fast += freq[i] * 10 >= top * 8;
+    }
+    if (fast > 8) fast = 8;
+    return fast < 1 ? 1 : fast;
+}
+
+// Pull the default system message out of chat_template.jinja and check the
+// template has the single-user-message shape rendered below.
+static char* load_template(const char* dir, char* err, size_t errlen) {
+    char path[4096];
+    snprintf(path, sizeof path, "%s/chat_template.jinja", dir);
+    char* t = te_read_file(path, NULL);
+    if (!t) { snprintf(err, errlen, "cannot read %s", path); return NULL; }
+    static const char* must[] = {
+        "'<|start_of_role|>system<|end_of_role|>' + ns.default_system_message + '<|end_of_text|>\\n'",
+        "'<|start_of_role|>' + message.role + '<|end_of_role|>' + content.val + '<|end_of_text|>\\n'",
+        "{%- if add_generation_prompt %}\n    {{- '<|start_of_role|>assistant<|end_of_role|>' }}",
+    };
+    for (size_t i = 0; i < sizeof must / sizeof must[0]; i++)
+        if (!strstr(t, must[i])) {
+            free(t);
+            snprintf(err, errlen, "chat_template.jinja: unexpected template (missing %.40s...)", must[i]);
+            return NULL;
+        }
+    const char* key = "g4_default_system_message = '";
+    char* p = strstr(t, key);
+    if (!p) { free(t); snprintf(err, errlen, "chat_template.jinja: no default system message"); return NULL; }
+    p += strlen(key);
+    char* out = (char*)malloc(strlen(p) + 1);
+    size_t n = 0;
+    for (; *p && *p != '\''; p++) {
+        if (*p == '\\' && p[1]) {
+            p++;
+            out[n++] = *p == 'n' ? '\n' : *p == 't' ? '\t' : *p;
+        } else {
+            out[n++] = *p;
+        }
+    }
+    out[n] = 0;
+    free(t);
+    return out;
+}
+
+te_engine* te_engine_load(const char* dir, const te_options* o, char* err, size_t errlen) {
+    te_engine* e = (te_engine*)calloc(1, sizeof(*e));
+    if (!e) { snprintf(err, errlen, "out of memory"); return NULL; }
+    if (o) e->opt = *o;
+    else te_options_default(&e->opt);
+    if (e->opt.max_new_tokens <= 0) e->opt.max_new_tokens = 96;
+    if (e->opt.prefill_chunk <= 0) e->opt.prefill_chunk = 128;
+    if (te_model_load(&e->model, dir, err, errlen)) { free(e); return NULL; }
+    char path[4096];
+    snprintf(path, sizeof path, "%s/tokenizer.json", dir);
+    e->tok = te_tok_load(path, err, errlen);
+    if (!e->tok) goto fail;
+    e->system_message = load_template(dir, err, errlen);
+    if (!e->system_message) goto fail;
+    e->prompt = te_strndup(DEFAULT_PROMPT, strlen(DEFAULT_PROMPT));
+    e->eos = e->model.cfg.eos_id >= 0 ? e->model.cfg.eos_id : te_tok_lookup(e->tok, "<|end_of_text|>");
+    e->threads = e->opt.n_threads > 0 ? e->opt.n_threads : auto_threads();
+    e->pool = te_pool_create(e->threads);
+    return e;
+fail:
+    te_engine_free(e);
+    return NULL;
+}
+
+void te_engine_free(te_engine* e) {
+    if (!e) return;
+    te_pool_free(e->pool);
+    te_state_free(&e->state);
+    te_tok_free(e->tok);
+    te_model_free(&e->model);
+    free(e->system_message);
+    free(e->prompt);
+    free(e);
+}
+
+int te_engine_set_prompt(te_engine* e, const char* prompt) {
+    if (!prompt || !strstr(prompt, "{clip}")) return -1;
+    free(e->prompt);
+    e->prompt = te_strndup(prompt, strlen(prompt));
+    return 0;
+}
+
+const char* te_engine_kernel(const te_engine* e) {
+    if (e->opt.numerics == TE_NUMERICS_MLX_EXACT) return "mlx-exact";
+    if (e->opt.numerics == TE_NUMERICS_HYBRID) return te_kernel_name(1);  // prefill kernel
+    return te_kernel_name(e->opt.numerics == TE_NUMERICS_INT8 || e->opt.numerics == TE_NUMERICS_INT8_BF16 ||
+                          e->opt.numerics == TE_NUMERICS_INT8X2);
+}
+
+int te_engine_threads(const te_engine* e) { return e->threads; }
+
+typedef struct {
+    char* p;
+    size_t n, cap;
+} sbuf;
+
+static void sb_add(sbuf* b, const char* s, size_t n) {
+    if (b->n + n + 1 > b->cap) {
+        size_t c = b->cap ? b->cap : 256;
+        while (c < b->n + n + 1) c *= 2;
+        b->p = (char*)realloc(b->p, c);
+        b->cap = c;
+    }
+    memcpy(b->p + b->n, s, n);
+    b->n += n;
+    b->p[b->n] = 0;
+}
+
+static void sb_str(sbuf* b, const char* s) { sb_add(b, s, strlen(s)); }
+
+int te_engine_render(te_engine* e, const char* passage, size_t len, char** text, te_stats* st) {
+    te_tokens pt = {0};
+    if (te_tok_encode(e->tok, passage, len, &pt)) { te_tokens_free(&pt); return -1; }
+    int budget = e->opt.passage_token_budget;
+    sbuf clip = {0};
+    if (st) { st->passage_tokens = (int)pt.n; st->truncated = 0; }
+    if (budget > 0 && (int)pt.n > budget) {
+        // Head-and-tail: keep the opening (topic, who/what) and the close
+        // (conclusions, action items), cut on pre-token boundaries.
+        int head = budget * 3 / 4, tail = budget - head;
+        size_t head_cut = 0, tail_start = len;
+        for (int t = 0; t < head; t++)
+            if (pt.chunk_end[t] != pt.chunk_end[t + 1]) head_cut = pt.chunk_end[t];
+        for (size_t t = pt.n - (size_t)tail; t < pt.n; t++)
+            if (t > 0 && pt.chunk_end[t - 1] != pt.chunk_end[t]) { tail_start = pt.chunk_end[t - 1]; break; }
+        if (tail_start < head_cut) tail_start = head_cut;
+        sb_add(&clip, passage, head_cut);
+        sb_str(&clip, TRUNCATION_MARK);
+        sb_add(&clip, passage + tail_start, len - tail_start);
+        if (st) st->truncated = 1;
+    } else {
+        sb_add(&clip, passage, len);
+    }
+    te_tokens_free(&pt);
+    sbuf out = {0};
+    sb_str(&out, "<|start_of_role|>system<|end_of_role|>");
+    sb_str(&out, e->system_message);
+    sb_str(&out, "<|end_of_text|>\n<|start_of_role|>user<|end_of_role|>");
+    // prompt.replacingOccurrences(of: "{clip}", with: passage)
+    for (const char* p = e->prompt;;) {
+        const char* hit = strstr(p, "{clip}");
+        if (!hit) { sb_str(&out, p); break; }
+        sb_add(&out, p, (size_t)(hit - p));
+        sb_add(&out, clip.p ? clip.p : "", clip.n);
+        p = hit + 6;
+    }
+    sb_str(&out, "<|end_of_text|>\n<|start_of_role|>assistant<|end_of_role|>");
+    free(clip.p);
+    *text = out.p;
+    return 0;
+}
+
+int te_engine_tokenize(te_engine* e, const char* text, size_t len, int32_t** ids, size_t* n) {
+    te_tokens v = {0};
+    if (te_tok_encode(e->tok, text, len, &v)) { te_tokens_free(&v); return -1; }
+    free(v.chunk_end);
+    *ids = v.ids;
+    *n = v.n;
+    return 0;
+}
+
+static int argmax_f(const float* l, int n) {
+    int best = 0;
+    for (int i = 1; i < n; i++)
+        if (l[i] > l[best]) best = i;
+    return best;
+}
+
+int te_engine_generate(te_engine* e, const int32_t* prompt, size_t n, int32_t* out, int max_new, te_stats* st) {
+    if (n == 0) return -1;
+    const te_config* c = &e->model.cfg;
+    int cap = (int)n + max_new + 1;
+    if (cap > c->max_pos) return -1;
+    int exact = e->opt.numerics == TE_NUMERICS_MLX_EXACT;
+    int flags = exact ? TE_FWD_EXACT
+              : e->opt.numerics == TE_NUMERICS_INT8 ? TE_FWD_INT8
+              : e->opt.numerics == TE_NUMERICS_F32_BF16 ? TE_FWD_BF16
+              : e->opt.numerics == TE_NUMERICS_INT8_BF16 ? (TE_FWD_INT8 | TE_FWD_BF16)
+              : e->opt.numerics == TE_NUMERICS_INT8X2 ? (TE_FWD_INT8 | TE_FWD_I8X2) : 0;
+    if (e->state.cap < cap) {
+        te_state_free(&e->state);
+        int alloc = cap < 512 ? 512 : cap;
+        if (te_state_init(&e->state, &e->model, alloc, e->opt.prefill_chunk, e->threads)) return -1;
+    }
+    te_state* s = &e->state;
+    s->len = 0;
+    double t0 = te_now();
+    // Hybrid: int8 dots for the batched prefill (compute-bound), fp32 for the last prompt
+    // token and every decode step (memory-bound, so fp32 costs little there).
+    int hybrid = e->opt.numerics == TE_NUMERICS_HYBRID;
+    int dec_flags = hybrid ? 0 : flags;
+    size_t bulk = hybrid ? n - 1 : n;
+    for (size_t i = 0; i < bulk;) {
+        int m = (int)(bulk - i) < s->chunk ? (int)(bulk - i) : s->chunk;
+        int last = i + (size_t)m == n;
+        te_forward(&e->model, s, e->pool, prompt + i, m, last ? s->logits : NULL, hybrid ? TE_FWD_INT8 : flags);
+        i += (size_t)m;
+    }
+    if (hybrid) te_forward(&e->model, s, e->pool, prompt + n - 1, 1, s->logits, dec_flags);
+    double t1 = te_now();
+    int produced = 0;
+    for (;;) {
+        int tok = exact ? te_exact_pick(s->logits, c->vocab) : argmax_f(s->logits, c->vocab);
+        if (tok == e->eos) break;
+        out[produced++] = tok;
+        if (produced >= max_new) break;
+        te_forward(&e->model, s, e->pool, &out[produced - 1], 1, s->logits, dec_flags);
+    }
+    double t2 = te_now();
+    if (st) {
+        st->prompt_tokens = (int)n;
+        st->generated_tokens = produced;
+        st->prefill_s = t1 - t0;
+        st->decode_s = t2 - t1;
+    }
+    return produced;
+}
+
+char* te_engine_detokenize(te_engine* e, const int32_t* ids, size_t n) {
+    char* buf = NULL;
+    size_t len = 0, cap = 0;
+    for (size_t i = 0; i < n; i++) len = te_tok_decode_append(e->tok, ids[i], &buf, len, &cap);
+    if (!buf) buf = te_strndup("", 0);
+    return buf;
+}
+
+char* te_engine_describe(te_engine* e, const char* passage, size_t len, te_stats* st) {
+    char* text = NULL;
+    if (te_engine_render(e, passage, len, &text, st)) return NULL;
+    int32_t* ids = NULL;
+    size_t n = 0;
+    int rc = te_engine_tokenize(e, text, strlen(text), &ids, &n);
+    free(text);
+    if (rc) return NULL;
+    int max_new = e->opt.max_new_tokens;
+    int32_t* out = (int32_t*)malloc((size_t)max_new * sizeof(int32_t));
+    int k = out ? te_engine_generate(e, ids, n, out, max_new, st) : -1;
+    free(ids);
+    char* reply = k >= 0 ? te_engine_detokenize(e, out, (size_t)k) : NULL;
+    free(out);
+    return reply;
+}
+#else
+typedef int te_unavailable_te_engine;
+#endif
diff --git a/Sources/CTitleEngine/te_exact.c b/Sources/CTitleEngine/te_exact.c
new file mode 100644
index 0000000..bbe6599
--- /dev/null
+++ b/Sources/CTitleEngine/te_exact.c
@@ -0,0 +1,288 @@
+#include "te_platform.h"
+#if TE_ENABLED
+// Bit-exact emulation of mlx-lm running this model on MLX's CPU backend
+// (mlx 0.32, Linux/x86 build: scalar SIMD width 1, no FMA contraction).
+//
+// Every array in that graph is bf16, and MLX's _MLX_BFloat16 arithmetic does
+// each binary op in float and rounds the result back to bf16. The ops below
+// mirror, op for op, what mlx/backend/cpu does for this model:
+//   * quantized_matmul (6 bits is not a SIMD width, so the scalar _qmm_t):
+//       sum = bf16(sum + bf16(x * bf16(bf16(scale*q) + bias))), k ascending
+//   * fast.rms_norm fallback: float32 x, mean(x^2) as a sequential sum * 1/N,
+//       1/sqrt(.+eps), x*r -> bf16, * weight -> bf16
+//   * fast.rope fallback: cos/sin from Cephes polynomials (simd/math.h) in
+//       float, rounded to bf16, then bf16 multiplies/adds
+//   * fast.sdpa fallback: q*scale, bf16 matmuls with float accumulation
+//       (simd_gemm), where(mask, s, finfo.min), precise softmax with Cephes exp
+//   * swiglu (compiled): sigmoid as 1/(1+bf16(exp|x|)), bf16 multiplies
+// It exists to prove the loader and architecture match MLX exactly; it is not
+// the production path (it is ~10x slower than te_forward's fast path).
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "te_model.h"
+#include "te_util.h"
+
+// MLX rounds between ops; a fused multiply-add here would skip a rounding it does.
+#pragma STDC FP_CONTRACT OFF
+
+#define R(x) te_round_bf16(x)
+
+// ------------------------------------------------------------------ MLX simd/math.h (N = 1)
+
+static float mlx_exp(float x_init) {
+    float x = x_init * 1.442695f;
+    float ipart = (float)floor((double)x + 0.5);  // floor(Simd<float> + double) is a double op
+    float fpart = x - ipart;
+    x = 1.535336188319500e-4f;
+    x = fmaf(x, fpart, 1.339887440266574e-3f);
+    x = fmaf(x, fpart, 9.618437357674640e-3f);
+    x = fmaf(x, fpart, 5.550332471162809e-2f);
+    x = fmaf(x, fpart, 2.402264791363012e-1f);
+    x = fmaf(x, fpart, 6.931472028550421e-1f);
+    x = fmaf(x, fpart, 1.000000000000000f);
+    uint32_t epart = (uint32_t)((int32_t)ipart + 127) << 23;
+    float pw;
+    memcpy(&pw, &epart, 4);
+    float result = isnan(x_init) ? x_init : pw * x;
+    if (x_init > 88.0f) result = INFINITY;
+    if (x_init < -88.0f) result = 0;
+    return result;
+}
+
+static float mlx_sincos(float in, int sine) {
+    int sign_sin = in < 0;
+    in = fabsf(in);
+    float x = in;
+    float y = x * 1.27323954473516f;
+    uint32_t emm2 = (uint32_t)y;
+    emm2 = emm2 + 1;
+    emm2 = emm2 & ~1u;
+    y = (float)emm2;
+    int poly_mask = (emm2 & 2) != 0;
+    x = fmaf(y, -0.78515625f, x);
+    x = fmaf(y, -2.4187564849853515625e-4f, x);
+    x = fmaf(y, -3.77489497744594108e-8f, x);
+    sign_sin = sign_sin ^ ((emm2 & 4) != 0);
+    int sign_cos = ((emm2 - 2) & 4) != 0;
+    float z = x * x;
+    float y1 = fmaf(z, 2.443315711809948e-5f, -1.388731625493765e-3f);
+    float y2 = fmaf(z, -1.9515295891e-4f, 8.3321608736e-3f);
+    y1 = fmaf(y1, z, 4.166664568298827e-2f);
+    y2 = fmaf(y2, z, -1.6666654611e-1f);
+    y1 = y1 * z;
+    y2 = y2 * z;
+    y1 = y1 * z;
+    y2 = fmaf(x, y2, x);
+    y1 = fmaf(z, -0.5f, y1);
+    y1 = y1 + 1.0f;
+    if (sine) {
+        float ys = poly_mask ? y1 : y2;
+        return sign_sin ? -ys : ys;
+    }
+    float yc = poly_mask ? y2 : y1;
+    return sign_cos ? yc : -yc;
+}
+
+// ------------------------------------------------------------------ ops
+
+typedef struct {
+    const te_qmat* W;
+    const float* X;  // [M][K] bf16-valued
+    float* Y;        // [M][N]
+    int M;
+} xq_job;
+
+static void qmm_exact_range(void* ctx, int b, int e) {
+    xq_job* j = (xq_job*)ctx;
+    const te_qmat* W = j->W;
+    int K = W->K, G = K / 64;
+    for (int n = b; n < e; n++) {
+        const uint8_t* row = W->w + (size_t)n * W->row_bytes;
+        // Dequantized row is the same for every m: bf16(bf16(s*q) + b)
+        float w[8192];
+        for (int g = 0; g < G; g++) {
+            float s = te_bf16_to_f32(W->scales[(size_t)n * G + g]);
+            float bb = te_bf16_to_f32(W->biases[(size_t)n * G + g]);
+            const uint8_t* p = row + (size_t)g * 48;
+            for (int t = 0; t < 16; t++) {
+                uint8_t b0 = p[3 * t], b1 = p[3 * t + 1], b2 = p[3 * t + 2];
+                float q[4] = {(float)(b0 & 63), (float)((b0 >> 6) | ((b1 & 15) << 2)),
+                              (float)((b1 >> 4) | ((b2 & 3) << 4)), (float)(b2 >> 2)};
+                for (int r = 0; r < 4; r++) w[g * 64 + 4 * t + r] = R(R(s * q[r]) + bb);
+            }
+        }
+        for (int m = 0; m < j->M; m++) {
+            const float* x = j->X + (size_t)m * K;
+            float sum = 0;
+            for (int k = 0; k < K; k++) sum = R(sum + R(x[k] * w[k]));
+            j->Y[(size_t)m * W->N + n] = sum;
+        }
+    }
+}
+
+static void qmm_exact(te_pool* pool, const te_qmat* W, const float* X, float* Y, int M) {
+    xq_job j = {W, X, Y, M};
+    te_pool_run(pool, W->N, 16, qmm_exact_range, &j);
+}
+
+static void rms_exact(const float* x, const uint16_t* w, float* y, int n, float eps) {
+    float ss = 0;
+    for (int i = 0; i < n; i++) ss += x[i] * x[i];
+    float mean = ss * (float)(1.0 / n);
+    float r = 1.0f / sqrtf(mean + eps);
+    for (int i = 0; i < n; i++) y[i] = R(R(x[i] * r) * te_bf16_to_f32(w[i]));
+}
+
+// mx.fast.rope fallback, traditional=False, scale=1.
+static void rope_exact(float* v, int n_heads, int hd, int pos, float base) {
+    int half = hd / 2;
+    float c = logf(base) / (float)half;
+    for (int j = 0; j < half; j++) {
+        float inv = mlx_exp((float)(-j) * c);
+        float theta = ((float)pos * 1.0f) * inv;  // (arange + offset) * scale, then * inv_freq
+        float cs = R(mlx_sincos(theta, 0)), sn = R(mlx_sincos(theta, 1));
+        for (int h = 0; h < n_heads; h++) {
+            float* p = v + h * hd;
+            float x1 = p[j], x2 = p[j + half];
+            p[j] = R(R(x1 * cs) - R(x2 * sn));
+            p[j + half] = R(R(x1 * sn) + R(x2 * cs));
+        }
+    }
+}
+
+typedef struct {
+    const te_config* c;
+    const uint16_t *K, *V;
+    int cap, p0, M;
+    const float* q;
+    float* out;
+} xattn_job;
+
+static void attn_exact_range(void* ctx, int b, int e) {
+    xattn_job* j = (xattn_job*)ctx;
+    const te_config* c = j->c;
+    int hd = c->head_dim, rep = c->n_heads / c->n_kv;
+    int S = j->p0 + j->M;  // keys visible to the chunk; later ones are masked
+    float* sc = (float*)malloc((size_t)S * sizeof(float));
+    float scale = R(c->attn_mult);
+    const float minval = -3.38953139e38f;  // finfo(bfloat16).min
+    for (int it = b; it < e; it++) {
+        int h = it / j->M, m = it % j->M;
+        const float* q = j->q + (size_t)m * c->n_heads * hd + h * hd;
+        const uint16_t* Kh = j->K + (size_t)(h / rep) * j->cap * hd;
+        const uint16_t* Vh = j->V + (size_t)(h / rep) * j->cap * hd;
+        float qs[256];
+        for (int i = 0; i < hd; i++) qs[i] = R(scale * q[i]);
+        for (int t = 0; t < S; t++) {
+            if (j->M > 1 && t > j->p0 + m) { sc[t] = minval; continue; }
+            float acc = 0;
+            for (int i = 0; i < hd; i++) acc += qs[i] * te_bf16_to_f32(Kh[(size_t)t * hd + i]);
+            sc[t] = R(acc);
+        }
+        // softmax(precise=True): float max, sum of exp, then bf16(exp * (1/sum))
+        float mx = -INFINITY;
+        for (int t = 0; t < S; t++) mx = mx > sc[t] ? mx : sc[t];
+        float norm = 0;
+        for (int t = 0; t < S; t++) norm = norm + mlx_exp(sc[t] - mx);
+        norm = 1 / norm;
+        for (int t = 0; t < S; t++) sc[t] = R(mlx_exp(sc[t] - mx) * norm);
+        float* o = j->out + (size_t)m * c->n_heads * hd + h * hd;
+        for (int i = 0; i < hd; i++) {
+            float acc = 0;
+            for (int t = 0; t < S; t++) acc += sc[t] * te_bf16_to_f32(Vh[(size_t)t * hd + i]);
+            o[i] = R(acc);
+        }
+    }
+    free(sc);
+}
+
+static float sigmoid_exact(float x) {
+    float e = R(mlx_exp(fabsf(x)));
+    float y = 1.0f / (1.0f + e);
+    return R(x < 0 ? y : 1.0f - y);
+}
+
+void te_forward_exact(const te_model* mdl, te_state* s, te_pool* pool, const int32_t* tokens, int M, float* logits) {
+    const te_config* c = &mdl->cfg;
+    int H = c->hidden, I = c->inter, hd = c->head_dim;
+    int Q = c->n_heads * hd, KV = c->n_kv * hd;
+    int p0 = s->len;
+    float emb = R(c->emb_mult), rm = R(c->resid_mult);
+    int G = H / 64;
+    for (int m = 0; m < M; m++) {
+        const te_qmat* E = &mdl->embed;
+        const uint8_t* row = E->w + (size_t)tokens[m] * E->row_bytes;
+        float* x = s->x + (size_t)m * H;
+        for (int g = 0; g < G; g++) {
+            float sc = te_bf16_to_f32(E->scales[(size_t)tokens[m] * G + g]);
+            float bb = te_bf16_to_f32(E->biases[(size_t)tokens[m] * G + g]);
+            const uint8_t* p = row + (size_t)g * 48;
+            for (int t = 0; t < 16; t++) {
+                uint8_t b0 = p[3 * t], b1 = p[3 * t + 1], b2 = p[3 * t + 2];
+                float q[4] = {(float)(b0 & 63), (float)((b0 >> 6) | ((b1 & 15) << 2)),
+                              (float)((b1 >> 4) | ((b2 & 3) << 4)), (float)(b2 >> 2)};
+                for (int r = 0; r < 4; r++) x[g * 64 + 4 * t + r] = R(R(R(q[r] * sc) + bb) * emb);
+            }
+        }
+    }
+    for (int l = 0; l < c->n_layers; l++) {
+        const te_layer* L = &mdl->layers[l];
+        for (int m = 0; m < M; m++) rms_exact(s->x + (size_t)m * H, L->in_norm, s->h + (size_t)m * H, H, c->eps);
+        qmm_exact(pool, &L->q, s->h, s->q, M);
+        qmm_exact(pool, &L->k, s->h, s->kk, M);
+        qmm_exact(pool, &L->v, s->h, s->vv, M);
+        uint16_t* Kl = s->k + (size_t)l * c->n_kv * s->cap * hd;
+        uint16_t* Vl = s->v + (size_t)l * c->n_kv * s->cap * hd;
+        for (int m = 0; m < M; m++) {
+            rope_exact(s->q + (size_t)m * Q, c->n_heads, hd, p0 + m, c->rope_theta);
+            rope_exact(s->kk + (size_t)m * KV, c->n_kv, hd, p0 + m, c->rope_theta);
+            for (int kh = 0; kh < c->n_kv; kh++)
+                for (int i = 0; i < hd; i++) {
+                    size_t dst = ((size_t)kh * s->cap + p0 + m) * hd + i;
+                    Kl[dst] = te_f32_to_bf16(s->kk[(size_t)m * KV + kh * hd + i]);
+                    Vl[dst] = te_f32_to_bf16(s->vv[(size_t)m * KV + kh * hd + i]);
+                }
+        }
+        xattn_job aj = {c, Kl, Vl, s->cap, p0, M, s->q, s->att};
+        te_pool_run(pool, c->n_heads * M, 1, attn_exact_range, &aj);
+        qmm_exact(pool, &L->o, s->att, s->tmp, M);
+        for (size_t i = 0; i < (size_t)M * H; i++) s->x[i] = R(s->x[i] + R(s->tmp[i] * rm));
+        for (int m = 0; m < M; m++) rms_exact(s->x + (size_t)m * H, L->post_norm, s->h + (size_t)m * H, H, c->eps);
+        qmm_exact(pool, &L->gate, s->h, s->g, M);
+        qmm_exact(pool, &L->up, s->h, s->u, M);
+        for (size_t i = 0; i < (size_t)M * I; i++) {
+            float g = s->g[i];
+            s->g[i] = R(R(g * sigmoid_exact(g)) * s->u[i]);
+        }
+        qmm_exact(pool, &L->down, s->g, s->tmp, M);
+        for (size_t i = 0; i < (size_t)M * H; i++) s->x[i] = R(s->x[i] + R(s->tmp[i] * rm));
+    }
+    s->len += M;
+    if (logits) {
+        rms_exact(s->x + (size_t)(M - 1) * H, mdl->norm, s->h, H, c->eps);
+        qmm_exact(pool, &mdl->lm_head, s->h, logits, 1);
+        float ls = R(c->logits_scale);
+        for (int i = 0; i < c->vocab; i++) logits[i] = R(logits[i] / ls);
+    }
+}
+
+int te_exact_pick(const float* l, int n) {
+    // logprobs = logits - logsumexp(logits), all bf16; then argmax (first max).
+    float mx = -INFINITY;
+    for (int i = 0; i < n; i++) mx = l[i] > mx ? l[i] : mx;
+    float norm = 0;
+    for (int i = 0; i < n; i++) norm = norm + mlx_exp(l[i] - mx);
+    float lse = isinf(mx) ? mx : R(logf(norm) + mx);
+    int best = 0;
+    float bv = -INFINITY;
+    for (int i = 0; i < n; i++) {
+        float lp = R(l[i] - lse);
+        if (lp > bv) { bv = lp; best = i; }
+    }
+    return best;
+}
+#else
+typedef int te_unavailable_te_exact;
+#endif
diff --git a/Sources/CTitleEngine/te_forward.c b/Sources/CTitleEngine/te_forward.c
new file mode 100644
index 0000000..6f32d59
--- /dev/null
+++ b/Sources/CTitleEngine/te_forward.c
@@ -0,0 +1,369 @@
+#include "te_platform.h"
+#if TE_ENABLED
+// Fast forward pass: fp32 activations, on-the-fly dequantization of the MLX
+// 6-bit weights, bf16 KV cache, batched prefill, thread pool over output rows.
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "te_kernels.h"
+#include "te_model.h"
+#include "te_util.h"
+#include "te_vec.h"
+
+void te_forward_exact(const te_model* m, te_state* s, te_pool* pool, const int32_t* tokens, int n, float* logits);
+
+int te_state_init(te_state* s, const te_model* m, int cap, int chunk, int n_threads) {
+    (void)n_threads;
+    memset(s, 0, sizeof(*s));
+    const te_config* c = &m->cfg;
+    if (chunk > 256) chunk = 256;
+    if (chunk < 1) chunk = 1;
+    s->cap = cap;
+    s->chunk = chunk;
+    size_t kv = (size_t)c->n_layers * c->n_kv * cap * c->head_dim;
+    s->k = (uint16_t*)malloc(kv * sizeof(uint16_t));
+    s->v = (uint16_t*)malloc(kv * sizeof(uint16_t));
+    int H = c->hidden, I = c->inter, Q = c->n_heads * c->head_dim, KV = c->n_kv * c->head_dim;
+    int big = I > H ? I : H;
+    if (Q > big) big = Q;
+    s->x = (float*)malloc((size_t)chunk * H * sizeof(float));
+    s->h = (float*)malloc((size_t)chunk * big * sizeof(float));
+    s->q = (float*)malloc((size_t)chunk * Q * sizeof(float));
+    s->kk = (float*)malloc((size_t)chunk * KV * sizeof(float));
+    s->vv = (float*)malloc((size_t)chunk * KV * sizeof(float));
+    s->att = (float*)malloc((size_t)chunk * Q * sizeof(float));
+    s->g = (float*)malloc((size_t)chunk * I * sizeof(float));
+    s->u = (float*)malloc((size_t)chunk * I * sizeof(float));
+    s->tmp = (float*)malloc((size_t)chunk * big * sizeof(float));
+    s->xperm = (float*)malloc((size_t)chunk * big * sizeof(float));
+    s->xsum = (float*)malloc((size_t)chunk * (big / 64) * sizeof(float));
+    s->xq = (int8_t*)malloc((size_t)chunk * big);
+    s->xqs = (float*)malloc((size_t)chunk * (big / 32) * sizeof(float));
+    s->xq2 = (int8_t*)malloc((size_t)chunk * big);
+    s->xqs2 = (float*)malloc((size_t)chunk * (big / 32) * sizeof(float));
+    s->logits = (float*)malloc((size_t)c->vocab * sizeof(float));
+    if (!s->k || !s->v || !s->x || !s->h || !s->q || !s->kk || !s->vv || !s->att || !s->g || !s->u ||
+        !s->tmp || !s->xperm || !s->xsum || !s->xq || !s->xqs || !s->xq2 || !s->xqs2 || !s->logits) {
+        te_state_free(s);
+        return -1;
+    }
+    return 0;
+}
+
+void te_state_free(te_state* s) {
+    free(s->k); free(s->v); free(s->x); free(s->h); free(s->q); free(s->kk); free(s->vv);
+    free(s->att); free(s->g); free(s->u); free(s->tmp); free(s->xperm); free(s->xsum);
+    free(s->xq); free(s->xqs); free(s->xq2); free(s->xqs2); free(s->logits);
+    memset(s, 0, sizeof(*s));
+}
+
+// ------------------------------------------------------------------ matmul job
+
+typedef struct {
+    const te_qmat* W;
+    const te_xprep* x;
+    float* Y;
+    int ldy;
+    int int8;
+} qmm_job;
+
+static void qmm_range(void* ctx, int b, int e) {
+    qmm_job* j = (qmm_job*)ctx;
+    if (j->int8) te_qmm_i8(j->W, j->x, j->Y, j->ldy, b, e);
+    else te_qmm_f32(j->W, j->x, j->Y, j->ldy, b, e);
+}
+
+static void qmm(te_pool* pool, const te_qmat* W, const te_xprep* x, float* Y, int int8) {
+    qmm_job j = {W, x, Y, W->N, int8};
+    int nt = te_pool_size(pool);
+    // ~4 chunks per thread for load balance on big.LITTLE, at least 8 rows each.
+    int grain = W->N / (nt * 4);
+    if (grain < 8) grain = 8;
+    grain = (grain + 3) & ~3;  // whole 4-row tiles for the int8 kernels
+    te_pool_run(pool, W->N, grain, qmm_range, &j);
+}
+
+typedef struct {
+    te_state* s;
+    const float* X;
+    int K, int8;  // 0 = f32, 1 = one int8 plane, 2 = two planes
+} prep_job;
+
+static void prep_range(void* ctx, int b, int e) {
+    prep_job* j = (prep_job*)ctx;
+    te_state* s = j->s;
+    int K = j->K;
+    te_xprep tmp;
+    for (int m = b; m < e; m++) {
+        const float* x = j->X + (size_t)m * K;
+        if (j->int8)
+            te_prep_i8(x, 1, K, s->xq + (size_t)m * K, s->xqs + (size_t)m * (K / 32),
+                       j->int8 == 2 ? s->xq2 + (size_t)m * K : NULL, j->int8 == 2 ? s->xqs2 + (size_t)m * (K / 32) : NULL,
+                       s->xsum + (size_t)m * (K / 64), &tmp);
+        else te_prep_f32(x, 1, K, s->xperm + (size_t)m * K, s->xsum + (size_t)m * (K / 64), &tmp);
+    }
+}
+
+// Prepares X[M][K] for the matmuls, one token per task.
+static void prep(te_pool* pool, te_state* s, const float* X, int M, int K, te_xprep* xp, int int8) {
+    prep_job j = {s, X, K, int8};
+    te_pool_run(pool, M, 4, prep_range, &j);
+    xp->M = M;
+    xp->K = K;
+    xp->xq = int8 ? s->xq : NULL;
+    xp->xqs = int8 ? s->xqs : NULL;
+    xp->xq2 = int8 == 2 ? s->xq2 : NULL;
+    xp->xqs2 = int8 == 2 ? s->xqs2 : NULL;
+    xp->xp = int8 ? NULL : s->xperm;
+    xp->xsum = s->xsum;
+}
+
+// ------------------------------------------------------------------ elementwise
+
+static void rmsnorm(const float* x, const uint16_t* w, float* y, int n, float eps) {
+    te_v4f ss = te_v4_splat(0);
+    for (int i = 0; i < n; i += 4) {
+        te_v4f v = te_v4_load(x + i);
+        ss += v * v;
+    }
+    float r = 1.0f / sqrtf(te_v4_sum(ss) / (float)n + eps);
+    for (int i = 0; i < n; i += 4) te_v4_store(y + i, te_v4_load(x + i) * r * te_v4_bf16(w + i));
+}
+
+static void rope(float* v, int n_heads, int hd, int pos, const float* inv_freq) {
+    int half = hd / 2;
+    for (int j = 0; j < half; j++) {
+        float th = (float)pos * inv_freq[j];
+        float c = cosf(th), sn = sinf(th);
+        for (int h = 0; h < n_heads; h++) {
+            float* p = v + h * hd;
+            float a = p[j], b = p[j + half];
+            p[j] = a * c - b * sn;
+            p[j + half] = a * sn + b * c;
+        }
+    }
+}
+
+typedef struct {
+    const float* X;
+    const uint16_t* w;
+    float* Y;
+    int H, round;
+    float eps;
+} norm_job;
+
+static void norm_range(void* ctx, int b, int e) {
+    norm_job* j = (norm_job*)ctx;
+    for (int m = b; m < e; m++) {
+        float* y = j->Y + (size_t)m * j->H;
+        rmsnorm(j->X + (size_t)m * j->H, j->w, y, j->H, j->eps);
+        if (j->round)
+            for (int i = 0; i < j->H; i++) y[i] = te_round_bf16(y[i]);
+    }
+}
+
+static void norm_rows(te_pool* pool, const float* X, const uint16_t* w, float* Y, int M, int H, float eps, int round) {
+    norm_job j = {X, w, Y, H, round, eps};
+    te_pool_run(pool, M, 4, norm_range, &j);
+}
+
+typedef struct {
+    float *g;
+    const float* u;
+    size_t I;
+} swiglu_job;
+
+static void swiglu_range(void* ctx, int b, int e) {
+    swiglu_job* j = (swiglu_job*)ctx;
+    for (size_t i = (size_t)b * j->I; i < (size_t)e * j->I; i += 4) {  // multiples of 64
+        te_v4f g = te_v4_load(j->g + i);
+        te_v4_store(j->g + i, g / (1.0f + te_v4_exp(-g)) * te_v4_load(j->u + i));
+    }
+}
+
+typedef struct {
+    const te_model* mdl;
+    te_state* s;
+    uint16_t *K, *V;
+    int p0, round;
+} rope_job;
+
+// RoPE on q and k, then k and v into the bf16 cache, one token per task.
+static void rope_range(void* ctx, int b, int e) {
+    rope_job* j = (rope_job*)ctx;
+    const te_config* c = &j->mdl->cfg;
+    te_state* s = j->s;
+    int hd = c->head_dim, Q = c->n_heads * hd, KV = c->n_kv * hd;
+    for (int m = b; m < e; m++) {
+        float* q = s->q + (size_t)m * Q;
+        float* k = s->kk + (size_t)m * KV;
+        if (j->round) {
+            for (int i = 0; i < Q; i++) q[i] = te_round_bf16(q[i]);
+            for (int i = 0; i < KV; i++) k[i] = te_round_bf16(k[i]);
+        }
+        rope(q, c->n_heads, hd, j->p0 + m, j->mdl->rope_inv_freq);
+        rope(k, c->n_kv, hd, j->p0 + m, j->mdl->rope_inv_freq);
+        if (j->round)
+            for (int i = 0; i < Q; i++) q[i] = te_round_bf16(q[i]);
+        for (int kh = 0; kh < c->n_kv; kh++)
+            for (int i = 0; i < hd; i++) {
+                size_t dst = ((size_t)kh * s->cap + j->p0 + m) * hd + i;
+                j->K[dst] = te_f32_to_bf16(k[kh * hd + i]);
+                j->V[dst] = te_f32_to_bf16(s->vv[(size_t)m * KV + kh * hd + i]);
+            }
+    }
+}
+
+// ------------------------------------------------------------------ attention job
+
+typedef struct {
+    const te_config* c;
+    const uint16_t* K;  // this layer: [kv][cap][hd]
+    const uint16_t* V;
+    int cap, p0, M;
+    const float* q;  // [M][n_heads*hd]
+    float* out;      // [M][n_heads*hd]
+} attn_job;
+
+static void attn_range(void* ctx, int b, int e) {
+    attn_job* j = (attn_job*)ctx;
+    const te_config* c = j->c;
+    int hd = c->head_dim, rep = c->n_heads / c->n_kv;
+    int nv = hd / 4;  // head_dim is a multiple of 4 (64 here)
+    float* sc = (float*)malloc((size_t)(j->p0 + j->M + 4) * sizeof(float));
+    if (!sc) return;
+    for (int it = b; it < e; it++) {
+        int h = it / j->M, m = it % j->M;
+        int kvh = h / rep;
+        int S = j->p0 + m + 1;  // causal
+        const float* q = j->q + (size_t)m * c->n_heads * hd + h * hd;
+        const uint16_t* Kh = j->K + (size_t)kvh * j->cap * hd;
+        const uint16_t* Vh = j->V + (size_t)kvh * j->cap * hd;
+        te_v4f qv[64];
+        for (int i = 0; i < nv; i++) qv[i] = te_v4_load(q + 4 * i) * c->attn_mult;
+        float mx = -INFINITY;
+        for (int t = 0; t < S; t++) {
+            const uint16_t* k = Kh + (size_t)t * hd;
+            te_v4f a0 = qv[0] * te_v4_bf16(k), a1 = qv[1] * te_v4_bf16(k + 4);
+            for (int i = 2; i < nv; i += 2) {
+                a0 += qv[i] * te_v4_bf16(k + 4 * i);
+                a1 += qv[i + 1] * te_v4_bf16(k + 4 * i + 4);
+            }
+            float d = te_v4_sum(a0 + a1);
+            sc[t] = d;
+            if (d > mx) mx = d;
+        }
+        for (int t = S; t < ((S + 3) & ~3); t++) sc[t] = -INFINITY;
+        te_v4f sum4 = te_v4_splat(0);
+        for (int t = 0; t < S; t += 4) {
+            te_v4f p = te_v4_exp(te_v4_load(sc + t) - mx);
+            te_v4_store(sc + t, p);
+            sum4 += p;
+        }
+        float inv = 1.0f / te_v4_sum(sum4);
+        te_v4f o[64];
+        for (int i = 0; i < nv; i++) o[i] = te_v4_splat(0);
+        for (int t = 0; t < S; t++) {
+            const uint16_t* v = Vh + (size_t)t * hd;
+            float p = sc[t];
+            for (int i = 0; i < nv; i++) o[i] += p * te_v4_bf16(v + 4 * i);
+        }
+        float* out = j->out + (size_t)m * c->n_heads * hd + h * hd;
+        for (int i = 0; i < nv; i++) te_v4_store(out + 4 * i, o[i] * inv);
+    }
+    free(sc);
+}
+
+// ------------------------------------------------------------------ forward
+
+static void rnd(int on, float* p, size_t n) {
+    if (!on) return;
+    for (size_t i = 0; i < n; i++) p[i] = te_round_bf16(p[i]);
+}
+
+// flags: TE_FWD_EXACT (MLX CPU emulation), TE_FWD_INT8 (int8 activations),
+// TE_FWD_BF16 (round every tensor to bf16 where MLX's graph stores one, with fp32
+// math inside each op -- the numerics model of MLX on Apple GPUs).
+void te_forward(const te_model* mdl, te_state* s, te_pool* pool, const int32_t* tokens, int M,
+                float* logits, int flags) {
+    if (flags & TE_FWD_EXACT) {
+        te_forward_exact(mdl, s, pool, tokens, M, logits);
+        return;
+    }
+    int int8 = (flags & TE_FWD_INT8) ? ((flags & TE_FWD_I8X2) ? 2 : 1) : 0;
+    int b = (flags & TE_FWD_BF16) != 0;
+    const te_config* c = &mdl->cfg;
+    int H = c->hidden, I = c->inter, hd = c->head_dim;
+    int Q = c->n_heads * hd;
+    size_t MH = (size_t)M * H, MI = (size_t)M * I;
+    int p0 = s->len;
+    float rm = b ? te_round_bf16(c->resid_mult) : c->resid_mult;
+    te_xprep xp;
+    for (int m = 0; m < M; m++) {
+        te_dequant_row(&mdl->embed, tokens[m], s->x + (size_t)m * H);
+        if (b) rnd(1, s->x + (size_t)m * H, (size_t)H);
+        for (int i = 0; i < H; i++) s->x[(size_t)m * H + i] *= c->emb_mult;
+    }
+    rnd(b, s->x, MH);
+    for (int l = 0; l < c->n_layers; l++) {
+        const te_layer* L = &mdl->layers[l];
+        norm_rows(pool, s->x, L->in_norm, s->h, M, H, c->eps, b);
+        prep(pool, s, s->h, M, H, &xp, int8);
+        qmm(pool, &L->q, &xp, s->q, int8);
+        qmm(pool, &L->k, &xp, s->kk, int8);
+        qmm(pool, &L->v, &xp, s->vv, int8);
+        uint16_t* Kl = s->k + (size_t)l * c->n_kv * s->cap * hd;
+        uint16_t* Vl = s->v + (size_t)l * c->n_kv * s->cap * hd;
+        rope_job rj = {mdl, s, Kl, Vl, p0, b};
+        te_pool_run(pool, M, 4, rope_range, &rj);
+        attn_job aj = {c, Kl, Vl, s->cap, p0, M, s->q, s->att};
+        te_pool_run(pool, c->n_heads * M, 1, attn_range, &aj);
+        rnd(b, s->att, (size_t)M * Q);
+        prep(pool, s, s->att, M, Q, &xp, int8);
+        qmm(pool, &L->o, &xp, s->tmp, int8);
+        rnd(b, s->tmp, MH);
+        for (size_t i = 0; i < MH; i++) {
+            float t = s->tmp[i] * rm;
+            if (b) t = te_round_bf16(t);
+            s->x[i] += t;
+        }
+        rnd(b, s->x, MH);
+        norm_rows(pool, s->x, L->post_norm, s->h, M, H, c->eps, b);
+        prep(pool, s, s->h, M, H, &xp, int8);
+        qmm(pool, &L->gate, &xp, s->g, int8);
+        qmm(pool, &L->up, &xp, s->u, int8);
+        if (b) {
+            for (size_t i = 0; i < MI; i++) {
+                float g = te_round_bf16(s->g[i]);
+                float sg = te_round_bf16(1.0f / (1.0f + expf(-g)));
+                s->g[i] = te_round_bf16(te_round_bf16(g * sg) * te_round_bf16(s->u[i]));
+            }
+        } else {
+            swiglu_job sj = {s->g, s->u, (size_t)I};
+            te_pool_run(pool, M, 4, swiglu_range, &sj);
+        }
+        prep(pool, s, s->g, M, I, &xp, int8);
+        qmm(pool, &L->down, &xp, s->tmp, int8);
+        rnd(b, s->tmp, MH);
+        for (size_t i = 0; i < MH; i++) {
+            float t = s->tmp[i] * rm;
+            if (b) t = te_round_bf16(t);
+            s->x[i] += t;
+        }
+        rnd(b, s->x, MH);
+    }
+    s->len += M;
+    if (logits) {
+        rmsnorm(s->x + (size_t)(M - 1) * H, mdl->norm, s->h, H, c->eps);
+        rnd(b, s->h, (size_t)H);
+        prep(pool, s, s->h, 1, H, &xp, int8);
+        qmm(pool, &mdl->lm_head, &xp, logits, int8);
+        rnd(b, logits, (size_t)c->vocab);
+        float inv = 1.0f / c->logits_scale;
+        for (int i = 0; i < c->vocab; i++) logits[i] *= inv;
+    }
+}
+#else
+typedef int te_unavailable_te_forward;
+#endif
