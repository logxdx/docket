+#!/usr/bin/env bash
+# Host builds of CTitleEngine's tools (Sources/CTitleEngine), for parity and speed work.
+#   Tools/title-engine/build.sh [OUT_DIR]       -> title-cli, tok_dump, kernel_test
+#   SIMDE=/path/to/simde Tools/title-engine/build.sh   also builds kernel_test-neon, the NEON
+#   kernels run on x86 through SIMDe (https://github.com/simd-everywhere/simde)
+#
+# Parity against MLX (needs `pip install "mlx[cpu]" mlx-lm` and the model folder):
+#   python -I mlx_reference.py MODEL passages.json mlx.json            # official mlx-lm, bf16
+#   OUT/title-cli MODEL --numerics exact --budget 0 --passages passages.json --out exact.json
+#   python -I parity_compare.py mlx.json exact.json                    # identical tokens
+# `--numerics exact` emulates MLX's CPU backend op for op (see te_exact.c); int8 (the
+# default), f32, f32-bf16 and int8-bf16 are the fast paths.
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+src="$here/../../Sources/CTitleEngine"
+out="${1:-$here/.build}"
+mkdir -p "$out"
+cc="${CC:-clang}"
+flags=(-O2 -std=c11 -I"$src" -I"$src/include")
+"$cc" "${flags[@]}" -o "$out/title-cli" "$here/title_cli.c" "$src"/*.c -lm -lpthread
+"$cc" "${flags[@]}" -o "$out/tok_dump" "$here/tok_dump.c" "$src"/*.c -lm -lpthread
+"$cc" "${flags[@]}" -o "$out/kernel_test" "$here/kernel_test.c" "$src"/*.c -lm -lpthread
+if [ -n "${SIMDE:-}" ]; then
+    "$cc" "${flags[@]}" -DTE_SIMDE_NEON -I"$SIMDE" -march=native -o "$out/kernel_test-neon" \
+        "$here/kernel_test.c" "$src"/*.c -lm -lpthread
+fi
+echo "built into $out"
diff --git a/Tools/title-engine/check_packing.py b/Tools/title-engine/check_packing.py
new file mode 100644
index 0000000..7218b8c
--- /dev/null
+++ b/Tools/title-engine/check_packing.py
@@ -0,0 +1,57 @@
+"""Confirm the 6-bit packing the engine assumes against MLX itself.
+
+Engine rule (src/te_kernels.h): a row is a little-endian bitstream, value k in
+bits [6k, 6k+6); per 3 bytes b0 b1 b2:
+  q0 = b0 & 63, q1 = b0>>6 | (b1&15)<<2, q2 = b1>>4 | (b2&3)<<4, q3 = b2>>2
+and w = scale * q + bias per group of 64.
+
+usage: python -I check_packing.py [MODEL_DIR]
+"""
+import sys
+
+import mlx.core as mx
+import numpy as np
+
+
+def unpack_rule(wq: np.ndarray, k: int) -> np.ndarray:
+    b = wq.view(np.uint8).reshape(wq.shape[0], -1, 3).astype(np.uint32)
+    b0, b1, b2 = b[..., 0], b[..., 1], b[..., 2]
+    q = np.stack([b0 & 63, (b0 >> 6) | ((b1 & 15) << 2), (b1 >> 4) | ((b2 & 3) << 4), b2 >> 2], -1)
+    return q.reshape(wq.shape[0], k)
+
+
+def check(w_q, scales, biases, k, label):
+    q = unpack_rule(np.array(w_q), k).astype(np.float32)
+    s = np.repeat(np.array(scales.astype(mx.float32)), 64, axis=1)
+    b = np.repeat(np.array(biases.astype(mx.float32)), 64, axis=1)
+    mine = s * q + b
+    ref = np.array(mx.dequantize(w_q, scales.astype(mx.float32), biases.astype(mx.float32),
+                                 group_size=64, bits=6))
+    ok = np.array_equal(mine, ref)
+    print(f"{label}: {'identical' if ok else 'MISMATCH'} (max |diff| {np.abs(mine - ref).max():.3g})")
+    return ok
+
+
+def main():
+    rng = np.random.default_rng(0)
+    w = mx.array(rng.standard_normal((8, 256)).astype(np.float32))
+    wq, sc, bi = mx.quantize(w, group_size=64, bits=6)
+    print("mx.quantize: weight", wq.dtype, wq.shape, "scales", sc.shape)
+    ok = check(wq, sc, bi, 256, "random 8x256")
+    # Known values: a ramp 0..63 must come back in order.
+    ramp = mx.array(np.tile(np.arange(64, dtype=np.float32), (1, 4)))
+    rq, rs, rb = mx.quantize(ramp, group_size=64, bits=6)
+    q = unpack_rule(np.array(rq), 256)[0]
+    s0, b0 = float(np.array(rs)[0, 0]), float(np.array(rb)[0, 0])  # MLX picks scale=-1, bias=63 here
+    ramp_ok = [s0 * v + b0 for v in q[:64]] == list(range(64))
+    print(f"ramp 0..63 (scale {s0:g}, bias {b0:g}) unpacks in order:", ramp_ok, list(q[:8]))
+    ok &= ramp_ok
+    if len(sys.argv) > 1:
+        t = mx.load(f"{sys.argv[1]}/model.safetensors")
+        for name, k in [("model.embed_tokens", 1024), ("model.layers.0.mlp.down_proj", 2048)]:
+            ok &= check(t[name + ".weight"][:64], t[name + ".scales"][:64], t[name + ".biases"][:64], k, name)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Tools/title-engine/gen_unicode_tables.py b/Tools/title-engine/gen_unicode_tables.py
new file mode 100644
index 0000000..64dd7dc
--- /dev/null
+++ b/Tools/title-engine/gen_unicode_tables.py
@@ -0,0 +1,51 @@
+"""Generate src/unicode_tables.h: sorted codepoint ranges for \\p{L}, \\p{N} and
+\\s (Unicode White_Space), the three classes the Granite/cl100k pre-tokenizer
+regex uses.
+
+usage: python -I gen_unicode_tables.py > ../src/unicode_tables.h
+"""
+import sys
+import unicodedata
+
+# Unicode White_Space property (stable since Unicode 6.3).
+WHITE_SPACE = [0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x20, 0x85, 0xA0, 0x1680,
+               *range(0x2000, 0x200B), 0x2028, 0x2029, 0x202F, 0x205F, 0x3000]
+
+
+def ranges(pred):
+    out, start = [], None
+    for cp in range(0x110000):
+        ok = pred(cp)
+        if ok and start is None:
+            start = cp
+        elif not ok and start is not None:
+            out.append((start, cp - 1))
+            start = None
+    if start is not None:
+        out.append((start, 0x10FFFF))
+    return out
+
+
+def emit(name, rs):
+    print(f"static const uint32_t {name}[][2] = {{")
+    for i in range(0, len(rs), 4):
+        print("    " + " ".join(f"{{0x{a:X}, 0x{b:X}}}," for a, b in rs[i:i + 4]))
+    print("};")
+
+
+def main():
+    letters = ranges(lambda c: unicodedata.category(chr(c)) in ("Lu", "Ll", "Lt", "Lm", "Lo"))
+    numbers = ranges(lambda c: unicodedata.category(chr(c)) in ("Nd", "Nl", "No"))
+    ws = set(WHITE_SPACE)
+    spaces = ranges(lambda c: c in ws)
+    print(f"// Generated by tools/gen_unicode_tables.py from Unicode {unicodedata.unidata_version}.")
+    print("// Do not edit by hand.")
+    print("#pragma once")
+    print("#include <stdint.h>")
+    emit("TE_UNI_LETTER", letters)
+    emit("TE_UNI_NUMBER", numbers)
+    emit("TE_UNI_SPACE", spaces)
+
+
+if __name__ == "__main__":
+    main()
