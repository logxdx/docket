+++ b/Sources/CTitleEngine/te_json.c
@@ -0,0 +1,288 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include "te_json.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct arena_block {
+    struct arena_block* next;
+    size_t used, cap;
+    char data[];
+} arena_block;
+
+struct tj_doc {
+    arena_block* blocks;
+    tj_value root;
+};
+
+static void* arena_alloc(tj_doc* d, size_t n) {
+    n = (n + 15) & ~(size_t)15;
+    arena_block* b = d->blocks;
+    if (!b || b->used + n > b->cap) {
+        size_t cap = n > (1u << 20) ? n : (1u << 20);
+        b = (arena_block*)malloc(sizeof(arena_block) + cap);
+        if (!b) return NULL;
+        b->next = d->blocks;
+        b->used = 0;
+        b->cap = cap;
+        d->blocks = b;
+    }
+    void* p = b->data + b->used;
+    b->used += n;
+    return p;
+}
+
+typedef struct {
+    const char* p;
+    const char* end;
+    tj_doc* doc;
+    char* err;
+    size_t errlen;
+    int depth;
+} parser;
+
+static int fail(parser* ps, const char* msg) {
+    if (ps->err && ps->errlen) snprintf(ps->err, ps->errlen, "json: %s", msg);
+    return -1;
+}
+
+static void skip_ws(parser* ps) {
+    while (ps->p < ps->end && (*ps->p == ' ' || *ps->p == '\n' || *ps->p == '\r' || *ps->p == '\t')) ps->p++;
+}
+
+static int hex4(const char* s, unsigned* out) {
+    unsigned v = 0;
+    for (int i = 0; i < 4; i++) {
+        char c = s[i];
+        v <<= 4;
+        if (c >= '0' && c <= '9') v |= (unsigned)(c - '0');
+        else if (c >= 'a' && c <= 'f') v |= (unsigned)(c - 'a' + 10);
+        else if (c >= 'A' && c <= 'F') v |= (unsigned)(c - 'A' + 10);
+        else return -1;
+    }
+    *out = v;
+    return 0;
+}
+
+static size_t put_utf8(char* o, unsigned cp) {
+    if (cp < 0x80) { o[0] = (char)cp; return 1; }
+    if (cp < 0x800) { o[0] = (char)(0xC0 | (cp >> 6)); o[1] = (char)(0x80 | (cp & 0x3F)); return 2; }
+    if (cp < 0x10000) {
+        o[0] = (char)(0xE0 | (cp >> 12)); o[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
+        o[2] = (char)(0x80 | (cp & 0x3F)); return 3;
+    }
+    o[0] = (char)(0xF0 | (cp >> 18)); o[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
+    o[2] = (char)(0x80 | ((cp >> 6) & 0x3F)); o[3] = (char)(0x80 | (cp & 0x3F));
+    return 4;
+}
+
+static int parse_string(parser* ps, const char** out, size_t* out_len) {
+    // ps->p at opening quote
+    ps->p++;
+    const char* s = ps->p;
+    size_t raw = 0;
+    int escapes = 0;
+    while (s + raw < ps->end && s[raw] != '"') {
+        if (s[raw] == '\\') { escapes = 1; raw++; }
+        raw++;
+    }
+    if (s + raw >= ps->end) return fail(ps, "unterminated string");
+    char* o = (char*)arena_alloc(ps->doc, raw + 1);
+    if (!o) return fail(ps, "out of memory");
+    size_t n = 0;
+    if (!escapes) {
+        memcpy(o, s, raw);
+        n = raw;
+    } else {
+        const char* q = s;
+        const char* qend = s + raw;
+        while (q < qend) {
+            char c = *q++;
+            if (c != '\\') { o[n++] = c; continue; }
+            if (q >= qend) return fail(ps, "bad escape");
+            char e = *q++;
+            switch (e) {
+                case '"': o[n++] = '"'; break;
+                case '\\': o[n++] = '\\'; break;
+                case '/': o[n++] = '/'; break;
+                case 'b': o[n++] = '\b'; break;
+                case 'f': o[n++] = '\f'; break;
+                case 'n': o[n++] = '\n'; break;
+                case 'r': o[n++] = '\r'; break;
+                case 't': o[n++] = '\t'; break;
+                case 'u': {
+                    unsigned cp;
+                    if (qend - q < 4 || hex4(q, &cp)) return fail(ps, "bad \\u escape");
+                    q += 4;
+                    if (cp >= 0xD800 && cp < 0xDC00 && qend - q >= 6 && q[0] == '\\' && q[1] == 'u') {
+                        unsigned lo;
+                        if (!hex4(q + 2, &lo) && lo >= 0xDC00 && lo < 0xE000) {
+                            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
+                            q += 6;
+                        }
+                    }
+                    n += put_utf8(o + n, cp);  // \uXXXX is 6 bytes in, at most 4 out
+                    break;
+                }
+                default: return fail(ps, "bad escape");
+            }
+        }
+    }
+    o[n] = 0;
+    *out = o;
+    *out_len = n;
+    ps->p = s + raw + 1;
+    return 0;
+}
+
+static int parse_value(parser* ps, tj_value* v);
+
+typedef struct { tj_value* v; const char** k; size_t* kl; size_t n, cap; } growbuf;
+
+static int grow(growbuf* g, int with_keys) {
+    size_t cap = g->cap ? g->cap * 2 : 8;
+    tj_value* nv = (tj_value*)realloc(g->v, cap * sizeof(tj_value));
+    if (!nv) return -1;
+    g->v = nv;
+    if (with_keys) {
+        const char** nk = (const char**)realloc((void*)g->k, cap * sizeof(char*));
+        if (!nk) return -1;
+        g->k = nk;
+        size_t* nkl = (size_t*)realloc(g->kl, cap * sizeof(size_t));
+        if (!nkl) return -1;
+        g->kl = nkl;
+    }
+    g->cap = cap;
+    return 0;
+}
+
+static int finish(parser* ps, growbuf* g, tj_value* v, int with_keys) {
+    v->len = g->n;
+    v->items = (tj_value*)arena_alloc(ps->doc, g->n * sizeof(tj_value) + 1);
+    if (!v->items) return fail(ps, "out of memory");
+    if (g->n) memcpy(v->items, g->v, g->n * sizeof(tj_value));
+    if (with_keys) {
+        v->keys = (const char**)arena_alloc(ps->doc, g->n * sizeof(char*) + 1);
+        v->key_lens = (size_t*)arena_alloc(ps->doc, g->n * sizeof(size_t) + 1);
+        if (!v->keys || !v->key_lens) return fail(ps, "out of memory");
+        if (g->n) {
+            memcpy((void*)v->keys, g->k, g->n * sizeof(char*));
+            memcpy(v->key_lens, g->kl, g->n * sizeof(size_t));
+        }
+    }
+    free(g->v);
+    free((void*)g->k);
+    free(g->kl);
+    return 0;
+}
+
+static int parse_value(parser* ps, tj_value* v) {
+    memset(v, 0, sizeof(*v));
+    skip_ws(ps);
+    if (ps->p >= ps->end) return fail(ps, "unexpected end");
+    if (++ps->depth > 256) return fail(ps, "too deep");
+    char c = *ps->p;
+    int rc = 0;
+    if (c == '{' || c == '[') {
+        int obj = c == '{';
+        v->type = obj ? TJ_OBJ : TJ_ARR;
+        ps->p++;
+        growbuf g = {0};
+        skip_ws(ps);
+        if (ps->p < ps->end && *ps->p == (obj ? '}' : ']')) {
+            ps->p++;
+        } else {
+            for (;;) {
+                if (g.n == g.cap && grow(&g, obj)) { rc = fail(ps, "out of memory"); break; }
+                if (obj) {
+                    skip_ws(ps);
+                    if (ps->p >= ps->end || *ps->p != '"') { rc = fail(ps, "expected key"); break; }
+                    if ((rc = parse_string(ps, &g.k[g.n], &g.kl[g.n]))) break;
+                    skip_ws(ps);
+                    if (ps->p >= ps->end || *ps->p != ':') { rc = fail(ps, "expected ':'"); break; }
+                    ps->p++;
+                }
+                if ((rc = parse_value(ps, &g.v[g.n]))) break;
+                g.n++;
+                skip_ws(ps);
+                if (ps->p < ps->end && *ps->p == ',') { ps->p++; continue; }
+                if (ps->p < ps->end && *ps->p == (obj ? '}' : ']')) { ps->p++; break; }
+                rc = fail(ps, "expected ',' or close");
+                break;
+            }
+        }
+        if (rc) { free(g.v); free((void*)g.k); free(g.kl); }
+        else rc = finish(ps, &g, v, obj);
+    } else if (c == '"') {
+        v->type = TJ_STR;
+        rc = parse_string(ps, &v->str, &v->len);
+    } else if (c == 't' && ps->end - ps->p >= 4 && !memcmp(ps->p, "true", 4)) {
+        v->type = TJ_BOOL; v->boolean = 1; ps->p += 4;
+    } else if (c == 'f' && ps->end - ps->p >= 5 && !memcmp(ps->p, "false", 5)) {
+        v->type = TJ_BOOL; ps->p += 5;
+    } else if (c == 'n' && ps->end - ps->p >= 4 && !memcmp(ps->p, "null", 4)) {
+        v->type = TJ_NULL; ps->p += 4;
+    } else if (c == '-' || (c >= '0' && c <= '9')) {
+        char buf[64];
+        size_t n = 0;
+        while (ps->p + n < ps->end && n < sizeof(buf) - 1 &&
+               strchr("0123456789+-.eE", ps->p[n]) && ps->p[n]) {
+            buf[n] = ps->p[n];
+            n++;
+        }
+        buf[n] = 0;
+        v->type = TJ_NUM;
+        v->num = strtod(buf, NULL);
+        ps->p += n;
+    } else {
+        rc = fail(ps, "unexpected character");
+    }
+    ps->depth--;
+    return rc;
+}
+
+tj_doc* te_json_parse(const char* text, size_t len, char* err, size_t errlen) {
+    tj_doc* d = (tj_doc*)calloc(1, sizeof(tj_doc));
+    if (!d) return NULL;
+    parser ps = {text, text + len, d, err, errlen, 0};
+    if (parse_value(&ps, &d->root)) {
+        te_json_free(d);
+        return NULL;
+    }
+    return d;
+}
+
+const tj_value* te_json_root(const tj_doc* doc) { return &doc->root; }
+
+void te_json_free(tj_doc* d) {
+    if (!d) return;
+    arena_block* b = d->blocks;
+    while (b) {
+        arena_block* n = b->next;
+        free(b);
+        b = n;
+    }
+    free(d);
+}
+
+const tj_value* tj_get(const tj_value* obj, const char* key) {
+    if (!obj || obj->type != TJ_OBJ) return NULL;
+    size_t kl = strlen(key);
+    for (size_t i = 0; i < obj->len; i++)
+        if (obj->key_lens[i] == kl && !memcmp(obj->keys[i], key, kl)) return &obj->items[i];
+    return NULL;
+}
+
+double tj_num(const tj_value* v, double fallback) {
+    if (!v) return fallback;
+    if (v->type == TJ_NUM) return v->num;
+    if (v->type == TJ_BOOL) return v->boolean;
+    return fallback;
+}
+
+const char* tj_str(const tj_value* v) { return v && v->type == TJ_STR ? v->str : NULL; }
+#else
+typedef int te_unavailable_te_json;
+#endif
diff --git a/Sources/CTitleEngine/te_json.h b/Sources/CTitleEngine/te_json.h
new file mode 100644
index 0000000..d2c3573
--- /dev/null
+++ b/Sources/CTitleEngine/te_json.h
@@ -0,0 +1,29 @@
+// Minimal JSON DOM: enough for config.json, tokenizer.json and safetensors
+// headers. All nodes and strings live in one arena freed by te_json_free.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+typedef enum { TJ_NULL, TJ_BOOL, TJ_NUM, TJ_STR, TJ_ARR, TJ_OBJ } tj_type;
+
+typedef struct tj_value {
+    tj_type type;
+    int boolean;
+    double num;
+    const char* str;        // UTF-8, NUL-terminated (may contain embedded NULs; use len)
+    size_t len;             // string length, or number of children
+    struct tj_value* items; // array items / object values
+    const char** keys;      // object keys (NUL-terminated)
+    size_t* key_lens;
+} tj_value;
+
+typedef struct tj_doc tj_doc;
+
+// Parses `len` bytes. Returns NULL on error and writes a message to err.
+tj_doc* te_json_parse(const char* text, size_t len, char* err, size_t errlen);
+const tj_value* te_json_root(const tj_doc* doc);
+void te_json_free(tj_doc* doc);
+
+const tj_value* tj_get(const tj_value* obj, const char* key);
+double tj_num(const tj_value* v, double fallback);
+const char* tj_str(const tj_value* v);  // NULL unless a string
diff --git a/Sources/CTitleEngine/te_kernels.c b/Sources/CTitleEngine/te_kernels.c
new file mode 100644
index 0000000..18c8f94
--- /dev/null
+++ b/Sources/CTitleEngine/te_kernels.c
@@ -0,0 +1,563 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include "te_kernels.h"
+
+#include <math.h>
+#include <string.h>
+
+#include "te_util.h"
+
+#if defined(TE_SIMDE_NEON)
+// Test-only: run the NEON kernels on x86 through SIMDe (tools/test_neon.sh).
+#define SIMDE_ENABLE_NATIVE_ALIASES
+#include <simde/arm/neon.h>
+#include <stdlib.h>
+#define TE_NEON 1
+#elif defined(__aarch64__)
+#include <arm_neon.h>
+#if defined(__linux__) || defined(__ANDROID__)
+#include <sys/auxv.h>
+#ifndef HWCAP_ASIMDDP
+#define HWCAP_ASIMDDP (1 << 20)
+#endif
+#endif
+#define TE_NEON 1
+#elif defined(__x86_64__)
+#include <immintrin.h>
+#define TE_X86 1
+#endif
+
+#define TE_MAXM 256
+
+static inline void unpack64(const uint8_t* p, uint8_t* q) {
+    for (int j = 0; j < 16; j++) {
+        uint8_t b0 = p[3 * j], b1 = p[3 * j + 1], b2 = p[3 * j + 2];
+        q[4 * j + 0] = b0 & 63;
+        q[4 * j + 1] = (uint8_t)((b0 >> 6) | ((b1 & 15) << 2));
+        q[4 * j + 2] = (uint8_t)((b1 >> 4) | ((b2 & 3) << 4));
+        q[4 * j + 3] = b2 >> 2;
+    }
+}
+
+void te_dequant_row(const te_qmat* W, int n, float* out) {
+    const uint8_t* row = W->w + (size_t)n * W->row_bytes;
+    int G = W->K / TE_GS;
+    uint8_t q[TE_GS];
+    for (int g = 0; g < G; g++) {
+        unpack64(row + (size_t)g * 48, q);
+        float s = te_bf16_to_f32(W->scales[(size_t)n * G + g]);
+        float b = te_bf16_to_f32(W->biases[(size_t)n * G + g]);
+        for (int i = 0; i < TE_GS; i++) out[g * TE_GS + i] = s * q[i] + b;
+    }
+}
+
+int te_kernel_lane(int k) {
+#if TE_NEON
+    return 16 * (k & 3) + (k >> 2);
+#else
+    return k;
+#endif
+}
+
+// ------------------------------------------------------------------ x86 feature check
+#if TE_X86
+static int have_avx2(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        __builtin_cpu_init();
+        cached = __builtin_cpu_supports("avx2") && __builtin_cpu_supports("fma") && __builtin_cpu_supports("bmi2");
+    }
+    return cached;
+}
+#endif
+
+#if TE_NEON
+static int have_dotprod(void) {
+    static int cached = -1;
+    if (cached < 0) {
+#if defined(TE_SIMDE_NEON)
+        cached = getenv("TE_NO_DOTPROD") == NULL;
+#elif defined(__ARM_FEATURE_DOTPROD)
+        cached = 1;
+#elif defined(__linux__) || defined(__ANDROID__)
+        cached = (getauxval(AT_HWCAP) & HWCAP_ASIMDDP) != 0;
+#else
+        cached = 0;
+#endif
+    }
+    return cached;
+}
+#endif
+
+const char* te_kernel_name(int int8) {
+#if TE_NEON
+    if (int8) return have_dotprod() ? "neon-i8-sdot" : "neon-i8";
+    return "neon-f32";
+#elif TE_X86
+    if (have_avx2()) return int8 ? "avx2-i8" : "avx2-f32";
+    return int8 ? "scalar-i8" : "scalar-f32";
+#else
+    return int8 ? "scalar-i8" : "scalar-f32";
+#endif
+}
+
+// ------------------------------------------------------------------ preparation
+
+void te_prep_f32(const float* X, int M, int K, float* xp, float* xsum, te_xprep* out) {
+    int G = K / TE_GS;
+    for (int m = 0; m < M; m++) {
+        const float* x = X + (size_t)m * K;
+        float* o = xp + (size_t)m * K;
+        for (int g = 0; g < G; g++) {
+            float s = 0;
+            for (int i = 0; i < TE_GS; i++) {
+                float v = x[g * TE_GS + i];
+                o[g * TE_GS + te_kernel_lane(i)] = v;
+                s += v;
+            }
+            xsum[(size_t)m * G + g] = s;
+        }
+    }
+    out->M = M; out->K = K; out->xp = xp; out->xsum = xsum; out->xq = NULL; out->xqs = NULL;
+    out->xq2 = NULL; out->xqs2 = NULL;
+}
+
+void te_prep_i8(const float* X, int M, int K, int8_t* xq, float* xqs, int8_t* xq2, float* xqs2, float* xsum,
+                te_xprep* out) {
+    int G = K / TE_GS;
+    for (int m = 0; m < M; m++) {
+        const float* x = X + (size_t)m * K;
+        int8_t* o = xq + (size_t)m * K;
+        int8_t* o2 = xq2 ? xq2 + (size_t)m * K : NULL;
+        for (int g = 0; g < G; g++) {
+            float gs = 0, exact = 0;
+            for (int h = 0; h < 2; h++) {
+                const float* xb = x + g * TE_GS + h * 32;
+                float amax = 0;
+                for (int i = 0; i < 32; i++) amax = fmaxf(amax, fabsf(xb[i]));
+                float d = amax / 127.0f;
+                float id = d > 0 ? 1.0f / d : 0.0f;
+                int isum = 0;
+                float res[32], rmax = 0;
+                for (int i = 0; i < 32; i++) {
+                    int v = (int)__builtin_rintf(xb[i] * id);
+                    v = v > 127 ? 127 : (v < -127 ? -127 : v);
+                    o[g * TE_GS + te_kernel_lane(h * 32 + i)] = (int8_t)v;
+                    isum += v;
+                    res[i] = xb[i] - d * (float)v;
+                    rmax = fmaxf(rmax, fabsf(res[i]));
+                    exact += xb[i];
+                }
+                xqs[(size_t)m * (K / 32) + g * 2 + h] = d;
+                gs += d * (float)isum;
+                if (o2) {
+                    float d2 = rmax / 127.0f;
+                    float id2 = d2 > 0 ? 1.0f / d2 : 0.0f;
+                    for (int i = 0; i < 32; i++) {
+                        int v = (int)__builtin_rintf(res[i] * id2);
+                        v = v > 127 ? 127 : (v < -127 ? -127 : v);
+                        o2[g * TE_GS + te_kernel_lane(h * 32 + i)] = (int8_t)v;
+                    }
+                    xqs2[(size_t)m * (K / 32) + g * 2 + h] = d2;
+                }
+            }
+            // The bias term pairs with the activations the dots see: one plane is
+            // sum(d * q); two planes are close enough to x to use x itself.
+            xsum[(size_t)m * G + g] = o2 ? exact : gs;
+        }
+    }
+    out->M = M; out->K = K; out->xq = xq; out->xqs = xqs; out->xq2 = xq2; out->xqs2 = xq2 ? xqs2 : NULL;
+    out->xsum = xsum; out->xp = NULL;
+}
+
+// ------------------------------------------------------------------ scalar kernels
+
+static void qmm_f32_scalar(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int G = W->K / TE_GS, M = x->M, K = W->K;
+    float acc[TE_MAXM];
+    float qf[TE_GS];
+    uint8_t q[TE_GS];
+    for (int n = n0; n < n1; n++) {
+        const uint8_t* row = W->w + (size_t)n * W->row_bytes;
+        for (int m = 0; m < M; m++) acc[m] = 0;
+        for (int g = 0; g < G; g++) {
+            unpack64(row + (size_t)g * 48, q);
+            for (int i = 0; i < TE_GS; i++) qf[i] = q[i];
+            float s = te_bf16_to_f32(W->scales[(size_t)n * G + g]);
+            float b = te_bf16_to_f32(W->biases[(size_t)n * G + g]);
+            for (int m = 0; m < M; m++) {
+                const float* xg = x->xp + (size_t)m * K + g * TE_GS;
+                float d = 0;
+                for (int i = 0; i < TE_GS; i++) d += xg[i] * qf[i];
+                acc[m] += s * d + b * x->xsum[(size_t)m * G + g];
+            }
+        }
+        for (int m = 0; m < M; m++) Y[(size_t)m * ldy + n] = acc[m];
+    }
+}
+
+static void qmm_i8_scalar(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int G = W->K / TE_GS, M = x->M, K = W->K;
+    float acc[TE_MAXM];
+    uint8_t q[TE_GS];
+    for (int n = n0; n < n1; n++) {
+        const uint8_t* row = W->w + (size_t)n * W->row_bytes;
+        for (int m = 0; m < M; m++) acc[m] = 0;
+        for (int g = 0; g < G; g++) {
+            unpack64(row + (size_t)g * 48, q);
+            float s = te_bf16_to_f32(W->scales[(size_t)n * G + g]);
+            float b = te_bf16_to_f32(W->biases[(size_t)n * G + g]);
+            for (int m = 0; m < M; m++) {
+                const int8_t* xg = x->xq + (size_t)m * K + g * TE_GS;
+                int d0 = 0, d1 = 0;
+                for (int i = 0; i < 32; i++) d0 += xg[i] * q[i];
+                for (int i = 32; i < 64; i++) d1 += xg[i] * q[i];
+                const float* ds = x->xqs + (size_t)m * (K / 32) + g * 2;
+                float dot = ds[0] * (float)d0 + ds[1] * (float)d1;
+                if (x->xq2) {
+                    const int8_t* xg2 = x->xq2 + (size_t)m * K + g * TE_GS;
+                    int e0 = 0, e1 = 0;
+                    for (int i = 0; i < 32; i++) e0 += xg2[i] * q[i];
+                    for (int i = 32; i < 64; i++) e1 += xg2[i] * q[i];
+                    const float* ds2 = x->xqs2 + (size_t)m * (K / 32) + g * 2;
+                    dot += ds2[0] * (float)e0 + ds2[1] * (float)e1;
+                }
+                acc[m] += s * dot + b * x->xsum[(size_t)m * G + g];
+            }
+        }
+        for (int m = 0; m < M; m++) Y[(size_t)m * ldy + n] = acc[m];
+    }
+}
+
+// ------------------------------------------------------------------ AVX2 kernels
+#if TE_X86
+#define AVX2_FN __attribute__((target("avx2,fma,bmi2")))
+
+AVX2_FN static inline float hsum256(__m256 v) {
+    __m128 lo = _mm256_castps256_ps128(v), hi = _mm256_extractf128_ps(v, 1);
+    lo = _mm_add_ps(lo, hi);
+    lo = _mm_add_ps(lo, _mm_movehl_ps(lo, lo));
+    lo = _mm_add_ss(lo, _mm_movehdup_ps(lo));
+    return _mm_cvtss_f32(lo);
+}
+
+// 64 values -> 64 bytes (natural order) using PDEP: 12 bytes = 16 values.
+AVX2_FN static inline void unpack64_bmi2(const uint8_t* p, uint8_t* q) {
+    const uint64_t mask = 0x3F3F3F3F3F3F3F3Full;
+    for (int c = 0; c < 4; c++) {
+        uint64_t lo;
+        uint32_t hi;
+        memcpy(&lo, p + 12 * c, 8);
+        memcpy(&hi, p + 12 * c + 8, 4);
+        uint64_t a = _pdep_u64(lo, mask);
+        uint64_t b = _pdep_u64((lo >> 48) | ((uint64_t)hi << 16), mask);
+        memcpy(q + 16 * c, &a, 8);
+        memcpy(q + 16 * c + 8, &b, 8);
+    }
+}
+
+AVX2_FN static void qmm_f32_avx2(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int G = W->K / TE_GS, M = x->M, K = W->K;
+    __m256 acc[TE_MAXM];
+    float bacc[TE_MAXM];
+    uint8_t q[TE_GS];
+    __m256 qf[8];
+    for (int n = n0; n < n1; n++) {
+        const uint8_t* row = W->w + (size_t)n * W->row_bytes;
+        for (int m = 0; m < M; m++) { acc[m] = _mm256_setzero_ps(); bacc[m] = 0; }
+        for (int g = 0; g < G; g++) {
+            unpack64_bmi2(row + (size_t)g * 48, q);
+            for (int i = 0; i < 8; i++)
+                qf[i] = _mm256_cvtepi32_ps(_mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i*)(q + 8 * i))));
+            float s = te_bf16_to_f32(W->scales[(size_t)n * G + g]);
+            float b = te_bf16_to_f32(W->biases[(size_t)n * G + g]);
+            __m256 sv = _mm256_set1_ps(s);
+            for (int m = 0; m < M; m++) {
+                const float* xg = x->xp + (size_t)m * K + g * TE_GS;
+                __m256 d0 = _mm256_mul_ps(_mm256_loadu_ps(xg), qf[0]);
+                __m256 d1 = _mm256_mul_ps(_mm256_loadu_ps(xg + 8), qf[1]);
+                d0 = _mm256_fmadd_ps(_mm256_loadu_ps(xg + 16), qf[2], d0);
+                d1 = _mm256_fmadd_ps(_mm256_loadu_ps(xg + 24), qf[3], d1);
+                d0 = _mm256_fmadd_ps(_mm256_loadu_ps(xg + 32), qf[4], d0);
+                d1 = _mm256_fmadd_ps(_mm256_loadu_ps(xg + 40), qf[5], d1);
+                d0 = _mm256_fmadd_ps(_mm256_loadu_ps(xg + 48), qf[6], d0);
+                d1 = _mm256_fmadd_ps(_mm256_loadu_ps(xg + 56), qf[7], d1);
+                acc[m] = _mm256_fmadd_ps(_mm256_add_ps(d0, d1), sv, acc[m]);
+                bacc[m] += b * x->xsum[(size_t)m * G + g];
+            }
+        }
+        for (int m = 0; m < M; m++) Y[(size_t)m * ldy + n] = hsum256(acc[m]) + bacc[m];
+    }
+}
+
+// Four rows at a time: unpack the rows' 6-bit groups once into an L1 scratch,
+// then stream every token's activations past them with the four accumulators
+// in registers. Activation loads, block scales and loop overhead are shared by
+// the four rows; this is the prefill (M > 1) workhorse and serves M = 1 too.
+AVX2_FN static void qmm_i8_avx2_t4(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int K = W->K, G = K / TE_GS, M = x->M;
+    const int8_t* x2 = x->xq2;
+    const float* ds2 = x->xqs2;
+    _Alignas(32) uint8_t wq[4 * 2048];
+    float sw[4][32], bw[4][32];
+    const __m256i ones = _mm256_set1_epi16(1);
+    for (int n = n0; n < n1; n += 4) {
+        for (int r = 0; r < 4; r++) {
+            const uint8_t* row = W->w + (size_t)(n + r) * W->row_bytes;
+            for (int g = 0; g < G; g++) {
+                unpack64_bmi2(row + (size_t)g * 48, wq + r * K + g * TE_GS);
+                sw[r][g] = te_bf16_to_f32(W->scales[(size_t)(n + r) * G + g]);
+                bw[r][g] = te_bf16_to_f32(W->biases[(size_t)(n + r) * G + g]);
+            }
+        }
+        for (int m = 0; m < M; m++) {
+            const int8_t* xm = x->xq + (size_t)m * K;
+            const float* ds = x->xqs + (size_t)m * (K / 32);
+            const float* xs = x->xsum + (size_t)m * G;
+            __m256 a[4] = {_mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps(), _mm256_setzero_ps()};
+            float bs[4] = {0, 0, 0, 0};
+            for (int g = 0; g < G; g++) {
+                __m256i x0 = _mm256_loadu_si256((const __m256i*)(xm + g * TE_GS));
+                __m256i x1 = _mm256_loadu_si256((const __m256i*)(xm + g * TE_GS + 32));
+                __m256 d0 = _mm256_set1_ps(ds[2 * g]), d1 = _mm256_set1_ps(ds[2 * g + 1]);
+                __m256i y0 = x0, y1 = x1;
+                __m256 e0 = d0, e1 = d1;
+                if (x2) {
+                    y0 = _mm256_loadu_si256((const __m256i*)(x2 + (size_t)m * K + g * TE_GS));
+                    y1 = _mm256_loadu_si256((const __m256i*)(x2 + (size_t)m * K + g * TE_GS + 32));
+                    e0 = _mm256_set1_ps(ds2[(size_t)m * (K / 32) + 2 * g]);
+                    e1 = _mm256_set1_ps(ds2[(size_t)m * (K / 32) + 2 * g + 1]);
+                }
+                for (int r = 0; r < 4; r++) {
+                    const uint8_t* wg = wq + r * K + g * TE_GS;
+                    __m256i w0 = _mm256_load_si256((const __m256i*)wg), w1 = _mm256_load_si256((const __m256i*)(wg + 32));
+                    __m256i p0 = _mm256_madd_epi16(_mm256_maddubs_epi16(w0, x0), ones);
+                    __m256i p1 = _mm256_madd_epi16(_mm256_maddubs_epi16(w1, x1), ones);
+                    __m256 f = _mm256_fmadd_ps(_mm256_cvtepi32_ps(p1), d1, _mm256_mul_ps(_mm256_cvtepi32_ps(p0), d0));
+                    if (x2) {
+                        __m256i r0 = _mm256_madd_epi16(_mm256_maddubs_epi16(w0, y0), ones);
+                        __m256i r1 = _mm256_madd_epi16(_mm256_maddubs_epi16(w1, y1), ones);
+                        f = _mm256_fmadd_ps(_mm256_cvtepi32_ps(r0), e0, f);
+                        f = _mm256_fmadd_ps(_mm256_cvtepi32_ps(r1), e1, f);
+                    }
+                    a[r] = _mm256_fmadd_ps(f, _mm256_set1_ps(sw[r][g]), a[r]);
+                    bs[r] += bw[r][g] * xs[g];
+                }
+            }
+            for (int r = 0; r < 4; r++) Y[(size_t)m * ldy + n + r] = hsum256(a[r]) + bs[r];
+        }
+    }
+}
+#endif
+
+// ------------------------------------------------------------------ NEON kernels
+#if TE_NEON
+// De-interleaved unpack: v[r] lane j = element 4j+r of the group.
+static inline void unpack64_neon(const uint8_t* p, uint8x16_t v[4]) {
+    uint8x16x3_t b = vld3q_u8(p);
+    const uint8x16_t m63 = vdupq_n_u8(63), m15 = vdupq_n_u8(15), m3 = vdupq_n_u8(3);
+    v[0] = vandq_u8(b.val[0], m63);
+    v[1] = vorrq_u8(vshrq_n_u8(b.val[0], 6), vshlq_n_u8(vandq_u8(b.val[1], m15), 2));
+    v[2] = vorrq_u8(vshrq_n_u8(b.val[1], 4), vshlq_n_u8(vandq_u8(b.val[2], m3), 4));
+    v[3] = vshrq_n_u8(b.val[2], 2);
+}
+
+static void qmm_f32_neon(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int G = W->K / TE_GS, M = x->M, K = W->K;
+    float32x4_t acc[TE_MAXM];
+    float bacc[TE_MAXM];
+    float32x4_t qf[16];
+    uint8x16_t v[4];
+    for (int n = n0; n < n1; n++) {
+        const uint8_t* row = W->w + (size_t)n * W->row_bytes;
+        for (int m = 0; m < M; m++) { acc[m] = vdupq_n_f32(0); bacc[m] = 0; }
+        for (int g = 0; g < G; g++) {
+            unpack64_neon(row + (size_t)g * 48, v);
+            for (int r = 0; r < 4; r++) {
+                uint16x8_t lo = vmovl_u8(vget_low_u8(v[r])), hi = vmovl_u8(vget_high_u8(v[r]));
+                qf[4 * r + 0] = vcvtq_f32_u32(vmovl_u16(vget_low_u16(lo)));
+                qf[4 * r + 1] = vcvtq_f32_u32(vmovl_u16(vget_high_u16(lo)));
+                qf[4 * r + 2] = vcvtq_f32_u32(vmovl_u16(vget_low_u16(hi)));
+                qf[4 * r + 3] = vcvtq_f32_u32(vmovl_u16(vget_high_u16(hi)));
+            }
+            float s = te_bf16_to_f32(W->scales[(size_t)n * G + g]);
+            float b = te_bf16_to_f32(W->biases[(size_t)n * G + g]);
+            for (int m = 0; m < M; m++) {
+                const float* xg = x->xp + (size_t)m * K + g * TE_GS;
+                float32x4_t d0 = vmulq_f32(vld1q_f32(xg), qf[0]);
+                float32x4_t d1 = vmulq_f32(vld1q_f32(xg + 4), qf[1]);
+                float32x4_t d2 = vmulq_f32(vld1q_f32(xg + 8), qf[2]);
+                float32x4_t d3 = vmulq_f32(vld1q_f32(xg + 12), qf[3]);
+                for (int i = 4; i < 16; i += 4) {
+                    d0 = vfmaq_f32(d0, vld1q_f32(xg + 4 * i), qf[i]);
+                    d1 = vfmaq_f32(d1, vld1q_f32(xg + 4 * i + 4), qf[i + 1]);
+                    d2 = vfmaq_f32(d2, vld1q_f32(xg + 4 * i + 8), qf[i + 2]);
+                    d3 = vfmaq_f32(d3, vld1q_f32(xg + 4 * i + 12), qf[i + 3]);
+                }
+                acc[m] = vfmaq_n_f32(acc[m], vaddq_f32(vaddq_f32(d0, d1), vaddq_f32(d2, d3)), s);
+                bacc[m] += b * x->xsum[(size_t)m * G + g];
+            }
+        }
+        for (int m = 0; m < M; m++) Y[(size_t)m * ldy + n] = vaddvq_f32(acc[m]) + bacc[m];
+    }
+}
+
+// Lanes of the int32x4 result: {0,1} = block 0 (elements 0..31), {2,3} = block 1.
+#if defined(TE_SIMDE_NEON)
+#define DOTPROD_FN
+#elif defined(__clang__)
+#define DOTPROD_FN __attribute__((target("dotprod")))
+#else
+#define DOTPROD_FN __attribute__((target("+dotprod")))
+#endif
+
+// Four-row tiles, as qmm_i8_avx2_t4: the scratch holds each group de-interleaved
+// (v[0..3], 16 bytes each), which is the lane order the activations were prepared in.
+DOTPROD_FN static void qmm_i8_sdot_t4(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int K = W->K, G = K / TE_GS, M = x->M;
+    const int8_t* x2 = x->xq2;
+    const float* ds2 = x->xqs2;
+    _Alignas(16) int8_t wq[4 * 2048];
+    float sw[4][32], bw[4][32];
+    uint8x16_t v[4];
+    for (int n = n0; n < n1; n += 4) {
+        for (int r = 0; r < 4; r++) {
+            const uint8_t* row = W->w + (size_t)(n + r) * W->row_bytes;
+            for (int g = 0; g < G; g++) {
+                unpack64_neon(row + (size_t)g * 48, v);
+                for (int q = 0; q < 4; q++) vst1q_s8(wq + r * K + g * TE_GS + 16 * q, vreinterpretq_s8_u8(v[q]));
+                sw[r][g] = te_bf16_to_f32(W->scales[(size_t)(n + r) * G + g]);
+                bw[r][g] = te_bf16_to_f32(W->biases[(size_t)(n + r) * G + g]);
+            }
+        }
+        for (int m = 0; m < M; m++) {
+            const int8_t* xm = x->xq + (size_t)m * K;
+            const float* ds = x->xqs + (size_t)m * (K / 32);
+            const float* xs = x->xsum + (size_t)m * G;
+            float32x4_t a[4] = {vdupq_n_f32(0), vdupq_n_f32(0), vdupq_n_f32(0), vdupq_n_f32(0)};
+            float bs[4] = {0, 0, 0, 0};
+            for (int g = 0; g < G; g++) {
+                const int8_t* xg = xm + g * TE_GS;
+                int8x16_t x0 = vld1q_s8(xg), x1 = vld1q_s8(xg + 16), x2v = vld1q_s8(xg + 32), x3 = vld1q_s8(xg + 48);
+                float32x4_t dsv = vcombine_f32(vdup_n_f32(ds[2 * g]), vdup_n_f32(ds[2 * g + 1]));
+                int8x16_t y0 = x0, y1 = x1, y2 = x2v, y3 = x3;
+                float32x4_t esv = dsv;
+                if (x2) {
+                    const int8_t* xr = x2 + (size_t)m * K + g * TE_GS;
+                    const float* e = ds2 + (size_t)m * (K / 32) + 2 * g;
+                    y0 = vld1q_s8(xr); y1 = vld1q_s8(xr + 16); y2 = vld1q_s8(xr + 32); y3 = vld1q_s8(xr + 48);
+                    esv = vcombine_f32(vdup_n_f32(e[0]), vdup_n_f32(e[1]));
+                }
+                for (int r = 0; r < 4; r++) {
+                    const int8_t* wg = wq + r * K + g * TE_GS;
+                    int8x16_t w0 = vld1q_s8(wg), w1 = vld1q_s8(wg + 16), w2 = vld1q_s8(wg + 32), w3 = vld1q_s8(wg + 48);
+                    int32x4_t p = vdotq_s32(vdupq_n_s32(0), w0, x0);
+                    p = vdotq_s32(p, w1, x1);
+                    p = vdotq_s32(p, w2, x2v);
+                    p = vdotq_s32(p, w3, x3);
+                    float32x4_t f = vmulq_f32(vcvtq_f32_s32(p), dsv);
+                    if (x2) {
+                        int32x4_t pr = vdotq_s32(vdupq_n_s32(0), w0, y0);
+                        pr = vdotq_s32(pr, w1, y1);
+                        pr = vdotq_s32(pr, w2, y2);
+                        pr = vdotq_s32(pr, w3, y3);
+                        f = vfmaq_f32(f, vcvtq_f32_s32(pr), esv);
+                    }
+                    a[r] = vfmaq_n_f32(a[r], f, sw[r][g]);
+                    bs[r] += bw[r][g] * xs[g];
+                }
+            }
+            for (int r = 0; r < 4; r++) Y[(size_t)m * ldy + n + r] = vaddvq_f32(a[r]) + bs[r];
+        }
+    }
+}
+
+static void qmm_i8_neon_t4(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    int K = W->K, G = K / TE_GS, M = x->M;
+    const int8_t* x2 = x->xq2;
+    const float* ds2 = x->xqs2;
+    _Alignas(16) int8_t wq[4 * 2048];
+    float sw[4][32], bw[4][32];
+    uint8x16_t v[4];
+    for (int n = n0; n < n1; n += 4) {
+        for (int r = 0; r < 4; r++) {
+            const uint8_t* row = W->w + (size_t)(n + r) * W->row_bytes;
+            for (int g = 0; g < G; g++) {
+                unpack64_neon(row + (size_t)g * 48, v);
+                for (int q = 0; q < 4; q++) vst1q_s8(wq + r * K + g * TE_GS + 16 * q, vreinterpretq_s8_u8(v[q]));
+                sw[r][g] = te_bf16_to_f32(W->scales[(size_t)(n + r) * G + g]);
+                bw[r][g] = te_bf16_to_f32(W->biases[(size_t)(n + r) * G + g]);
+            }
+        }
+        for (int m = 0; m < M; m++) {
+            const int8_t* xm = x->xq + (size_t)m * K;
+            const float* ds = x->xqs + (size_t)m * (K / 32);
+            const float* xs = x->xsum + (size_t)m * G;
+            float32x4_t a[4] = {vdupq_n_f32(0), vdupq_n_f32(0), vdupq_n_f32(0), vdupq_n_f32(0)};
+            float bs[4] = {0, 0, 0, 0};
+            for (int g = 0; g < G; g++) {
+                const int8_t* xg = xm + g * TE_GS;
+                int8x16_t xv[4] = {vld1q_s8(xg), vld1q_s8(xg + 16), vld1q_s8(xg + 32), vld1q_s8(xg + 48)};
+                for (int r = 0; r < 4; r++) {
+                    const int8_t* wg = wq + r * K + g * TE_GS;
+                    int32x4_t a0 = vdupq_n_s32(0), a1 = vdupq_n_s32(0);
+                    for (int q = 0; q < 4; q++) {
+                        int8x16_t w = vld1q_s8(wg + 16 * q);
+                        a0 = vpadalq_s16(a0, vmull_s8(vget_low_s8(w), vget_low_s8(xv[q])));
+                        a1 = vpadalq_s16(a1, vmull_s8(vget_high_s8(w), vget_high_s8(xv[q])));
+                    }
+                    float32x4_t f = vmulq_n_f32(vcvtq_f32_s32(a0), ds[2 * g]);
+                    f = vfmaq_n_f32(f, vcvtq_f32_s32(a1), ds[2 * g + 1]);
+                    if (x2) {
+                        const int8_t* xr = x2 + (size_t)m * K + g * TE_GS;
+                        const float* e = ds2 + (size_t)m * (K / 32) + 2 * g;
+                        int32x4_t b0 = vdupq_n_s32(0), b1 = vdupq_n_s32(0);
+                        for (int q = 0; q < 4; q++) {
+                            int8x16_t w = vld1q_s8(wg + 16 * q), y = vld1q_s8(xr + 16 * q);
+                            b0 = vpadalq_s16(b0, vmull_s8(vget_low_s8(w), vget_low_s8(y)));
+                            b1 = vpadalq_s16(b1, vmull_s8(vget_high_s8(w), vget_high_s8(y)));
+                        }
+                        f = vfmaq_n_f32(f, vcvtq_f32_s32(b0), e[0]);
+                        f = vfmaq_n_f32(f, vcvtq_f32_s32(b1), e[1]);
+                    }
+                    a[r] = vfmaq_n_f32(a[r], f, sw[r][g]);
+                    bs[r] += bw[r][g] * xs[g];
+                }
+            }
+            for (int r = 0; r < 4; r++) Y[(size_t)m * ldy + n + r] = vaddvq_f32(a[r]) + bs[r];
+        }
+    }
+}
+#endif
+
+// ------------------------------------------------------------------ dispatch
+
+void te_qmm_f32(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+#if TE_NEON
+    qmm_f32_neon(W, x, Y, ldy, n0, n1);
+#elif TE_X86
+    if (have_avx2()) qmm_f32_avx2(W, x, Y, ldy, n0, n1);
+    else qmm_f32_scalar(W, x, Y, ldy, n0, n1);
+#else
+    qmm_f32_scalar(W, x, Y, ldy, n0, n1);
+#endif
+}
+
+void te_qmm_i8(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1) {
+    // Tiles need whole 4-row blocks and K <= 2048 (the scratch); every matrix here has both.
+    int tiled = (n0 % 4) == 0 && (n1 - n0) % 4 == 0 && W->K <= 2048;
+#if TE_NEON
+    if (!tiled) qmm_i8_scalar(W, x, Y, ldy, n0, n1);
+    else if (have_dotprod()) qmm_i8_sdot_t4(W, x, Y, ldy, n0, n1);
+    else qmm_i8_neon_t4(W, x, Y, ldy, n0, n1);
+    (void)qmm_f32_scalar;
+#elif TE_X86
+    if (have_avx2() && tiled) qmm_i8_avx2_t4(W, x, Y, ldy, n0, n1);
+    else qmm_i8_scalar(W, x, Y, ldy, n0, n1);
+#else
+    qmm_i8_scalar(W, x, Y, ldy, n0, n1);
+#endif
+}
+#else
+typedef int te_unavailable_te_kernels;
+#endif
