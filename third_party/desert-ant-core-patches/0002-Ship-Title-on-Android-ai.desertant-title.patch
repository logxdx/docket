+void te_pool_run(te_pool* p, int n, int grain, te_range_fn fn, void* ctx);
diff --git a/Sources/CTitleEngine/te_tokenizer.c b/Sources/CTitleEngine/te_tokenizer.c
new file mode 100644
index 0000000..14a1d8e
--- /dev/null
+++ b/Sources/CTitleEngine/te_tokenizer.c
@@ -0,0 +1,544 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include "te_tokenizer.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "te_json.h"
+#include "te_util.h"
+#include "unicode_tables.h"
+
+// ---------------------------------------------------------------- unicode
+
+static int in_ranges(const uint32_t (*r)[2], size_t n, uint32_t cp) {
+    size_t lo = 0, hi = n;
+    while (lo < hi) {
+        size_t mid = (lo + hi) / 2;
+        if (cp < r[mid][0]) hi = mid;
+        else if (cp > r[mid][1]) lo = mid + 1;
+        else return 1;
+    }
+    return 0;
+}
+
+#define NELEM(a) (sizeof(a) / sizeof((a)[0]))
+
+enum { CC_OTHER = 0, CC_LETTER = 1, CC_NUMBER = 2, CC_SPACE = 4 };
+
+static int char_class(uint32_t cp) {
+    if (cp < 128) {
+        if ((cp >= 'a' && cp <= 'z') || (cp >= 'A' && cp <= 'Z')) return CC_LETTER;
+        if (cp >= '0' && cp <= '9') return CC_NUMBER;
+        if (cp == ' ' || (cp >= 9 && cp <= 13)) return CC_SPACE;
+        return CC_OTHER;
+    }
+    if (in_ranges(TE_UNI_LETTER, NELEM(TE_UNI_LETTER), cp)) return CC_LETTER;
+    if (in_ranges(TE_UNI_NUMBER, NELEM(TE_UNI_NUMBER), cp)) return CC_NUMBER;
+    if (in_ranges(TE_UNI_SPACE, NELEM(TE_UNI_SPACE), cp)) return CC_SPACE;
+    return CC_OTHER;
+}
+
+// Decodes one UTF-8 codepoint. Invalid bytes decode as themselves (U+FFFD
+// class "other") and consume one byte, mirroring lossless byte handling.
+static uint32_t utf8_next(const unsigned char* s, size_t len, size_t* adv) {
+    unsigned char c = s[0];
+    if (c < 0x80) { *adv = 1; return c; }
+    int n = (c >= 0xF0 && c < 0xF8) ? 4 : (c >= 0xE0) ? 3 : (c >= 0xC0) ? 2 : 0;
+    if (n == 0 || (size_t)n > len) { *adv = 1; return 0xFFFD; }
+    uint32_t cp = c & (0x7F >> n);
+    for (int i = 1; i < n; i++) {
+        if ((s[i] & 0xC0) != 0x80) { *adv = 1; return 0xFFFD; }
+        cp = (cp << 6) | (s[i] & 0x3F);
+    }
+    *adv = (size_t)n;
+    return cp;
+}
+
+// ---------------------------------------------------------------- tables
+
+typedef struct {
+    uint64_t key;   // (left << 32) | right, or 0 for empty (ids are never both 0 with a valid merge? guard via used flag)
+    int32_t rank;
+    int32_t merged;
+    int used;
+} merge_slot;
+
+typedef struct {
+    uint32_t off, len;  // into blob
+    int32_t id;
+    int used;
+} vocab_slot;
+
+typedef struct {
+    char* content;
+    size_t len;
+    int32_t id;
+} added_token;
+
+struct te_tokenizer {
+    char* blob;              // raw bytes of every vocab entry
+    size_t blob_len;
+    uint32_t* tok_off;       // per id
+    uint32_t* tok_len;
+    int32_t n_vocab;         // max id + 1
+    vocab_slot* vslots;
+    size_t vcap;
+    merge_slot* mslots;
+    size_t mcap;
+    int32_t byte_id[256];
+    added_token* added;
+    size_t n_added;
+};
+
+static uint64_t fnv(const void* p, size_t n) {
+    const unsigned char* s = (const unsigned char*)p;
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; i++) { h ^= s[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+static uint64_t mix64(uint64_t x) {
+    x ^= x >> 33; x *= 0xff51afd7ed558ccdull; x ^= x >> 33; x *= 0xc4ceb9fe1a85ec53ull; x ^= x >> 33;
+    return x;
+}
+
+static int32_t vocab_find(const te_tokenizer* t, const char* s, size_t n) {
+    size_t mask = t->vcap - 1;
+    for (size_t i = fnv(s, n) & mask;; i = (i + 1) & mask) {
+        const vocab_slot* v = &t->vslots[i];
+        if (!v->used) return -1;
+        if (v->len == n && !memcmp(t->blob + v->off, s, n)) return v->id;
+    }
+}
+
+static void vocab_insert(te_tokenizer* t, uint32_t off, uint32_t len, int32_t id) {
+    size_t mask = t->vcap - 1;
+    for (size_t i = fnv(t->blob + off, len) & mask;; i = (i + 1) & mask) {
+        vocab_slot* v = &t->vslots[i];
+        if (!v->used) { v->used = 1; v->off = off; v->len = len; v->id = id; return; }
+        if (v->len == len && !memcmp(t->blob + v->off, t->blob + off, len)) return;  // keep first
+    }
+}
+
+static const merge_slot* merge_find(const te_tokenizer* t, int32_t a, int32_t b) {
+    uint64_t key = ((uint64_t)(uint32_t)a << 32) | (uint32_t)b;
+    size_t mask = t->mcap - 1;
+    for (size_t i = mix64(key) & mask;; i = (i + 1) & mask) {
+        const merge_slot* m = &t->mslots[i];
+        if (!m->used) return NULL;
+        if (m->key == key) return m;
+    }
+}
+
+static void merge_insert(te_tokenizer* t, int32_t a, int32_t b, int32_t rank, int32_t merged) {
+    uint64_t key = ((uint64_t)(uint32_t)a << 32) | (uint32_t)b;
+    size_t mask = t->mcap - 1;
+    for (size_t i = mix64(key) & mask;; i = (i + 1) & mask) {
+        merge_slot* m = &t->mslots[i];
+        if (!m->used) { m->used = 1; m->key = key; m->rank = rank; m->merged = merged; return; }
+        if (m->key == key) return;  // first (lowest rank) wins
+    }
+}
+
+// GPT-2 bytes_to_unicode inverse: codepoint -> byte, or -1.
+static int byte_of_cp[324];
+
+static void init_byte_map(void) {
+    int n = 0;
+    for (int i = 0; i < 324; i++) byte_of_cp[i] = -1;
+    for (int b = 0; b < 256; b++) {
+        int printable = (b >= 33 && b <= 126) || (b >= 161 && b <= 172) || (b >= 174 && b <= 255);
+        if (printable) byte_of_cp[b] = b;
+        else byte_of_cp[256 + n++] = b;
+    }
+}
+
+// Converts a byte-level vocab string to raw bytes. Returns length or -1.
+static long bytelevel_to_raw(const char* s, size_t n, char* out) {
+    size_t i = 0;
+    long o = 0;
+    while (i < n) {
+        size_t adv;
+        uint32_t cp = utf8_next((const unsigned char*)s + i, n - i, &adv);
+        if (cp >= 324 || byte_of_cp[cp] < 0) return -1;
+        out[o++] = (char)byte_of_cp[cp];
+        i += adv;
+    }
+    return o;
+}
+
+static size_t pow2_at_least(size_t n) {
+    size_t c = 1;
+    while (c < n) c <<= 1;
+    return c;
+}
+
+void te_tok_free(te_tokenizer* t) {
+    if (!t) return;
+    free(t->blob);
+    free(t->tok_off);
+    free(t->tok_len);
+    free(t->vslots);
+    free(t->mslots);
+    for (size_t i = 0; i < t->n_added; i++) free(t->added[i].content);
+    free(t->added);
+    free(t);
+}
+
+static int split_merge(const tj_value* m, const char** a, size_t* al, const char** b, size_t* bl) {
+    if (m->type == TJ_ARR && m->len == 2 && m->items[0].type == TJ_STR && m->items[1].type == TJ_STR) {
+        *a = m->items[0].str; *al = m->items[0].len;
+        *b = m->items[1].str; *bl = m->items[1].len;
+        return 0;
+    }
+    if (m->type == TJ_STR) {  // legacy "a b" form
+        const char* sp = memchr(m->str, ' ', m->len);
+        if (!sp) return -1;
+        *a = m->str; *al = (size_t)(sp - m->str);
+        *b = sp + 1; *bl = m->len - *al - 1;
+        return 0;
+    }
+    return -1;
+}
+
+te_tokenizer* te_tok_load(const char* path, char* err, size_t errlen) {
+    init_byte_map();
+    size_t flen;
+    char* text = te_read_file(path, &flen);
+    if (!text) { snprintf(err, errlen, "cannot read %s", path); return NULL; }
+    tj_doc* doc = te_json_parse(text, flen, err, errlen);
+    free(text);
+    if (!doc) return NULL;
+    const tj_value* root = te_json_root(doc);
+    const tj_value* model = tj_get(root, "model");
+    const tj_value* vocab = tj_get(model, "vocab");
+    const tj_value* merges = tj_get(model, "merges");
+    const char* mtype = tj_str(tj_get(model, "type"));
+    te_tokenizer* t = NULL;
+    if (!vocab || vocab->type != TJ_OBJ || !merges || merges->type != TJ_ARR || !mtype || strcmp(mtype, "BPE")) {
+        snprintf(err, errlen, "tokenizer.json: expected a BPE model with vocab and merges");
+        goto fail;
+    }
+    // Pre-tokenizer sanity: this implementation hard-codes the cl100k split
+    // regex + ByteLevel(use_regex=false); refuse anything else.
+    {
+        const tj_value* pre = tj_get(root, "pre_tokenizer");
+        const tj_value* list = tj_get(pre, "pretokenizers");
+        const char* want = "(?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\\r\\n\\p{L}\\p{N}]?\\p{L}+|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+";
+        int ok = list && list->type == TJ_ARR && list->len == 2;
+        if (ok) {
+            const char* re = tj_str(tj_get(tj_get(&list->items[0], "pattern"), "Regex"));
+            const char* bl = tj_str(tj_get(&list->items[1], "type"));
+            ok = re && !strcmp(re, want) && bl && !strcmp(bl, "ByteLevel") &&
+                 tj_num(tj_get(&list->items[1], "use_regex"), 1) == 0 &&
+                 tj_num(tj_get(&list->items[1], "add_prefix_space"), 1) == 0;
+        }
+        if (!ok || tj_get(root, "normalizer")->type != TJ_NULL) {
+            snprintf(err, errlen, "tokenizer.json: unsupported pre-tokenizer/normalizer");
+            goto fail;
+        }
+    }
+    t = (te_tokenizer*)calloc(1, sizeof(*t));
+    if (!t) goto oom;
+    size_t blob_cap = 0;
+    for (size_t i = 0; i < vocab->len; i++) blob_cap += vocab->key_lens[i];
+    const tj_value* added = tj_get(root, "added_tokens");
+    int32_t max_id = -1;
+    for (size_t i = 0; i < vocab->len; i++)
+        if ((int32_t)vocab->items[i].num > max_id) max_id = (int32_t)vocab->items[i].num;
+    if (added && added->type == TJ_ARR)
+        for (size_t i = 0; i < added->len; i++) {
+            int32_t id = (int32_t)tj_num(tj_get(&added->items[i], "id"), -1);
+            if (id > max_id) max_id = id;
+            const char* c = tj_str(tj_get(&added->items[i], "content"));
+            if (c) blob_cap += strlen(c);
+        }
+    t->n_vocab = max_id + 1;
+    t->blob = (char*)malloc(blob_cap + 1);
+    t->tok_off = (uint32_t*)calloc((size_t)t->n_vocab, sizeof(uint32_t));
+    t->tok_len = (uint32_t*)calloc((size_t)t->n_vocab, sizeof(uint32_t));
+    t->vcap = pow2_at_least((size_t)t->n_vocab * 2 + 16);
+    t->vslots = (vocab_slot*)calloc(t->vcap, sizeof(vocab_slot));
+    if (!t->blob || !t->tok_off || !t->tok_len || !t->vslots) goto oom;
+    for (int i = 0; i < 256; i++) t->byte_id[i] = -1;
+    for (size_t i = 0; i < vocab->len; i++) {
+        int32_t id = (int32_t)vocab->items[i].num;
+        long n = bytelevel_to_raw(vocab->keys[i], vocab->key_lens[i], t->blob + t->blob_len);
+        if (n < 0) {
+            // Not byte-level text (e.g. a special token stored verbatim): keep as is.
+            memcpy(t->blob + t->blob_len, vocab->keys[i], vocab->key_lens[i]);
+            n = (long)vocab->key_lens[i];
+        }
+        t->tok_off[id] = (uint32_t)t->blob_len;
+        t->tok_len[id] = (uint32_t)n;
+        vocab_insert(t, (uint32_t)t->blob_len, (uint32_t)n, id);
+        if (n == 1 && t->byte_id[(unsigned char)t->blob[t->blob_len]] < 0)
+            t->byte_id[(unsigned char)t->blob[t->blob_len]] = id;
+        t->blob_len += (size_t)n;
+    }
+    for (int i = 0; i < 256; i++)
+        if (t->byte_id[i] < 0) { snprintf(err, errlen, "tokenizer.json: byte %d has no token", i); goto fail; }
+    if (added && added->type == TJ_ARR) {
+        t->added = (added_token*)calloc(added->len, sizeof(added_token));
+        if (!t->added) goto oom;
+        for (size_t i = 0; i < added->len; i++) {
+            const tj_value* a = &added->items[i];
+            const char* c = tj_str(tj_get(a, "content"));
+            int32_t id = (int32_t)tj_num(tj_get(a, "id"), -1);
+            if (!c || id < 0) continue;
+            size_t n = strlen(c);
+            added_token* at = &t->added[t->n_added++];
+            at->content = te_strndup(c, n);
+            at->len = n;
+            at->id = id;
+            memcpy(t->blob + t->blob_len, c, n);
+            t->tok_off[id] = (uint32_t)t->blob_len;
+            t->tok_len[id] = (uint32_t)n;
+            t->blob_len += n;
+        }
+    }
+    t->mcap = pow2_at_least(merges->len * 2 + 16);
+    t->mslots = (merge_slot*)calloc(t->mcap, sizeof(merge_slot));
+    if (!t->mslots) goto oom;
+    {
+        char* tmp = (char*)malloc(4096);
+        if (!tmp) goto oom;
+        for (size_t r = 0; r < merges->len; r++) {
+            const char *a, *b;
+            size_t al, bl;
+            if (split_merge(&merges->items[r], &a, &al, &b, &bl) || al + bl > 2048) {
+                free(tmp);
+                snprintf(err, errlen, "tokenizer.json: bad merge %zu", r);
+                goto fail;
+            }
+            long ra = bytelevel_to_raw(a, al, tmp);
+            long rb = ra < 0 ? -1 : bytelevel_to_raw(b, bl, tmp + ra);
+            if (rb < 0) { free(tmp); snprintf(err, errlen, "tokenizer.json: bad merge %zu", r); goto fail; }
+            int32_t ia = vocab_find(t, tmp, (size_t)ra);
+            int32_t ib = vocab_find(t, tmp + ra, (size_t)rb);
+            int32_t im = vocab_find(t, tmp, (size_t)(ra + rb));
+            if (ia < 0 || ib < 0 || im < 0) continue;  // unreachable merge
+            merge_insert(t, ia, ib, (int32_t)r, im);
+        }
+        free(tmp);
+    }
+    te_json_free(doc);
+    return t;
+oom:
+    snprintf(err, errlen, "out of memory");
+fail:
+    te_tok_free(t);
+    te_json_free(doc);
+    return NULL;
+}
+
+int32_t te_tok_vocab_size(const te_tokenizer* t) { return t->n_vocab; }
+
+int32_t te_tok_lookup(const te_tokenizer* t, const char* s) {
+    size_t n = strlen(s);
+    for (size_t i = 0; i < t->n_added; i++)
+        if (t->added[i].len == n && !memcmp(t->added[i].content, s, n)) return t->added[i].id;
+    return vocab_find(t, s, n);
+}
+
+size_t te_tok_decode_append(const te_tokenizer* t, int32_t id, char** buf, size_t len, size_t* cap) {
+    if (id < 0 || id >= t->n_vocab) return len;
+    size_t n = t->tok_len[id];
+    if (len + n + 1 > *cap) {
+        size_t c = (*cap ? *cap : 64);
+        while (c < len + n + 1) c *= 2;
+        char* nb = (char*)realloc(*buf, c);
+        if (!nb) return len;
+        *buf = nb;
+        *cap = c;
+    }
+    memcpy(*buf + len, t->blob + t->tok_off[id], n);
+    len += n;
+    (*buf)[len] = 0;
+    return len;
+}
+
+// ---------------------------------------------------------------- encode
+
+static int push_tok(te_tokens* v, int32_t id, uint32_t end) {
+    if (v->n == v->cap) {
+        size_t c = v->cap ? v->cap * 2 : 256;
+        int32_t* ni = (int32_t*)realloc(v->ids, c * sizeof(int32_t));
+        if (!ni) return -1;
+        v->ids = ni;
+        uint32_t* ne = (uint32_t*)realloc(v->chunk_end, c * sizeof(uint32_t));
+        if (!ne) return -1;
+        v->chunk_end = ne;
+        v->cap = c;
+    }
+    v->ids[v->n] = id;
+    v->chunk_end[v->n] = end;
+    v->n++;
+    return 0;
+}
+
+void te_tokens_free(te_tokens* v) {
+    free(v->ids);
+    free(v->chunk_end);
+    memset(v, 0, sizeof(*v));
+}
+
+// BPE over one pre-token (raw bytes). Lowest merge rank first, leftmost on ties,
+// which is what the HF BPE model does.
+static int bpe_chunk(const te_tokenizer* t, const unsigned char* s, size_t n, uint32_t end, te_tokens* out) {
+    // Whole chunk in vocab and no merges needed is NOT a shortcut HF takes with
+    // ignore_merges=false, so always run the merge loop.
+    int32_t stack_ids[256], stack_rank[256], stack_merged[256];
+    int32_t *ids = stack_ids, *rank = stack_rank, *merged = stack_merged;
+    if (n > 256) {
+        ids = (int32_t*)malloc(n * 3 * sizeof(int32_t));
+        if (!ids) return -1;
+        rank = ids + n;
+        merged = rank + n;
+    }
+    size_t m = n;
+    for (size_t i = 0; i < n; i++) ids[i] = t->byte_id[s[i]];
+    for (size_t i = 0; i + 1 < m; i++) {
+        const merge_slot* ms = merge_find(t, ids[i], ids[i + 1]);
+        rank[i] = ms ? ms->rank : INT32_MAX;
+        merged[i] = ms ? ms->merged : -1;
+    }
+    while (m > 1) {
+        size_t best = 0;
+        int32_t br = INT32_MAX;
+        for (size_t i = 0; i + 1 < m; i++)
+            if (rank[i] < br) { br = rank[i]; best = i; }
+        if (br == INT32_MAX) break;
+        ids[best] = merged[best];
+        memmove(ids + best + 1, ids + best + 2, (m - best - 2) * sizeof(int32_t));
+        memmove(rank + best + 1, rank + best + 2, (m - best - 2) * sizeof(int32_t));
+        memmove(merged + best + 1, merged + best + 2, (m - best - 2) * sizeof(int32_t));
+        m--;
+        for (size_t j = best ? best - 1 : 0; j <= best && j + 1 < m; j++) {
+            const merge_slot* ms = merge_find(t, ids[j], ids[j + 1]);
+            rank[j] = ms ? ms->rank : INT32_MAX;
+            merged[j] = ms ? ms->merged : -1;
+        }
+    }
+    int rc = 0;
+    for (size_t i = 0; i < m && !rc; i++) rc = push_tok(out, ids[i], end);
+    if (ids != stack_ids) free(ids);
+    return rc;
+}
+
+typedef struct {
+    uint32_t cp;
+    uint32_t off;  // byte offset of this codepoint
+    int cls;
+} cpinfo;
+
+static int is_nl(uint32_t c) { return c == '\r' || c == '\n'; }
+
+// Length (in codepoints) of the cl100k regex match starting at i, never 0.
+//   (?i:'s|'t|'re|'ve|'m|'ll|'d)|[^\r\n\p{L}\p{N}]?\p{L}+|\p{N}{1,3}|
+//    ?[^\s\p{L}\p{N}]+[\r\n]*|\s*[\r\n]+|\s+(?!\S)|\s+
+static size_t match_at(const cpinfo* c, size_t i, size_t n) {
+    // 1. contractions
+    if (c[i].cp == '\'' && i + 1 < n) {
+        uint32_t a = c[i + 1].cp | 0x20, b = i + 2 < n ? (c[i + 2].cp | 0x20) : 0;
+        if (c[i + 1].cp < 128) {
+            if (a == 's' || a == 't' || a == 'm' || a == 'd') return 2;
+            if ((a == 'r' && b == 'e') || (a == 'v' && b == 'e') || (a == 'l' && b == 'l')) return 3;
+        }
+    }
+    // 2. [^\r\n\p{L}\p{N}]?\p{L}+
+    {
+        size_t j = i;
+        if (!(c[j].cls & (CC_LETTER | CC_NUMBER)) && !is_nl(c[j].cp) && j + 1 < n && (c[j + 1].cls & CC_LETTER)) j++;
+        if (c[j].cls & CC_LETTER) {
+            while (j < n && (c[j].cls & CC_LETTER)) j++;
+            return j - i;
+        }
+    }
+    // 3. \p{N}{1,3}
+    if (c[i].cls & CC_NUMBER) {
+        size_t j = i;
+        while (j < n && j - i < 3 && (c[j].cls & CC_NUMBER)) j++;
+        return j - i;
+    }
+    // 4.  ?[^\s\p{L}\p{N}]+[\r\n]*
+    {
+        size_t j = i;
+        if (c[j].cp == ' ' && j + 1 < n && c[j + 1].cls == CC_OTHER) j++;
+        if (c[j].cls == CC_OTHER) {
+            while (j < n && c[j].cls == CC_OTHER) j++;
+            while (j < n && is_nl(c[j].cp)) j++;
+            return j - i;
+        }
+    }
+    // Remaining alternatives all start with whitespace.
+    if (c[i].cls & CC_SPACE) {
+        size_t j = i;
+        while (j < n && (c[j].cls & CC_SPACE)) j++;
+        // 5. \s*[\r\n]+ : ends just after the last newline in the run
+        for (size_t k = j; k > i; k--)
+            if (is_nl(c[k - 1].cp)) return k - i;
+        // 6. \s+(?!\S)
+        if (j == n) return j - i;
+        if (j - i >= 2) return j - 1 - i;
+        // 7. \s+
+        return j - i;
+    }
+    return 1;  // unreachable: every codepoint is L, N, \s or other
+}
+
+static int encode_plain(const te_tokenizer* t, const char* text, size_t base, size_t len, te_tokens* out) {
+    if (len == 0) return 0;
+    cpinfo* c = (cpinfo*)malloc((len + 1) * sizeof(cpinfo));
+    if (!c) return -1;
+    size_t n = 0;
+    for (size_t i = 0; i < len;) {
+        size_t adv;
+        uint32_t cp = utf8_next((const unsigned char*)text + i, len - i, &adv);
+        c[n].cp = cp;
+        c[n].off = (uint32_t)i;
+        c[n].cls = char_class(cp);
+        n++;
+        i += adv;
+    }
+    int rc = 0;
+    for (size_t i = 0; i < n && !rc;) {
+        size_t k = match_at(c, i, n);
+        size_t b0 = c[i].off, b1 = i + k < n ? c[i + k].off : len;
+        rc = bpe_chunk(t, (const unsigned char*)text + b0, b1 - b0, (uint32_t)(base + b1), out);
+        i += k;
+    }
+    free(c);
+    return rc;
+}
+
+int te_tok_encode(const te_tokenizer* t, const char* text, size_t len, te_tokens* out) {
+    size_t start = 0, i = 0;
+    while (i < len) {
+        // Leftmost-longest added-token match at i.
+        size_t best_len = 0;
+        int32_t best_id = -1;
+        for (size_t a = 0; a < t->n_added; a++) {
+            const added_token* at = &t->added[a];
+            if (at->len > best_len && at->len <= len - i && text[i] == at->content[0] &&
+                !memcmp(text + i, at->content, at->len)) {
+                best_len = at->len;
+                best_id = at->id;
+            }
+        }
+        if (best_id >= 0) {
+            if (encode_plain(t, text + start, start, i - start, out)) return -1;
+            if (push_tok(out, best_id, (uint32_t)(i + best_len))) return -1;
+            i += best_len;
+            start = i;
+        } else {
+            i++;
+        }
+    }
+    return encode_plain(t, text + start, start, len - start, out);
+}
+#else
+typedef int te_unavailable_te_tokenizer;
+#endif
diff --git a/Sources/CTitleEngine/te_tokenizer.h b/Sources/CTitleEngine/te_tokenizer.h
new file mode 100644
index 0000000..467f89d
--- /dev/null
+++ b/Sources/CTitleEngine/te_tokenizer.h
@@ -0,0 +1,28 @@
+// Byte-level BPE driven by a Hugging Face tokenizer.json (the GPT-4/cl100k
+// pre-tokenizer family that Granite uses), with added-token splitting.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct te_tokenizer te_tokenizer;
+
+typedef struct {
+    int32_t* ids;
+    uint32_t* chunk_end;  // per token: byte offset (into the input) where its pre-token ends
+    size_t n, cap;
+} te_tokens;
+
+te_tokenizer* te_tok_load(const char* tokenizer_json_path, char* err, size_t errlen);
+void te_tok_free(te_tokenizer* t);
+
+// Appends the encoding of text[0..len) to out. Returns 0 on success.
+int te_tok_encode(const te_tokenizer* t, const char* text, size_t len, te_tokens* out);
+void te_tokens_free(te_tokens* v);
+
+// Id of an exact token string (added tokens first, then vocab), or -1.
+int32_t te_tok_lookup(const te_tokenizer* t, const char* s);
+
+// Appends the bytes of one token to buf (grows it). Returns new length.
+size_t te_tok_decode_append(const te_tokenizer* t, int32_t id, char** buf, size_t len, size_t* cap);
+
+int32_t te_tok_vocab_size(const te_tokenizer* t);
diff --git a/Sources/CTitleEngine/te_util.c b/Sources/CTitleEngine/te_util.c
new file mode 100644
index 0000000..8381fbc
--- /dev/null
+++ b/Sources/CTitleEngine/te_util.c
@@ -0,0 +1,40 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include "te_util.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+char* te_read_file(const char* path, size_t* len) {
+    FILE* f = fopen(path, "rb");
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END)) { fclose(f); return NULL; }
+    long n = ftell(f);
+    if (n < 0) { fclose(f); return NULL; }
+    rewind(f);
+    char* buf = (char*)malloc((size_t)n + 1);
+    if (!buf) { fclose(f); return NULL; }
+    if (fread(buf, 1, (size_t)n, f) != (size_t)n) { free(buf); fclose(f); return NULL; }
+    fclose(f);
+    buf[n] = 0;
+    if (len) *len = (size_t)n;
+    return buf;
+}
+
+char* te_strndup(const char* s, size_t n) {
+    char* d = (char*)malloc(n + 1);
+    if (!d) return NULL;
+    memcpy(d, s, n);
+    d[n] = 0;
+    return d;
+}
+
+double te_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+#else
+typedef int te_unavailable_te_util;
+#endif
diff --git a/Sources/CTitleEngine/te_util.h b/Sources/CTitleEngine/te_util.h
new file mode 100644
index 0000000..4267a72
--- /dev/null
+++ b/Sources/CTitleEngine/te_util.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+char* te_read_file(const char* path, size_t* len);  // malloc'd, NUL-terminated
+char* te_strndup(const char* s, size_t n);
+double te_now(void);                               // seconds, monotonic
+
+// bf16 <-> f32. Rounding is round-to-nearest-even with NaN preserved, exactly
+// what MLX's _MLX_BFloat16(float) constructor does.
+static inline float te_bf16_to_f32(uint16_t h) {
+    uint32_t u = (uint32_t)h << 16;
+    float f;
+    memcpy(&f, &u, 4);
+    return f;
+}
+
+static inline uint16_t te_f32_to_bf16(float f) {
+    uint32_t u;
+    memcpy(&u, &f, 4);
+    if ((u & 0x7FFFFFFFu) > 0x7F800000u) return 0x7FC0;
+    u += ((u >> 16) & 1) + 0x7FFFu;
+    return (uint16_t)(u >> 16);
+}
+
+// Round a float to the nearest bf16 value, kept as float.
+static inline float te_round_bf16(float f) { return te_bf16_to_f32(te_f32_to_bf16(f)); }
diff --git a/Sources/CTitleEngine/te_vec.h b/Sources/CTitleEngine/te_vec.h
new file mode 100644
index 0000000..46030ba
--- /dev/null
+++ b/Sources/CTitleEngine/te_vec.h
@@ -0,0 +1,74 @@
+// 4-wide float helpers on GCC/Clang vector extensions: NEON on arm64, SSE on
+// x86, no intrinsics. Used for the non-matmul hot loops (attention, softmax,
+// norms) so they vectorize at the -Os SwiftPM builds C targets with, where the
+// loop vectorizer will not reorder a float reduction on its own.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+typedef float te_v4f __attribute__((vector_size(16)));
+typedef int32_t te_v4i __attribute__((vector_size(16)));
+typedef uint32_t te_v4u __attribute__((vector_size(16)));
+typedef uint16_t te_v4h __attribute__((vector_size(8)));
+
+static inline te_v4f te_v4_load(const float* p) {
+    te_v4f v;
+    memcpy(&v, p, 16);
+    return v;
+}
+
+static inline void te_v4_store(float* p, te_v4f v) { memcpy(p, &v, 16); }
+
+static inline te_v4f te_v4_splat(float x) { return (te_v4f){x, x, x, x}; }
+
+static inline float te_v4_sum(te_v4f v) { return (v[0] + v[1]) + (v[2] + v[3]); }
+
+// 4 bf16 -> 4 float (exact).
+static inline te_v4f te_v4_bf16(const uint16_t* p) {
+    te_v4h h;
+    memcpy(&h, p, 8);
+    te_v4u u = __builtin_convertvector(h, te_v4u) << 16;
+    te_v4f f;
+    memcpy(&f, &u, 16);
+    return f;
+}
+
+// m ? a : b per lane (m from a vector comparison: all ones or all zeros). Bitwise,
+// because GCC's C front end has no vector ?: (Clang's does).
+static inline te_v4f te_v4_sel(te_v4i m, te_v4f a, te_v4f b) {
+    te_v4i ai, bi;
+    memcpy(&ai, &a, 16);
+    memcpy(&bi, &b, 16);
+    ai = (ai & m) | (bi & ~m);
+    te_v4f r;
+    memcpy(&r, &ai, 16);
+    return r;
+}
+
+// exp(x), Cephes-style: 2^n * p(r), r = x - n ln2. ~2 ulp; 0 below -87, inf above 88.
+static inline te_v4f te_v4_exp(te_v4f x) {
+    const te_v4f hi = te_v4_splat(88.3762626647949f), lo = te_v4_splat(-87.3365478515625f);
+    te_v4i under = x < lo;
+    x = te_v4_sel(x > hi, hi, x);
+    x = te_v4_sel(under, lo, x);
+    te_v4f fx = x * 1.44269504088896341f + 0.5f;
+    te_v4i n = __builtin_convertvector(fx, te_v4i);
+    te_v4f nf = __builtin_convertvector(n, te_v4f);
+    n = n + (nf > fx);  // floor: a true lane is -1
+    nf = __builtin_convertvector(n, te_v4f);
+    x = x - nf * 0.693359375f;
+    x = x - nf * -2.12194440e-4f;
+    te_v4f z = x * x;
+    te_v4f y = te_v4_splat(1.9875691500E-4f);
+    y = y * x + 1.3981999507E-3f;
+    y = y * x + 8.3334519073E-3f;
+    y = y * x + 4.1665795894E-2f;
+    y = y * x + 1.6666665459E-1f;
+    y = y * x + 5.0000001201E-1f;
+    y = y * z + x + 1.0f;
+    te_v4i e = (n + 127) << 23;
+    te_v4f pw;
+    memcpy(&pw, &e, 16);
+    y = y * pw;
+    return te_v4_sel(under, te_v4_splat(0.0f), y);
+}
