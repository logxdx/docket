+package ai.desertant.title
+
+import android.util.Log
+import androidx.test.core.app.ApplicationProvider
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import kotlinx.coroutines.runBlocking
+import org.junit.After
+import org.junit.Assert.assertTrue
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+
+/**
+ * Instrumented tests for the Android binding: JNI, the static-stdlib Swift runtime, the
+ * licensing hook on load, and CTitleEngine itself on this device's ABI.
+ *
+ * The model is ~290 MB. Pass `-e titleModelDir /data/local/tmp/title` (a folder holding the
+ * published files, pushed with adb) to test offline from a copy in the app cache; without it
+ * the pinned revision is downloaded into the cache on the first run.
+ */
+@RunWith(AndroidJUnit4::class)
+class TitleTest {
+    private lateinit var title: Title
+
+    @Before fun setUp() {
+        val context = ApplicationProvider.getApplicationContext<android.content.Context>()
+        val pushed = InstrumentationRegistry.getArguments().getString("titleModelDir")
+        val dir = pushed?.let { src ->
+            val dest = File(context.cacheDir, "title-model")
+            File(src).listFiles().orEmpty().forEach { f ->
+                val out = File(dest.apply { mkdirs() }, f.name)
+                if (out.length() != f.length()) f.copyTo(out, overwrite = true)
+            }
+            dest.absolutePath
+        }
+        title = Title(context, dir)
+        runBlocking { title.download() }
+        assertTrue(title.isDownloaded())
+    }
+
+    @After fun tearDown() { if (::title.isInitialized) title.close() }
+
+    private fun describeLogged(text: String): Card = runBlocking {
+        val t0 = System.nanoTime()
+        val card = title.describe(text)
+        Log.i("TitleTest", "%.0f ms | %s | %s".format((System.nanoTime() - t0) / 1e6, card.title, card.description))
+        card
+    }
+
+    @Test fun titlesAnEnglishVoiceNote() {
+        val card = describeLogged(
+            "okay so um just a quick reminder for myself, I need to call the vet tomorrow about " +
+                "Luna's vaccine appointment, I think it's due next week, and uh also ask if they " +
+                "have the grain free food in stock")
+        assertTrue("got $card", card.title.isNotEmpty() && card.description.isNotEmpty())
+        assertTrue("got $card", card.title.contains("Luna") || card.title.contains("vet", ignoreCase = true))
+    }
+
+    @Test fun writesInThePassageLanguage() {
+        val card = describeLogged(
+            "Hoy hablé con el fontanero sobre la fuga del baño. Dice que hay que cambiar toda la " +
+                "tubería de cobre debajo del lavabo y que el presupuesto ronda los 450 euros.")
+        assertTrue("got $card", card.title.isNotEmpty())
+    }
+
+    @Test fun blankInputIsAnEmptyCard() {
+        assertTrue(describeLogged("   \n").isEmpty)
+    }
+}
