+random adversarial strings.
+
+usage: python -I tok_compare.py TOKENIZER_JSON TOK_DUMP_BIN passages.json [n_random]
+"""
+import json
+import random
+import subprocess
+import sys
+import tempfile
+
+from tokenizers import Tokenizer
+
+PIECES = [
+    "hello", "Hello", " world", "don't", "I'M", "they're", "we'VE", "she'll", "he'd", "'s", "'",
+    "123", "4567890", "3.14", "1,000", " ", "  ", "   ", "\n", "\n\n", "\r\n", "\t", " \n ", " ",
+    "　", " ", "!", "?!", "...", "—", "–", "«", "»", "¿Qué?", "año", "Straße", "über",
+    "naïve", "日本語", "東京", "こんにちは", "한국어", "中文", "Ελληνικά", "русский", "עברית", "العربية",
+    "हिन्दी", "🙂", "👍🏽", "🗑️", "#tag", "@user", "http://x.y/z?a=1&b=2", "<|end_of_text|>",
+    "<|start_of_role|>", "<think>", "<tools>", "<|pad|>", "<|unk", "(", ")", "[", "]", "{", "}",
+    "$", "€", "%", "x²", "½", "Ⅻ", "٣", "_", "__init__", "a_b", "CamelCase", "ALLCAPS", "-",
+    "--", "->", "=>", "\"quoted\"", "'single'", "`code`", "\\", "/", "|", "~", "^", "*", "**",
+    "​", "﻿", "é", "ﬁ", "\x85",
+]
+
+
+def main():
+    tok_path, dump_bin, passages = sys.argv[1:4]
+    n_random = int(sys.argv[4]) if len(sys.argv) > 4 else 3000
+    hf = Tokenizer.from_file(tok_path)
+    texts = [p["text"] for p in json.load(open(passages))]
+    rng = random.Random(1234)
+    for _ in range(n_random):
+        texts.append("".join(rng.choice(PIECES) for _ in range(rng.randint(1, 30))))
+    for _ in range(500):
+        texts.append("".join(chr(rng.choice([rng.randint(32, 0x2FF), rng.randint(0x3000, 0x9FFF),
+                                             rng.randint(0x1F300, 0x1FAFF), 10, 32, 39])) for _ in range(rng.randint(1, 40))))
+    with tempfile.NamedTemporaryFile("wb", delete=False) as f:
+        f.write(b"\0".join(t.encode("utf-8") for t in texts))
+        path = f.name
+    out = subprocess.run([dump_bin, tok_path, path], capture_output=True, text=True, check=True).stdout
+    lines = out.split("\n")
+    bad = 0
+    for i, t in enumerate(texts):
+        want = hf.encode(t, add_special_tokens=False).ids
+        got = [int(x) for x in lines[i].split()] if lines[i] else []
+        if want != got:
+            bad += 1
+            if bad <= 10:
+                print("MISMATCH", repr(t))
+                print("  hf:", want, [hf.id_to_token(x) for x in want])
+                print("  c :", got, [hf.id_to_token(x) for x in got])
+    print(f"{len(texts) - bad}/{len(texts)} identical")
+    sys.exit(1 if bad else 0)
+
+
+if __name__ == "__main__":
+    main()
