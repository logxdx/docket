+package ai.desertant.title
+
+import ai.desertant.core.FfiReader
+import ai.desertant.core.FfiWriter
+import ai.desertant.core.LoadedModel
+
+/** The catalog id, which is how the shared native layer is asked for Title. */
+private const val MODEL_ID = "title"
+private const val MODEL_NAME = "Title"
+
+/**
+ * A title and a description for a passage of text. Mirrors the Swift SDK's `Card`.
+ *
+ * Parsing the model's reply is tolerant (a reply that drifts off format still
+ * yields its first line as the title), so an empty card is the only failure
+ * signal: treat it as "no card", not as an error.
+ */
+data class Card(
+    /** A short factual title, typically 3 to 8 words. */
+    val title: String,
+    /** One or two sentences describing the passage. */
+    val description: String,
+) {
+    /** True when the model returned neither a title nor a description. */
+    val isEmpty: Boolean get() = title.isEmpty() && description.isEmpty()
+}
+
+/** Thrown when the model cannot be created, loaded, or run. */
+class TitleException(message: String) : Exception(message)
+
+/**
+ * On-device titles and descriptions: a short factual title and a one- to
+ * two-sentence description for any passage of text (a voice-note transcript, a
+ * note, an email), written in the passage's language. Runs entirely on device
+ * once the model files are present.
+ *
+ * Create one `Title` and reuse it: construction is cheap, the ~290 MB model
+ * loads lazily on the first [describe] (or eagerly via [download]), and later
+ * calls reuse it.
+ *
+ * ```kotlin
+ * val title = Title(context)          // or Title(context, "/path/to/model/dir")
+ * val card = title.describe(noteText) // suspend; runs off the main thread
+ * println("${card.title}: ${card.description}")
+ * title.close()
+ * ```
+ *
+ * Long passages are cut to a token budget (the first ~768 and last ~256 of
+ * 1024 tokens, joined by "[...]") so prefill stays fast on a phone.
+ *
+ * @param directory the model's home. Files already there are adopted and used
+ *   offline (so an app that ships the model points at the folder it unpacked it
+ *   into); otherwise the model is downloaded into it. Omit to use the app cache.
+ */
+class Title(
+    context: android.content.Context,
+    directory: String? = null,
+) : AutoCloseable {
+    private val model = LoadedModel(MODEL_ID, MODEL_NAME, context, directory, ::TitleException, TitleNative)
+
+    /** Whether the model is available with no network. */
+    fun isDownloaded(): Boolean = model.isDownloaded()
+
+    /**
+     * Download (and verify) the model ahead of time so the first [describe] needs
+     * no network. A no-op once available (see [isDownloaded]). Suspends on a
+     * background dispatcher.
+     */
+    suspend fun download() = model.download()
+
+    /**
+     * A title and description for [text]. Blank text returns an empty [Card]
+     * without running the model. Greedy decoding, so the same text always gets
+     * the same card.
+     */
+    suspend fun describe(text: String): Card {
+        if (text.isBlank()) return Card("", "")
+        // Input payload: the passage. Options payload: empty (SDK defaults).
+        // Result payload: title string, description string. All must match
+        // Sources/Title/Binding.swift.
+        val input = FfiWriter().string(text).done()
+        return model.run(input, null, failureMessage = "title generation failed", decode = ::decodeCard)
+    }
+
+    /** Release the native model. Unusable afterwards; calling this again is a no-op. */
+    @Synchronized override fun close() = model.close()
+}
+
+internal fun decodeCard(r: FfiReader): Card = Card(r.string(), r.string())
