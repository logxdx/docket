@@ -0,0 +1,42 @@
+"""Compare engine outputs against the MLX reference token by token.
+
+usage: python -I parity_compare.py MLX.json ENGINE.json [ENGINE2.json ...]
+Prints, per passage: rendered prompt / prompt ids equality, generated token
+equality, and for a mismatch the first diverging step with the MLX top-3
+log-probs there (to tell a near-tie from a real bug).
+"""
+import json
+import sys
+
+
+def main():
+    ref = {r["id"]: r for r in json.load(open(sys.argv[1]))}
+    for path in sys.argv[2:]:
+        eng = {r["id"]: r for r in json.load(open(path))}
+        print(f"== {path}")
+        same = 0
+        for pid, r in ref.items():
+            e = eng.get(pid)
+            if e is None:
+                print(f"  {pid:14s} (missing)")
+                continue
+            pr = "ok" if e["prompt_ids"] == r["prompt_ids"] else "PROMPT-DIFF"
+            rd = "ok" if e.get("rendered") == r["rendered"] else "RENDER-DIFF"
+            a, b = r["tokens"], e["tokens"]
+            if a == b:
+                same += 1
+                print(f"  {pid:14s} prompt {pr}/{rd}  tokens IDENTICAL ({len(a)})")
+                continue
+            k = next((i for i in range(min(len(a), len(b))) if a[i] != b[i]), min(len(a), len(b)))
+            st = r["steps"][k] if k < len(r["steps"]) else None
+            near = ""
+            if st:
+                v = st["vals"]
+                near = f"; mlx top3 {st['top']} logprobs {[round(x, 4) for x in v]} (gap {v[0] - v[1]:.4f})"
+            print(f"  {pid:14s} prompt {pr}/{rd}  tokens DIFFER at step {k} "
+                  f"(mlx {a[k] if k < len(a) else 'EOS'} vs engine {b[k] if k < len(b) else 'EOS'}){near}")
+        print(f"  identical: {same}/{len(ref)}")
+
+
+if __name__ == "__main__":
+    main()
