+// Quantized matmul kernels over MLX 6-bit affine weights (group 64).
+//
+// Layout facts (verified against mx.quantize/mx.dequantize, see
+// tools/check_packing.py): row n is a little-endian bitstream; value k lives in
+// bits [6k, 6k+6). Every 3 bytes therefore hold 4 values:
+//   q0 = b0 & 63, q1 = b0>>6 | (b1&15)<<2, q2 = b1>>4 | (b2&3)<<4, q3 = b2>>2
+// and a 64-value group is exactly 48 bytes. Dequantized w = scale*q + bias, so
+//   dot(x, w_group) = scale * dot(x, q) + bias * sum(x).
+#pragma once
+#include <stdint.h>
+
+#include "te_model.h"
+
+#define TE_GS 64
+
+// Activations are prepared once per matmul input ("prepared X"):
+//   f32 path: xp[m][k] in the kernel's lane order + xsum[m][g]
+//   int8 path: xq[m][k] int8 in lane order, per 32-block scale xqs[m][k/32],
+//              and xsum[m][g] = sum of dequantized x over the group.
+typedef struct {
+    int M, K;
+    const float* xp;
+    const int8_t* xq;
+    const float* xqs;
+    const int8_t* xq2;   // optional second plane: the residual x - xqs*xq, quantized
+    const float* xqs2;   // the same way (int8 "x2" ~ 15-bit activations), or NULL
+    const float* xsum;
+} te_xprep;
+
+// Kernel lane order: index within a 64-group where the natural element k%64 goes.
+// Natural order on scalar/AVX2; on NEON the vld3 de-interleave order
+// (element 4j+r -> slot 16r+j).
+int te_kernel_lane(int k_in_group);
+const char* te_kernel_name(int int8);
+
+// Prepare X[M][K] (row stride K). Buffers must hold M*K floats/int8, M*K/32
+// scales and M*K/64 sums.
+void te_prep_f32(const float* X, int M, int K, float* xp, float* xsum, te_xprep* out);
+// xq2/xqs2 NULL: one int8 plane. Otherwise also the quantized residual, which
+// makes the activations ~15-bit for twice the integer dot products.
+void te_prep_i8(const float* X, int M, int K, int8_t* xq, float* xqs, int8_t* xq2, float* xqs2, float* xsum,
+                te_xprep* out);
+
+// Y[m*ldy + n] = sum_k X[m][k] * W[n][k] for n in [n0, n1).
+void te_qmm_f32(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1);
+void te_qmm_i8(const te_qmat* W, const te_xprep* x, float* Y, int ldy, int n0, int n1);
+
+// Dequantize row n of W (natural order) into out[K] as float (no rounding).
+void te_dequant_row(const te_qmat* W, int n, float* out);
diff --git a/Sources/CTitleEngine/te_model.c b/Sources/CTitleEngine/te_model.c
new file mode 100644
index 0000000..9831d40
--- /dev/null
+++ b/Sources/CTitleEngine/te_model.c
@@ -0,0 +1,298 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include "te_model.h"
+
+#include <fcntl.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "te_json.h"
+#include "te_util.h"
+
+typedef struct {
+    char name[160];
+    const uint8_t* data;
+    size_t nbytes;
+    char dtype[8];
+    int ndim;
+    int64_t shape[4];
+} tensor_ref;
+
+typedef struct {
+    tensor_ref* t;
+    size_t n, cap;
+} tensor_list;
+
+static int map_file(te_model* m, const char* path, const uint8_t** base, size_t* len, char* err, size_t errlen) {
+    int fd = open(path, O_RDONLY);
+    if (fd < 0) { snprintf(err, errlen, "cannot open %s", path); return -1; }
+    struct stat st;
+    if (fstat(fd, &st) || st.st_size < 8) { close(fd); snprintf(err, errlen, "cannot stat %s", path); return -1; }
+    void* p = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (p == MAP_FAILED) { snprintf(err, errlen, "cannot mmap %s", path); return -1; }
+    m->maps = (void**)realloc(m->maps, (size_t)(m->n_maps + 1) * sizeof(void*));
+    m->map_lens = (size_t*)realloc(m->map_lens, (size_t)(m->n_maps + 1) * sizeof(size_t));
+    m->maps[m->n_maps] = p;
+    m->map_lens[m->n_maps] = (size_t)st.st_size;
+    m->n_maps++;
+    *base = (const uint8_t*)p;
+    *len = (size_t)st.st_size;
+    return 0;
+}
+
+static int load_shard(te_model* m, const char* path, tensor_list* out, char* err, size_t errlen) {
+    const uint8_t* base;
+    size_t len;
+    if (map_file(m, path, &base, &len, err, errlen)) return -1;
+    uint64_t hlen;
+    memcpy(&hlen, base, 8);
+    if (hlen > len - 8) { snprintf(err, errlen, "%s: bad safetensors header", path); return -1; }
+    tj_doc* doc = te_json_parse((const char*)base + 8, (size_t)hlen, err, errlen);
+    if (!doc) return -1;
+    const tj_value* root = te_json_root(doc);
+    const uint8_t* data = base + 8 + hlen;
+    size_t data_len = len - 8 - (size_t)hlen;
+    for (size_t i = 0; i < root->len; i++) {
+        if (!strcmp(root->keys[i], "__metadata__")) continue;
+        const tj_value* v = &root->items[i];
+        const char* dt = tj_str(tj_get(v, "dtype"));
+        const tj_value* shape = tj_get(v, "shape");
+        const tj_value* offs = tj_get(v, "data_offsets");
+        if (!dt || !shape || !offs || offs->len != 2 || shape->len > 4 || root->key_lens[i] >= 160) continue;
+        size_t a = (size_t)offs->items[0].num, b = (size_t)offs->items[1].num;
+        if (b < a || b > data_len) { te_json_free(doc); snprintf(err, errlen, "%s: bad offsets", path); return -1; }
+        if (out->n == out->cap) {
+            out->cap = out->cap ? out->cap * 2 : 1024;
+            out->t = (tensor_ref*)realloc(out->t, out->cap * sizeof(tensor_ref));
+        }
+        tensor_ref* t = &out->t[out->n++];
+        memset(t, 0, sizeof(*t));
+        memcpy(t->name, root->keys[i], root->key_lens[i]);
+        snprintf(t->dtype, sizeof t->dtype, "%s", dt);
+        t->data = data + a;
+        t->nbytes = b - a;
+        t->ndim = (int)shape->len;
+        for (size_t d = 0; d < shape->len; d++) t->shape[d] = (int64_t)shape->items[d].num;
+    }
+    te_json_free(doc);
+    return 0;
+}
+
+static const tensor_ref* find(const tensor_list* l, const char* name) {
+    for (size_t i = 0; i < l->n; i++)
+        if (!strcmp(l->t[i].name, name)) return &l->t[i];
+    return NULL;
+}
+
+static int get_vec(const tensor_list* l, const char* name, int n, const uint16_t** out, char* err, size_t errlen) {
+    const tensor_ref* t = find(l, name);
+    if (!t || strcmp(t->dtype, "BF16") || t->ndim != 1 || t->shape[0] != n) {
+        snprintf(err, errlen, "tensor %s missing or not bf16[%d]", name, n);
+        return -1;
+    }
+    *out = (const uint16_t*)t->data;
+    return 0;
+}
+
+static int get_qmat(const tensor_list* l, const te_config* c, const char* prefix, int N, int K, te_qmat* q,
+                    char* err, size_t errlen) {
+    char n1[200], n2[200], n3[200];
+    snprintf(n1, sizeof n1, "%s.weight", prefix);
+    snprintf(n2, sizeof n2, "%s.scales", prefix);
+    snprintf(n3, sizeof n3, "%s.biases", prefix);
+    const tensor_ref *w = find(l, n1), *s = find(l, n2), *b = find(l, n3);
+    int groups = K / c->group_size;
+    int64_t words = (int64_t)K * c->bits / 32;
+    if (!w || !s || !b || strcmp(w->dtype, "U32") || strcmp(s->dtype, "BF16") || strcmp(b->dtype, "BF16") ||
+        w->ndim != 2 || w->shape[0] != N || w->shape[1] != words || s->ndim != 2 || s->shape[0] != N ||
+        s->shape[1] != groups || b->ndim != 2 || b->shape[0] != N || b->shape[1] != groups) {
+        snprintf(err, errlen, "quantized tensor %s missing or wrong shape (want U32[%d,%lld] + BF16[%d,%d] x2)",
+                 prefix, N, (long long)words, N, groups);
+        return -1;
+    }
+    q->w = w->data;
+    q->scales = (const uint16_t*)s->data;
+    q->biases = (const uint16_t*)b->data;
+    q->N = N;
+    q->K = K;
+    q->row_bytes = (size_t)words * 4;
+    return 0;
+}
+
+static int parse_config(te_config* c, const char* dir, char* err, size_t errlen) {
+    char path[4096];
+    snprintf(path, sizeof path, "%s/config.json", dir);
+    size_t len;
+    char* text = te_read_file(path, &len);
+    if (!text) { snprintf(err, errlen, "cannot read %s", path); return -1; }
+    tj_doc* doc = te_json_parse(text, len, err, errlen);
+    free(text);
+    if (!doc) return -1;
+    const tj_value* r = te_json_root(doc);
+    int rc = -1;
+    const char* mt = tj_str(tj_get(r, "model_type"));
+    if (!mt || (strcmp(mt, "granitemoehybrid") && strcmp(mt, "granite"))) {
+        snprintf(err, errlen, "config.json: unsupported model_type %s", mt ? mt : "(none)");
+        goto out;
+    }
+    c->hidden = (int)tj_num(tj_get(r, "hidden_size"), 0);
+    c->inter = (int)tj_num(tj_get(r, "intermediate_size"), 0);
+    c->n_layers = (int)tj_num(tj_get(r, "num_hidden_layers"), 0);
+    c->n_heads = (int)tj_num(tj_get(r, "num_attention_heads"), 0);
+    c->n_kv = (int)tj_num(tj_get(r, "num_key_value_heads"), c->n_heads);
+    c->vocab = (int)tj_num(tj_get(r, "vocab_size"), 0);
+    c->emb_mult = (float)tj_num(tj_get(r, "embedding_multiplier"), 1);
+    c->attn_mult = (float)tj_num(tj_get(r, "attention_multiplier"), 0);
+    c->resid_mult = (float)tj_num(tj_get(r, "residual_multiplier"), 1);
+    c->logits_scale = (float)tj_num(tj_get(r, "logits_scaling"), 1);
+    c->eps = (float)tj_num(tj_get(r, "rms_norm_eps"), 1e-5);
+    c->rope_theta = (float)tj_num(tj_get(r, "rope_theta"), 10000);
+    c->tie_embeddings = (int)tj_num(tj_get(r, "tie_word_embeddings"), 1);
+    c->eos_id = (int)tj_num(tj_get(r, "eos_token_id"), -1);
+    c->max_pos = (int)tj_num(tj_get(r, "max_position_embeddings"), 4096);
+    if (c->n_heads <= 0 || c->hidden % c->n_heads || c->n_kv <= 0 || c->n_heads % c->n_kv) {
+        snprintf(err, errlen, "config.json: bad head configuration");
+        goto out;
+    }
+    c->head_dim = c->hidden / c->n_heads;
+    if (c->attn_mult == 0) c->attn_mult = 1.0f / sqrtf((float)c->head_dim);
+    const tj_value* q = tj_get(r, "quantization");
+    if (!q) q = tj_get(r, "quantization_config");
+    c->bits = (int)tj_num(tj_get(q, "bits"), 0);
+    c->group_size = (int)tj_num(tj_get(q, "group_size"), 0);
+    const char* mode = tj_str(tj_get(q, "mode"));
+    if (!q || (mode && strcmp(mode, "affine")) || c->bits != 6 || c->group_size != 64) {
+        snprintf(err, errlen, "config.json: need MLX affine quantization with bits=6, group_size=64");
+        goto out;
+    }
+    if ((int)tj_num(tj_get(r, "num_local_experts"), 0) != 0) {
+        snprintf(err, errlen, "config.json: mixture-of-experts layers are not supported");
+        goto out;
+    }
+    const tj_value* lt = tj_get(r, "layer_types");
+    if (lt && lt->type == TJ_ARR)
+        for (size_t i = 0; i < lt->len; i++)
+            if (!tj_str(&lt->items[i]) || strcmp(tj_str(&lt->items[i]), "attention")) {
+                snprintf(err, errlen, "config.json: only attention layers are supported (found %s)",
+                         tj_str(&lt->items[i]) ? tj_str(&lt->items[i]) : "?");
+                goto out;
+            }
+    const char* pe = tj_str(tj_get(r, "position_embedding_type"));
+    if (pe && strcmp(pe, "rope")) { snprintf(err, errlen, "config.json: need rope positions"); goto out; }
+    if (tj_get(r, "rope_scaling") && tj_get(r, "rope_scaling")->type != TJ_NULL) {
+        snprintf(err, errlen, "config.json: rope_scaling is not supported");
+        goto out;
+    }
+    if (tj_get(r, "attention_bias") && tj_num(tj_get(r, "attention_bias"), 0)) {
+        snprintf(err, errlen, "config.json: attention bias is not supported");
+        goto out;
+    }
+    if (c->hidden % c->group_size || c->inter % c->group_size) {
+        snprintf(err, errlen, "config.json: dims must be multiples of group_size");
+        goto out;
+    }
+    rc = 0;
+out:
+    te_json_free(doc);
+    return rc;
+}
+
+void te_model_free(te_model* m) {
+    for (int i = 0; i < m->n_maps; i++) munmap(m->maps[i], m->map_lens[i]);
+    free(m->maps);
+    free(m->map_lens);
+    free(m->layers);
+    free(m->rope_inv_freq);
+    memset(m, 0, sizeof(*m));
+}
+
+int te_model_load(te_model* m, const char* dir, char* err, size_t errlen) {
+    memset(m, 0, sizeof(*m));
+    if (parse_config(&m->cfg, dir, err, errlen)) return -1;
+    te_config* c = &m->cfg;
+    tensor_list tl = {0};
+    char path[4096];
+    int rc = -1;
+    // Shards from the index (the SDK always ships one, even for a single shard).
+    snprintf(path, sizeof path, "%s/model.safetensors.index.json", dir);
+    size_t ilen;
+    char* itext = te_read_file(path, &ilen);
+    if (itext) {
+        tj_doc* idx = te_json_parse(itext, ilen, err, errlen);
+        free(itext);
+        if (!idx) goto out;
+        const tj_value* wm = tj_get(te_json_root(idx), "weight_map");
+        char** seen = NULL;
+        int n_seen = 0;
+        for (size_t i = 0; wm && i < wm->len; i++) {
+            const char* f = tj_str(&wm->items[i]);
+            if (!f || strchr(f, '/')) continue;
+            int dup = 0;
+            for (int j = 0; j < n_seen; j++) dup |= !strcmp(seen[j], f);
+            if (dup) continue;
+            seen = (char**)realloc(seen, (size_t)(n_seen + 1) * sizeof(char*));
+            seen[n_seen++] = te_strndup(f, strlen(f));
+        }
+        te_json_free(idx);
+        int bad = 0;
+        for (int j = 0; j < n_seen; j++) {
+            if (!bad) {
+                snprintf(path, sizeof path, "%s/%s", dir, seen[j]);
+                bad = load_shard(m, path, &tl, err, errlen);
+            }
+            free(seen[j]);
+        }
+        free(seen);
+        if (bad) goto out;
+    }
+    if (tl.n == 0) {
+        snprintf(path, sizeof path, "%s/model.safetensors", dir);
+        if (load_shard(m, path, &tl, err, errlen)) goto out;
+    }
+    if (get_qmat(&tl, c, "model.embed_tokens", c->vocab, c->hidden, &m->embed, err, errlen)) goto out;
+    if (c->tie_embeddings) {
+        m->lm_head = m->embed;
+    } else if (get_qmat(&tl, c, "lm_head", c->vocab, c->hidden, &m->lm_head, err, errlen)) {
+        goto out;
+    }
+    if (get_vec(&tl, "model.norm.weight", c->hidden, &m->norm, err, errlen)) goto out;
+    m->layers = (te_layer*)calloc((size_t)c->n_layers, sizeof(te_layer));
+    int qd = c->n_heads * c->head_dim, kvd = c->n_kv * c->head_dim;
+    for (int i = 0; i < c->n_layers; i++) {
+        te_layer* L = &m->layers[i];
+        char p[160], q[200];
+#define QM(field, sub, N, K)                                               \
+    snprintf(q, sizeof q, "model.layers.%d.%s", i, sub);                  \
+    if (get_qmat(&tl, c, q, N, K, &L->field, err, errlen)) goto out;
+        QM(q, "self_attn.q_proj", qd, c->hidden);
+        QM(k, "self_attn.k_proj", kvd, c->hidden);
+        QM(v, "self_attn.v_proj", kvd, c->hidden);
+        QM(o, "self_attn.o_proj", c->hidden, qd);
+        QM(gate, "mlp.gate_proj", c->inter, c->hidden);
+        QM(up, "mlp.up_proj", c->inter, c->hidden);
+        QM(down, "mlp.down_proj", c->hidden, c->inter);
+#undef QM
+        snprintf(p, sizeof p, "model.layers.%d.input_layernorm.weight", i);
+        if (get_vec(&tl, p, c->hidden, &L->in_norm, err, errlen)) goto out;
+        snprintf(p, sizeof p, "model.layers.%d.post_attention_layernorm.weight", i);
+        if (get_vec(&tl, p, c->hidden, &L->post_norm, err, errlen)) goto out;
+    }
+    int half = c->head_dim / 2;
+    m->rope_inv_freq = (float*)malloc((size_t)half * sizeof(float));
+    for (int j = 0; j < half; j++)
+        m->rope_inv_freq[j] = (float)pow((double)c->rope_theta, -(double)j / half);
+    rc = 0;
+out:
+    free(tl.t);
+    if (rc) te_model_free(m);
+    return rc;
+}
+#else
+typedef int te_unavailable_te_model;
+#endif
diff --git a/Sources/CTitleEngine/te_model.h b/Sources/CTitleEngine/te_model.h
new file mode 100644
index 0000000..fb1b385
--- /dev/null
+++ b/Sources/CTitleEngine/te_model.h
@@ -0,0 +1,72 @@
+// Internal model representation: an MLX affine-quantized Granite decoder
+// read straight from the published safetensors (mmap, no conversion).
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#include "te_threads.h"
+
+typedef struct {
+    int hidden, inter, n_layers, n_heads, n_kv, head_dim, vocab;
+    float emb_mult, attn_mult, resid_mult, logits_scale, eps, rope_theta;
+    int bits, group_size;
+    int tie_embeddings;
+    int eos_id;
+    int max_pos;
+} te_config;
+
+// MLX affine quantized matrix [N, K]: row n holds K values packed little-endian
+// into K*bits/32 uint32 words; w = scale[n][g] * q + bias[n][g] per group g.
+typedef struct {
+    const uint8_t* w;
+    const uint16_t* scales;  // bf16 [N][K/gs]
+    const uint16_t* biases;  // bf16 [N][K/gs]
+    int N, K;
+    size_t row_bytes;
+} te_qmat;
+
+typedef struct {
+    const uint16_t* in_norm;    // bf16 [hidden]
+    const uint16_t* post_norm;  // bf16 [hidden]
+    te_qmat q, k, v, o, gate, up, down;
+} te_layer;
+
+typedef struct te_model {
+    te_config cfg;
+    void** maps;
+    size_t* map_lens;
+    int n_maps;
+    te_layer* layers;
+    te_qmat embed;
+    te_qmat lm_head;          // == embed when tied
+    const uint16_t* norm;     // bf16 [hidden]
+    float* rope_inv_freq;     // [head_dim/2] (fast path)
+} te_model;
+
+int te_model_load(te_model* m, const char* dir, char* err, size_t errlen);
+void te_model_free(te_model* m);
+
+// Per-sequence state: KV cache (bf16) + scratch.
+typedef struct {
+    int cap;     // positions
+    int len;     // positions filled
+    uint16_t* k; // [layer][kv][cap][head_dim]
+    uint16_t* v;
+    int chunk;   // max tokens per forward call
+    float *x, *h, *q, *kk, *vv, *att, *g, *u, *tmp, *xsum, *xperm, *logits;
+    int8_t *xq, *xq2;
+    float *xqs, *xqs2;
+} te_state;
+
+int te_state_init(te_state* s, const te_model* m, int cap, int chunk, int n_threads);
+void te_state_free(te_state* s);
+
+// Runs tokens[0..n) at positions s->len.., n <= s->chunk. When logits != NULL,
+// writes the last token's logits (float, already divided by logits_scaling).
+enum { TE_FWD_EXACT = 1, TE_FWD_INT8 = 2, TE_FWD_BF16 = 4, TE_FWD_I8X2 = 8 };
+void te_forward(const te_model* m, te_state* s, te_pool* pool, const int32_t* tokens, int n,
+                float* logits, int flags);
+
+// MLX-CPU style greedy pick on bf16 logits: argmax(logits - logsumexp(logits))
+// computed in bf16 as mlx-lm does. `logits` holds bf16-exact floats.
+int te_exact_pick(const float* logits, int n);
diff --git a/Sources/CTitleEngine/te_platform.h b/Sources/CTitleEngine/te_platform.h
new file mode 100644
index 0000000..2230477
--- /dev/null
+++ b/Sources/CTitleEngine/te_platform.h
@@ -0,0 +1,13 @@
+// The engine needs POSIX (mmap, pthreads, sysconf). SwiftPM compiles every C
+// target on every platform in a whole-package build, so on Windows and WASI the
+// sources compile to nothing (Swift only imports the module on Android/Linux).
+#pragma once
+// Before any system header: getauxval, sysconf(_SC_NPROCESSORS_ONLN), clock_gettime.
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#if (defined(__unix__) || defined(__APPLE__)) && !defined(__wasi__) && !defined(_WIN32)
+#define TE_ENABLED 1
+#else
+#define TE_ENABLED 0
+#endif
diff --git a/Sources/CTitleEngine/te_threads.c b/Sources/CTitleEngine/te_threads.c
new file mode 100644
index 0000000..8e5645d
--- /dev/null
+++ b/Sources/CTitleEngine/te_threads.c
@@ -0,0 +1,121 @@
+#include "te_platform.h"
+#if TE_ENABLED
+#include "te_threads.h"
+
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <sched.h>
+
+struct te_pool {
+    int n;  // total threads incl. caller
+    pthread_t* threads;
+    pthread_mutex_t mu;
+    pthread_cond_t cv;
+    atomic_int generation;
+    atomic_int stop;
+    // current job
+    te_range_fn fn;
+    void* ctx;
+    int items, grain;
+    atomic_int next;
+    atomic_int pending;  // workers still inside the job
+};
+
+static void do_work(te_pool* p) {
+    for (;;) {
+        int b = atomic_fetch_add_explicit(&p->next, p->grain, memory_order_relaxed);
+        if (b >= p->items) break;
+        int e = b + p->grain < p->items ? b + p->grain : p->items;
+        p->fn(p->ctx, b, e);
+    }
+}
+
+static void* worker(void* arg) {
+    te_pool* p = (te_pool*)arg;
+    int seen = 0;
+    for (;;) {
+        // Spin briefly (decode issues hundreds of small jobs per token), then sleep.
+        int g;
+        int spins = 0;
+        while ((g = atomic_load_explicit(&p->generation, memory_order_acquire)) == seen &&
+               !atomic_load_explicit(&p->stop, memory_order_relaxed)) {
+            if (++spins < 20000) {
+#if defined(__x86_64__) || defined(__i386__)
+                __builtin_ia32_pause();
+#elif defined(__aarch64__)
+                __asm__ __volatile__("yield");
+#endif
+                continue;
+            }
+            pthread_mutex_lock(&p->mu);
+            while (atomic_load(&p->generation) == seen && !atomic_load(&p->stop))
+                pthread_cond_wait(&p->cv, &p->mu);
+            pthread_mutex_unlock(&p->mu);
+        }
+        if (atomic_load(&p->stop)) return NULL;
+        seen = g;
+        do_work(p);
+        atomic_fetch_sub_explicit(&p->pending, 1, memory_order_acq_rel);
+    }
+}
+
+te_pool* te_pool_create(int n_threads) {
+    if (n_threads < 1) n_threads = 1;
+    te_pool* p = (te_pool*)calloc(1, sizeof(te_pool));
+    if (!p) return NULL;
+    p->n = n_threads;
+    pthread_mutex_init(&p->mu, NULL);
+    pthread_cond_init(&p->cv, NULL);
+    if (n_threads > 1) {
+        p->threads = (pthread_t*)calloc((size_t)n_threads - 1, sizeof(pthread_t));
+        for (int i = 0; i < n_threads - 1; i++)
+            if (pthread_create(&p->threads[i], NULL, worker, p)) { p->n = i + 1; break; }
+    }
+    return p;
+}
+
+void te_pool_free(te_pool* p) {
+    if (!p) return;
+    pthread_mutex_lock(&p->mu);
+    atomic_store(&p->stop, 1);
+    pthread_cond_broadcast(&p->cv);
+    pthread_mutex_unlock(&p->mu);
+    for (int i = 0; i < p->n - 1; i++) pthread_join(p->threads[i], NULL);
+    free(p->threads);
+    pthread_mutex_destroy(&p->mu);
+    pthread_cond_destroy(&p->cv);
+    free(p);
+}
+
+int te_pool_size(const te_pool* p) { return p ? p->n : 1; }
+
+void te_pool_run(te_pool* p, int n, int grain, te_range_fn fn, void* ctx) {
+    if (n <= 0) return;
+    if (grain < 1) grain = 1;
+    if (!p || p->n == 1 || n <= grain) {
+        fn(ctx, 0, n);
+        return;
+    }
+    p->fn = fn;
+    p->ctx = ctx;
+    p->items = n;
+    p->grain = grain;
+    atomic_store_explicit(&p->next, 0, memory_order_relaxed);
+    atomic_store_explicit(&p->pending, p->n - 1, memory_order_relaxed);
+    pthread_mutex_lock(&p->mu);
+    atomic_fetch_add_explicit(&p->generation, 1, memory_order_release);
+    pthread_cond_broadcast(&p->cv);
+    pthread_mutex_unlock(&p->mu);
+    do_work(p);
+    while (atomic_load_explicit(&p->pending, memory_order_acquire) > 0) {
+#if defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#elif defined(__aarch64__)
+        __asm__ __volatile__("yield");
+#endif
+    }
+}
+#else
+typedef int te_unavailable_te_threads;
+#endif
