diff --git a/Tools/title-engine/title_cli.c b/Tools/title-engine/title_cli.c
new file mode 100644
index 0000000..04fc6e1
--- /dev/null
+++ b/Tools/title-engine/title_cli.c
@@ -0,0 +1,131 @@
+// Host CLI for the Title engine.
+//   title-cli MODEL_DIR [options] --text "passage"
+//   title-cli MODEL_DIR [options] --passages passages.json --out results.json
+// options: --threads N  --numerics int8|f32|exact  --budget N  --max-new N  --chunk N
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "title_engine.h"
+#include "te_json.h"
+#include "te_util.h"
+
+// Length of a valid UTF-8 sequence at p, or 0 (a reply cut at max_new_tokens
+// can end inside a character).
+static int utf8_len(const unsigned char* p) {
+    int n = p[0] < 0x80 ? 1 : (p[0] >> 5) == 6 ? 2 : (p[0] >> 4) == 14 ? 3 : (p[0] >> 3) == 30 ? 4 : 0;
+    for (int i = 1; i < n; i++)
+        if ((p[i] & 0xC0) != 0x80) return 0;
+    return n;
+}
+
+static void json_str(FILE* f, const char* s) {
+    fputc('"', f);
+    for (const unsigned char* p = (const unsigned char*)s; *p;) {
+        int n = utf8_len(p);
+        if (n == 0) { fputs("\\ufffd", f); p++; continue; }
+        if (n > 1) { fwrite(p, 1, (size_t)n, f); p += n; continue; }
+        if (*p == '"' || *p == '\\') fprintf(f, "\\%c", *p);
+        else if (*p == '\n') fputs("\\n", f);
+        else if (*p == '\r') fputs("\\r", f);
+        else if (*p == '\t') fputs("\\t", f);
+        else if (*p < 0x20) fprintf(f, "\\u%04x", *p);
+        else fputc(*p, f);
+        p++;
+    }
+    fputc('"', f);
+}
+
+static int run_one(te_engine* e, const char* id, const char* text, size_t len, FILE* out, int first) {
+    te_stats st = {0};
+    char* rendered = NULL;
+    if (te_engine_render(e, text, len, &rendered, &st)) return -1;
+    int32_t* ids = NULL;
+    size_t n = 0;
+    te_engine_tokenize(e, rendered, strlen(rendered), &ids, &n);
+    int32_t gen[4096];
+    te_options dummy;
+    (void)dummy;
+    int k = te_engine_generate(e, ids, n, gen, 96, &st);
+    if (k < 0) { free(rendered); free(ids); return -1; }
+    char* reply = te_engine_detokenize(e, gen, (size_t)k);
+    fprintf(stderr, "[%s] %d prompt tok (passage %d%s), %d gen tok, prefill %.3fs (%.1f tok/s), decode %.3fs (%.1f tok/s)\n%s\n\n",
+            id, st.prompt_tokens, st.passage_tokens, st.truncated ? ", truncated" : "", st.generated_tokens,
+            st.prefill_s, st.prompt_tokens / st.prefill_s, st.decode_s,
+            st.generated_tokens > 1 ? (st.generated_tokens - 1) / st.decode_s : 0.0, reply);
+    if (out) {
+        fprintf(out, "%s{\"id\": ", first ? "" : ",\n");
+        json_str(out, id);
+        fprintf(out, ", \"rendered\": ");
+        json_str(out, rendered);
+        fprintf(out, ", \"prompt_ids\": [");
+        for (size_t i = 0; i < n; i++) fprintf(out, i ? ", %d" : "%d", ids[i]);
+        fprintf(out, "], \"tokens\": [");
+        for (int i = 0; i < k; i++) fprintf(out, i ? ", %d" : "%d", gen[i]);
+        fprintf(out, "], \"text\": ");
+        json_str(out, reply);
+        fprintf(out, ", \"truncated\": %d, \"passage_tokens\": %d, \"prefill_s\": %.6f, \"decode_s\": %.6f}",
+                st.truncated, st.passage_tokens, st.prefill_s, st.decode_s);
+    }
+    free(reply);
+    free(rendered);
+    free(ids);
+    return 0;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 3) {
+        fprintf(stderr, "usage: %s MODEL_DIR [--threads N] [--numerics int8|f32|exact] [--budget N] [--max-new N]\n"
+                        "          (--text TEXT | --passages FILE.json [--out OUT.json])\n", argv[0]);
+        return 2;
+    }
+    te_options o;
+    te_options_default(&o);
+    const char *text = NULL, *passages = NULL, *outp = NULL;
+    for (int i = 2; i < argc; i++) {
+        const char* a = argv[i];
+        const char* v = i + 1 < argc ? argv[i + 1] : NULL;
+        if (!v) { fprintf(stderr, "missing value for %s\n", a); return 2; }
+        if (!strcmp(a, "--threads")) o.n_threads = atoi(v);
+        else if (!strcmp(a, "--budget")) o.passage_token_budget = atoi(v);
+        else if (!strcmp(a, "--max-new")) o.max_new_tokens = atoi(v);
+        else if (!strcmp(a, "--chunk")) o.prefill_chunk = atoi(v);
+        else if (!strcmp(a, "--numerics"))
+            o.numerics = !strcmp(v, "exact") ? TE_NUMERICS_MLX_EXACT : !strcmp(v, "f32") ? TE_NUMERICS_F32
+                       : !strcmp(v, "f32-bf16") ? TE_NUMERICS_F32_BF16 : !strcmp(v, "hybrid") ? TE_NUMERICS_HYBRID : !strcmp(v, "int8x2") ? TE_NUMERICS_INT8X2 : !strcmp(v, "int8-bf16") ? TE_NUMERICS_INT8_BF16
+                       : TE_NUMERICS_INT8;
+        else if (!strcmp(a, "--text")) text = v;
+        else if (!strcmp(a, "--passages")) passages = v;
+        else if (!strcmp(a, "--out")) outp = v;
+        else { fprintf(stderr, "unknown option %s\n", a); return 2; }
+        i++;
+    }
+    char err[512];
+    double t0 = te_now();
+    te_engine* e = te_engine_load(argv[1], &o, err, sizeof err);
+    if (!e) { fprintf(stderr, "load failed: %s\n", err); return 1; }
+    fprintf(stderr, "loaded in %.3fs, kernel %s, %d threads\n", te_now() - t0, te_engine_kernel(e), te_engine_threads(e));
+    int rc = 0;
+    if (text) {
+        rc = run_one(e, "text", text, strlen(text), NULL, 1);
+    } else if (passages) {
+        size_t len;
+        char* js = te_read_file(passages, &len);
+        tj_doc* doc = js ? te_json_parse(js, len, err, sizeof err) : NULL;
+        if (!doc) { fprintf(stderr, "bad passages file\n"); return 1; }
+        FILE* out = outp ? fopen(outp, "w") : NULL;
+        if (out) fputs("[\n", out);
+        const tj_value* r = te_json_root(doc);
+        for (size_t i = 0; i < r->len; i++) {
+            const tj_value* p = &r->items[i];
+            const tj_value* t = tj_get(p, "text");
+            if (!t || t->type != TJ_STR) continue;
+            rc |= run_one(e, tj_str(tj_get(p, "id")) ? tj_str(tj_get(p, "id")) : "?", t->str, t->len, out, i == 0);
+        }
+        if (out) { fputs("\n]\n", out); fclose(out); }
+        te_json_free(doc);
+        free(js);
+    }
+    te_engine_free(e);
+    return rc ? 1 : 0;
+}
