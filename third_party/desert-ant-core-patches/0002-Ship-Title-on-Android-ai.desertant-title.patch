+// tok_dump TOKENIZER_JSON INPUT_FILE : prints token ids of each NUL-separated text, one line each.
+#include <stdio.h>
+#include <stdlib.h>
+#include "te_tokenizer.h"
+#include "te_util.h"
+int main(int argc, char** argv) {
+    char err[256];
+    te_tokenizer* t = te_tok_load(argv[1], err, sizeof err);
+    if (!t) { fprintf(stderr, "%s\n", err); return 1; }
+    size_t len; char* buf = te_read_file(argv[2], &len);
+    size_t s = 0;
+    while (s < len) {
+        size_t e = s; while (e < len && buf[e]) e++;
+        te_tokens v = {0};
+        te_tok_encode(t, buf + s, e - s, &v);
+        for (size_t i = 0; i < v.n; i++) printf(i ? " %d" : "%d", v.ids[i]);
+        printf("\n");
+        te_tokens_free(&v);
+        s = e + 1;
+    }
+    te_tok_free(t);
+    return 0;
+}
