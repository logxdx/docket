+// kernel_test MODEL_DIR: checks te_qmm_f32 / te_qmm_i8 (whatever this build
+// dispatches to: scalar, AVX2, or NEON via SIMDe) against a double-precision
+// dequantize-then-dot reference on real model matrices, for M = 1 and M = 37.
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "te_kernels.h"
+#include "te_model.h"
+
+static double check(const te_qmat* W, int M, int int8) {  // int8: 0 f32, 1 int8, 2 int8x2
+    int K = W->K, N = W->N < 512 ? W->N : 512;
+    float* X = malloc(sizeof(float) * M * K);
+    srand(42 + M);
+    for (int i = 0; i < M * K; i++) X[i] = ((rand() / (float)RAND_MAX) - 0.5f) * 4.0f * (i % 97 == 0 ? 10 : 1);
+    float* xp = malloc(sizeof(float) * M * K);
+    int8_t* xq = malloc(M * K);
+    int8_t* xq2 = malloc(M * K);
+    float* xqs2 = malloc(sizeof(float) * M * K / 32);
+    float* xqs = malloc(sizeof(float) * M * K / 32);
+    float* xsum = malloc(sizeof(float) * M * K / 64);
+    te_xprep prep;
+    if (int8) te_prep_i8(X, M, K, xq, xqs, int8 == 2 ? xq2 : NULL, xqs2, xsum, &prep);
+    else te_prep_f32(X, M, K, xp, xsum, &prep);
+    float* Y = malloc(sizeof(float) * M * W->N);
+    if (int8) te_qmm_i8(W, &prep, Y, W->N, 0, N);
+    else te_qmm_f32(W, &prep, Y, W->N, 0, N);
+    float* row = malloc(sizeof(float) * K);
+    double worst = 0;
+    for (int n = 0; n < N; n++) {
+        te_dequant_row(W, n, row);
+        for (int m = 0; m < M; m++) {
+            double ref = 0, mag = 0;
+            for (int k = 0; k < K; k++) { ref += (double)X[m * K + k] * row[k]; mag += fabs((double)X[m * K + k] * row[k]); }
+            double err = fabs(Y[m * W->N + n] - ref) / (mag + 1e-9);
+            if (err > worst) worst = err;
+        }
+    }
+    free(X); free(xp); free(xq); free(xq2); free(xqs2); free(xqs); free(xsum); free(Y); free(row);
+    return worst;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 2) return 2;
+    te_model m;
+    char err[256];
+    if (te_model_load(&m, argv[1], err, sizeof err)) { fprintf(stderr, "%s\n", err); return 1; }
+    const te_qmat* mats[] = {&m.layers[0].q, &m.layers[3].down, &m.layers[27].gate, &m.embed};
+    const char* names[] = {"L0.q", "L3.down", "L27.gate", "embed"};
+    int bad = 0;
+    for (int int8 = 0; int8 < 3; int8++) {
+        printf("kernel %s%s\n", te_kernel_name(int8 > 0), int8 == 2 ? " (two planes)" : "");
+        for (int i = 0; i < 4; i++)
+            for (int M = 1; M <= 37; M += 36) {
+                double e = check(mats[i], M, int8);
+                // f32: rounding only. int8: activation quantization (~1/254 of the block max).
+                double tol = int8 == 1 ? 2e-2 : int8 == 2 ? 1e-4 : 1e-5;
+                printf("  %-9s M=%-3d max rel err %.3g %s\n", names[i], M, e, e < tol ? "ok" : "FAIL");
+                bad |= e >= tol;
+            }
+    }
+    te_model_free(&m);
+    return bad;
+}
diff --git a/Tools/title-engine/mlx_reference.py b/Tools/title-engine/mlx_reference.py
new file mode 100644
index 0000000..3332eec
--- /dev/null
+++ b/Tools/title-engine/mlx_reference.py
@@ -0,0 +1,83 @@
+"""Official MLX reference generation for the Title model.
+
+Runs mlx-lm exactly as the SDK does (prompt from Sources/Title/Title.swift, the
+model's chat_template.jinja with a single user message and a generation prompt,
+greedy decoding, maxTokens 96) and writes token ids + text per passage.
+
+usage: python -I mlx_reference.py MODEL_DIR passages.json out.json [--f32]
+  --f32  upcast scales/biases/norms to float32 first (a higher-precision
+         reference: same weights, float32 activations).
+  --bf16-kv  with --f32: round the KV cache to bf16 as it is written, which is
+         what the engine's fast paths store.
+"""
+import json
+import sys
+import time
+
+import mlx.core as mx
+from mlx_lm import load
+from mlx_lm.generate import generate_step
+from mlx_lm.sample_utils import make_sampler
+
+PROMPT = (
+    "Write a factual title (3-8 words) and a 1-2 sentence description for this passage."
+    "Be specific enough to identify this passage. No emoji, no hashtags, no hype."
+    "Write in the same language as the passage.\n\nPASSAGE:\n{clip}"
+)
+MAX_TOKENS = 96
+
+
+def main():
+    model_dir, passages_path, out_path = sys.argv[1:4]
+    f32 = "--f32" in sys.argv
+    model, tok = load(model_dir)
+    if f32:
+        from mlx.utils import tree_flatten, tree_unflatten
+        params = [(k, v.astype(mx.float32) if v.dtype == mx.bfloat16 else v)
+                  for k, v in tree_flatten(model.parameters())]
+        model.update(tree_unflatten(params))
+    if "--bf16-kv" in sys.argv:
+        from mlx_lm.models.cache import KVCache
+        orig = KVCache.update_and_fetch
+
+        def rounded(self, keys, values):
+            return orig(self, keys.astype(mx.bfloat16).astype(keys.dtype),
+                        values.astype(mx.bfloat16).astype(values.dtype))
+        KVCache.update_and_fetch = rounded
+    passages = json.load(open(passages_path))
+    eos = set(tok.eos_token_ids)
+    sampler = make_sampler(temp=0.0)
+    results = []
+    for p in passages:
+        prompt = PROMPT.replace("{clip}", p["text"])
+        rendered = tok.apply_chat_template(
+            [{"role": "user", "content": prompt}], add_generation_prompt=True, tokenize=False)
+        ids = tok.apply_chat_template(
+            [{"role": "user", "content": prompt}], add_generation_prompt=True)
+        out, steps = [], []
+        t0 = time.perf_counter()
+        for n, (t, logprobs) in enumerate(generate_step(
+                mx.array(ids), model, max_tokens=MAX_TOKENS, sampler=sampler)):
+            if n == 0:
+                t_first = time.perf_counter()
+            # Near-tie diagnostics on the official (bf16) logprobs.
+            lp = logprobs.astype(mx.float32)
+            top = mx.argsort(-lp)[:3].tolist()
+            steps.append({"top": top, "vals": [float(lp[i].item()) for i in top]})
+            if t in eos:
+                break
+            out.append(t)
+        t1 = time.perf_counter()
+        text = tok.decode(out)
+        results.append({
+            "id": p["id"], "rendered": rendered, "prompt_ids": ids, "tokens": out,
+            "text": text, "steps": steps,
+            "prefill_s": t_first - t0, "decode_s": t1 - t_first,
+        })
+        print(f"[{p['id']}] {len(ids)} prompt tok, {len(out)} gen tok, "
+              f"ttft {t_first - t0:.3f}s\n{text}\n", flush=True)
+    json.dump(results, open(out_path, "w"), ensure_ascii=False, indent=1)
+
+
+if __name__ == "__main__":
+    main()
